# Postgres connection string. Leave empty to use the embedded PGlite database in .data/pglite.
DATABASE_URL=

# AI provider. With no key the app uses FakeLLM (deterministic, free).
ANTHROPIC_API_KEY=
# LLM_PROVIDER=claude            # or "fake" to force the fake even with a key
# LLM_SMART_MODEL=claude-opus-5-5
# LLM_FAST_MODEL=claude-opus-5-5  # try claude-haiku-5-5 for the cheaper fast tier
# LLM_RUN_CAP_USD=2               # most one simulated week may spend
# LLM_DAILY_CAP_USD=10            # most all AI calls may spend per UTC day
