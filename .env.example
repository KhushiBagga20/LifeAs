# Postgres connection string. Leave empty to use the embedded PGlite database in .data/pglite.
DATABASE_URL=

# AI provider: claude, azure or fake. Unset: Claude if ANTHROPIC_API_KEY is set, Azure if any
# AZURE_AI_* variable is set (missing ones are named), otherwise FakeLLM (deterministic, free).
# LLM_PROVIDER=azure

# Claude
ANTHROPIC_API_KEY=
# LLM_SMART_MODEL=claude-opus-5-5
# LLM_FAST_MODEL=claude-opus-5-5  # try claude-haiku-5-5 for the cheaper fast tier

# Azure (Microsoft Foundry / Azure OpenAI, v1 Chat Completions API). Server-side only.
# Endpoint: the resource endpoint, e.g. https://<resource>.openai.azure.com or
# https://<resource>.services.ai.azure.com. A URL copied from the portal ending in /openai/v1,
# /openai/v1/responses or /openai/v1/chat/completions works too.
AZURE_AI_ENDPOINT=
AZURE_AI_API_KEY=
AZURE_AI_DEPLOYMENT=
# Your deployment's prices in US dollars per million tokens (required, for the spending caps).
AZURE_AI_PRICE_INPUT=
AZURE_AI_PRICE_CACHED_INPUT=
AZURE_AI_PRICE_OUTPUT=

# Spending caps (all providers)
# LLM_RUN_CAP_USD=2               # most one simulated week may spend
# LLM_DAILY_CAP_USD=10            # most all AI calls may spend per UTC day
