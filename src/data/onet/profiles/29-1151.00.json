{"code":"29-1151.00","title":"Nurse Anesthetists","description":"Administer anesthesia, monitor patient's vital signs, and oversee patient recovery from anesthesia. May assist anesthesiologists, surgeons, other physicians, or dentists. Must be registered nurses who have specialized graduate education.","jobZone":5,"kinds":{"R":{"score":4.78,"share":0.2319},"I":{"score":5.06,"share":0.2491},"A":{"score":1,"share":0},"S":{"score":5.35,"share":0.2669},"E":{"score":1.96,"share":0.0589},"C":{"score":4.15,"share":0.1933}},"highPoints":["S","I","R"],"tasks":[{"id":18361,"text":"Manage patients' airway or pulmonary status, using techniques such as endotracheal intubation, mechanical ventilation, pharmacological support, respiratory therapy, and extubation.","core":true,"importance":4.96,"relevance":100,"frequency":6},{"id":18365,"text":"Respond to emergency situations by providing airway management, administering emergency fluids or drugs, or using basic or advanced cardiac life support techniques.","core":true,"importance":4.92,"relevance":100,"frequency":4},{"id":18362,"text":"Monitor patients' responses, including skin color, pupil dilation, pulse, heart rate, blood pressure, respiration, ventilation, or urine output, using invasive and noninvasive techniques.","core":true,"importance":4.89,"relevance":100,"frequency":6.41},{"id":18366,"text":"Select, order, or administer anesthetics, adjuvant drugs, accessory drugs, fluids or blood products as necessary.","core":true,"importance":4.8,"relevance":100,"frequency":6.26},{"id":18370,"text":"Select, prepare, or use equipment, monitors, supplies, or drugs for the administration of anesthetics.","core":true,"importance":4.7,"relevance":100,"frequency":6.07},{"id":18363,"text":"Perform or manage regional anesthetic techniques, such as local, spinal, epidural, caudal, nerve blocks and intravenous blocks.","core":true,"importance":4.67,"relevance":100,"frequency":5.07},{"id":18367,"text":"Assess patients' medical histories to predict anesthesia response.","core":true,"importance":4.67,"relevance":100,"frequency":5.85},{"id":18368,"text":"Develop anesthesia care plans.","core":true,"importance":4.65,"relevance":96.3,"frequency":5.85},{"id":18369,"text":"Obtain informed consent from patients for anesthesia procedures.","core":true,"importance":4.65,"relevance":100,"frequency":5.67},{"id":18356,"text":"Perform pre-anesthetic screenings, including physical evaluations and patient interviews, and document results.","core":true,"importance":4.59,"relevance":100,"frequency":5.63},{"id":18364,"text":"Prepare prescribed solutions and administer local, intravenous, spinal, or other anesthetics, following specified methods and procedures.","core":true,"importance":4.59,"relevance":100,"frequency":5.44},{"id":18371,"text":"Calibrate and test anesthesia equipment.","core":true,"importance":4.58,"relevance":100,"frequency":5.26},{"id":18355,"text":"Evaluate patients' post-surgical or post-anesthesia responses, taking appropriate corrective actions or requesting consultation if complications occur.","core":true,"importance":4.56,"relevance":100,"frequency":5.44},{"id":18354,"text":"Administer post-anesthesia medications or fluids to support patients' cardiovascular systems.","core":true,"importance":4.54,"relevance":100,"frequency":4.85},{"id":18357,"text":"Select and prescribe post-anesthesia medications or treatments to patients.","core":true,"importance":4.5,"relevance":100,"frequency":5.63},{"id":18360,"text":"Perform or evaluate the results of diagnostic tests, such as radiographs (x-rays) and electrocardiograms (EKGs).","core":true,"importance":4.44,"relevance":100,"frequency":5.26},{"id":18358,"text":"Select, order, or administer pre-anesthetic medications.","core":true,"importance":4.37,"relevance":100,"frequency":5.56},{"id":18374,"text":"Insert peripheral or central intravenous catheters.","core":true,"importance":4.33,"relevance":100,"frequency":5.07},{"id":18373,"text":"Insert arterial catheters or perform arterial punctures to obtain arterial blood samples.","core":true,"importance":4.27,"relevance":96.3,"frequency":3.65},{"id":18359,"text":"Discharge patients from post-anesthesia care.","core":true,"importance":4.16,"relevance":92.59,"frequency":5.28},{"id":18376,"text":"Read current literature, talk with colleagues, and participate in professional organizations or conferences to keep abreast of developments in nursing.","core":true,"importance":4.11,"relevance":100,"frequency":4},{"id":18377,"text":"Request anesthesia equipment repairs, adjustments, or safety tests.","core":true,"importance":4.04,"relevance":96.3,"frequency":3.15},{"id":18375,"text":"Instruct nurses, residents, interns, students, or other staff on topics such as anesthetic techniques, pain management and emergency responses.","core":true,"importance":3.74,"relevance":100,"frequency":4.48},{"id":18372,"text":"Disassemble and clean anesthesia equipment.","core":true,"importance":3.65,"relevance":96.3,"frequency":4.8}],"activities":[{"id":"4.A.4.a.5","importance":4.85},{"id":"4.A.1.a.1","importance":4.74},{"id":"4.A.3.b.6","importance":4.68},{"id":"4.A.2.b.3","importance":4.65},{"id":"4.A.2.b.1","importance":4.63},{"id":"4.A.1.b.1","importance":4.62},{"id":"4.A.2.a.4","importance":4.56},{"id":"4.A.1.b.2","importance":4.52},{"id":"4.A.4.a.2","importance":4.5},{"id":"4.A.1.a.2","importance":4.46},{"id":"4.A.2.a.3","importance":4.37},{"id":"4.A.2.a.2","importance":4.3},{"id":"4.A.4.a.4","importance":4.19},{"id":"4.A.4.b.3","importance":4.19},{"id":"4.A.3.b.1","importance":4.15},{"id":"4.A.2.b.6","importance":3.96},{"id":"4.A.3.a.1","importance":3.89},{"id":"4.A.4.a.8","importance":3.89},{"id":"4.A.4.b.4","importance":3.89},{"id":"4.A.4.a.1","importance":3.88},{"id":"4.A.3.a.3","importance":3.85},{"id":"4.A.1.b.3","importance":3.81},{"id":"4.A.4.b.2","importance":3.77},{"id":"4.A.3.a.2","importance":3.74},{"id":"4.A.2.a.1","importance":3.73},{"id":"4.A.4.b.6","importance":3.7},{"id":"4.A.4.a