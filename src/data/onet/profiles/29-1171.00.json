{"code":"29-1171.00","title":"Nurse Practitioners","description":"Diagnose and treat acute, episodic, or chronic illness, independently or as part of a healthcare team. May focus on health promotion and disease prevention. May order, perform, or interpret diagnostic tests such as lab work and x rays. May prescribe medication. Must be registered nurses who have specialized graduate education.","jobZone":5,"kinds":{"R":{"score":3.56,"share":0.1587},"I":{"score":5.54,"share":0.2815},"A":{"score":1.38,"share":0.0236},"S":{"score":5.52,"share":0.2802},"E":{"score":2.07,"share":0.0663},"C":{"score":4.06,"share":0.1897}},"highPoints":["I","S","C"],"tasks":[{"id":18399,"text":"Maintain complete and detailed records of patients' health care plans and prognoses.","core":true,"importance":4.91,"relevance":100,"frequency":6.52},{"id":18389,"text":"Develop treatment plans, based on scientific rationale, standards of care, and professional practice guidelines.","core":true,"importance":4.87,"relevance":100,"frequency":6.35},{"id":18393,"text":"Provide patients with information needed to promote health, reduce risk factors, or prevent disease or disability.","core":true,"importance":4.83,"relevance":100,"frequency":6.3},{"id":18382,"text":"Analyze and interpret patients' histories, symptoms, physical findings, or diagnostic information to develop appropriate diagnoses.","core":true,"importance":4.82,"relevance":100,"frequency":6.48},{"id":18385,"text":"Diagnose or treat complex, unstable, comorbid, episodic, or emergency conditions in collaboration with other health care providers as necessary.","core":true,"importance":4.78,"relevance":100,"frequency":5.09},{"id":18396,"text":"Prescribe medication dosages, routes, and frequencies, based on such patient characteristics as age and gender.","core":true,"importance":4.78,"relevance":100,"frequency":6.27},{"id":18384,"text":"Diagnose or treat chronic health care problems, such as high blood pressure and diabetes.","core":true,"importance":4.74,"relevance":100,"frequency":5.77},{"id":18392,"text":"Prescribe medications based on efficacy, safety, and cost as legally authorized.","core":true,"importance":4.74,"relevance":100,"frequency":6.26},{"id":18394,"text":"Recommend diagnostic or therapeutic interventions with attention to safety, cost, invasiveness, simplicity, acceptability, adherence, and efficacy.","core":true,"importance":4.73,"relevance":100,"frequency":6.05},{"id":18388,"text":"Detect and respond to adverse drug reactions, with special attention to vulnerable populations such as infants, children, pregnant and lactating women, or older adults.","core":true,"importance":4.71,"relevance":95.65,"frequency":4.52},{"id":18383,"text":"Diagnose or treat acute health care problems, such as illnesses, infections, or injuries.","core":true,"importance":4.7,"relevance":100,"frequency":6},{"id":18380,"text":"Counsel patients about drug regimens and possible side effects or interactions with other substances, such as food supplements, over-the-counter (OTC) medications, or herbal remedies.","core":true,"importance":4.61,"relevance":100,"frequency":5.95},{"id":18381,"text":"Order, perform, or interpret the results of diagnostic tests, such as complete blood counts (CBCs), electrocardiograms (EKGs), and radiographs (x-rays).","core":true,"importance":4.61,"relevance":100,"frequency":5.96},{"id":18378,"text":"Educate patients about self-management of acute or chronic illnesses, tailoring instructions to patients' individual circumstances.","core":true,"importance":4.59,"relevance":95.65,"frequency":5.82},{"id":18402,"text":"Maintain current knowledge of state legal regulations for nurse practitioner practice, including reimbursement of services.","core":true,"importance":4.55,"relevance":100,"frequency":3.57},{"id":18387,"text":"Consult with, or refer patients to, appropriate specialists when conditions exceed the scope of practice or expertise.","core":true,"importance":4.52,"relevance":100,"frequency":4.68},{"id":18395,"text":"Recommend interventions to modify behavior associated with health risks.","core":true,"importance":4.52,"relevance":91.3,"frequency":5.67},{"id":18386,"text":"Treat or refer patients for primary care conditions, such as headaches, hypertension, urinary tract infections, upper respiratory infections, and dermatological conditions.","core":true,"importance":4.5,"relevance":95.65,"frequency":5.95},{"id":18400,"text":"Read current literature, talk with colleagues, or participate in professional organizations or conferences to keep abreast of developments in nursing.","core":true,"importance":4.5,"relevance":100,"frequency":4.22},{"id":18379,"text":"Schedule follow-up visits to monitor patients or evaluate health or illness care.","core":true,"importance":4.45,"relevance":95.65,"frequency":5.71},{"id":18391,"text":"Perform routine or annual physical examinations.","core":true,"importance":4.45,"relevance":95.65,"frequency":5.64},{"id":18403,"text":"Maintain departmental policies and procedures in areas such as safety and infection control.","core":true,"importance":4.41,"relevance":95.65,"frequency":5.45},{"id":18397,"text":"Advocate for accessible health care that minimizes environmental health risks.","core":true,"importance":4.23,"relevance":95.65,"frequency":4.27},{"id":18390,"text":"Perform primary care procedures such as suturing, splinting, administering immunizations, taking cultures, and debriding wounds.","core":true,"importance":4.19,"relevance":91.3,"frequency":4.57},{"id":18398,"text":"Provide patients or caregivers with assistance in locating health care resources.","core":true,"importance":3.91,"relevance":95.65,"frequency":4.86},{"id":18401,"text":"Keep abreast of regulatory processes and payer systems, such as Medicare, Medicaid, managed care, and private sources.","core":true,"importance":3.83,"relevance":100,"frequency":3.87},{"id":18404,"text":"Supervise or coordinate patient care or support staff activities.","core":true,