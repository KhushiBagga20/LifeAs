{"code":"47-2053.00","title":"Terrazzo Workers and Finishers","description":"Apply a mixture of cement, sand, pigment, or marble chips to floors, stairways, and cabinet fixtures to fashion durable and decorative surfaces.","jobZone":2,"kinds":{"R":{"score":7,"share":0.5994},"I":{"score":1.8,"share":0.0799},"A":{"score":1.93,"share":0.0929},"S":{"score":1,"share":0},"E":{"score":1,"share":0},"C":{"score":3.28,"share":0.2278}},"highPoints":["R","C"],"tasks":[{"id":9825,"text":"Measure designated amounts of ingredients for terrazzo or grout, according to standard formulas and specifications, using graduated containers and scales, and load ingredients into portable mixer.","core":true,"importance":4.59,"relevance":100,"frequency":5.46},{"id":9829,"text":"Grind surfaces with a power grinder, or polish surfaces with polishing or surfacing machines.","core":true,"importance":4.44,"relevance":91.79,"frequency":5.21},{"id":9823,"text":"Cut metal division strips and press them into the terrazzo base for joints or changes of color to form designs or patterns or to help prevent cracks.","core":true,"importance":4.42,"relevance":98.78,"frequency":4.29},{"id":9824,"text":"Blend marble chip mixtures, place into panels, and push a roller over the surface to embed the chips.","core":true,"importance":4.32,"relevance":87.18,"frequency":4.09},{"id":9831,"text":"Modify mixing, grouting, grinding, or cleaning procedures, according to type of installation or material used.","core":true,"importance":4.31,"relevance":96.74,"frequency":4.65},{"id":9827,"text":"Spread, level, or smooth concrete or terrazzo mixtures to form bases or finished surfaces, using rakes, shovels, hand or power trowels, hand or power screeds, or floats.","core":true,"importance":4.21,"relevance":90.11,"frequency":4.59},{"id":9828,"text":"Grind curved surfaces or areas inaccessible to surfacing machine, such as stairways or cabinet tops, with portable hand grinder.","core":true,"importance":4.19,"relevance":89.73,"frequency":4.34},{"id":9832,"text":"Wash polished terrazzo surface, using cleaner and water, and apply sealer and curing agent according to manufacturer's specifications, using brush or sprayer.","core":true,"importance":4.19,"relevance":98.6,"frequency":4},{"id":9830,"text":"Position and secure moisture membrane and wire mesh in preparation for pouring base materials for terrazzo installation.","core":true,"importance":4.08,"relevance":97.19,"frequency":3.56},{"id":9838,"text":"Fill slight grinding depressions with matching grout material and hand-trowel for a smooth, uniform surface.","core":true,"importance":4.01,"relevance":88.75,"frequency":4.07},{"id":9834,"text":"Sprinkle colored marble or stone chips, powdered steel, or coloring powder over surface to produce prescribed finish.","core":true,"importance":4,"relevance":82.44,"frequency":3.83},{"id":9837,"text":"Clean installation site, mixing and storage areas, tools, machines, and equipment, and store materials and equipment.","core":true,"importance":4,"relevance":98.6,"frequency":4.71},{"id":9833,"text":"Mix cement, sand, and water to produce concrete, grout, or slurry, using hoe, trowel, tamper, scraper, or concrete-mixing machine.","core":true,"importance":3.95,"relevance":93.87,"frequency":3.76},{"id":9835,"text":"Wet surface to prepare for bonding, fill holes and cracks with grout or slurry, and smooth with a trowel.","core":true,"importance":3.95,"relevance":99.06,"frequency":3.6},{"id":9839,"text":"Chip, scrape, or grind high spots, ridges, or rough projections to finish concrete, using pneumatic chisel, hand chisel, or other hand tools.","core":true,"importance":3.94,"relevance":88.47,"frequency":3.87},{"id":9826,"text":"Mold expansion joints and edges, using edging tools, jointers, or straightedges.","core":true,"importance":3.84,"relevance":87.82,"frequency":3.89},{"id":9841,"text":"Move terrazzo installation materials, tools, machines, or work devices to work areas, manually or using wheelbarrow.","core":true,"importance":3.84,"relevance":96.7,"frequency":4.55},{"id":9836,"text":"Repair concrete by cutting out damaged areas, drilling holes for reinforcing rods, and positioning reinforcing rods, using power saw and drill.","core":false,"importance":3.64,"relevance":59.84,"frequency":3.21},{"id":9840,"text":"Clean chipped area, using wire brush, and feel and observe surface to determine if it is rough or uneven.","core":true,"importance":3.45,"relevance":78.75,"frequency":3.78},{"id":9845,"text":"Precast terrazzo blocks in wooden forms.","core":false,"importance":3.29,"relevance":55.78,"frequency":2.37},{"id":9848,"text":"Wet concrete surface and rub with stone to smooth surface and obtain specified finish.","core":false,"importance":3.22,"relevance":53.13,"frequency":3.26},{"id":9842,"text":"Build wooden molds, clamping molds around areas to be repaired, or setting up frames to the proper depth and alignment.","core":false,"importance":3.18,"relevance":57.04,"frequency":2.34},{"id":9846,"text":"Spread roofing paper on surface of foundation and spread concrete onto roofing paper with trowel to form terrazzo base.","core":false,"importance":2.95,"relevance":49.26,"frequency":1.86},{"id":9844,"text":"Produce rough concrete surface, using broom.","core":false,"importance":2.91,"relevance":34.28,"frequency":1.98},{"id":9847,"text":"Remove frames when the foundation is dry.","core":false,"importance":2.89,"relevance":43.29,"frequency":2.15},{"id":9843,"text":"Signal truck driver to position truck to facilitate pouring concrete and move chute to direct concrete on forms.","core":false,"importance":2.76,"relevance":38.76,"frequency":1.95}],"activities":[{"id":"4.A.3.a.1","importance":4.41},{"id":"4.A.1.a.1","importance":4.18},{"id":"4.A.3.a.2","importance":4.17},{"id":"4.A.3.a.3","importance":4.04},{"id":"4.A.1.b.2","importance":3.9},{"id":"4.A.1.a.2","importance":3.85},{"id":"4.A.4.a.2","importance":3.79},{"id":"4.A.2.b.6","importance":3.73},{"id":"4.A.2.b.1","importan