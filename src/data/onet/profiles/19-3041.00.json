{"code":"19-3041.00","title":"Sociologists","description":"Study human society and social behavior by examining the groups and social institutions that people form, as well as various social, religious, political, and business organizations. May study the behavior and interaction of groups, trace their origin and growth, and analyze the influence of group activities on individual members.","jobZone":5,"kinds":{"R":{"score":1.56,"share":0.0328},"I":{"score":6.5,"share":0.3218},"A":{"score":3.99,"share":0.175},"S":{"score":4.36,"share":0.1966},"E":{"score":3.08,"share":0.1217},"C":{"score":3.6,"share":0.1521}},"highPoints":["I","S","A"],"tasks":[{"id":5465,"text":"Analyze and interpret data to increase the understanding of human social behavior.","core":true,"importance":4.74,"relevance":100,"frequency":4.75},{"id":5464,"text":"Prepare publications and reports containing research findings.","core":true,"importance":4.35,"relevance":100,"frequency":3.35},{"id":5467,"text":"Collect data about the attitudes, values, and behaviors of people in groups, using observation, interviews, and review of documents.","core":true,"importance":4.26,"relevance":95,"frequency":3.67},{"id":5468,"text":"Develop, implement, and evaluate methods of data collection, such as questionnaires or interviews.","core":true,"importance":4.26,"relevance":100,"frequency":3.75},{"id":5466,"text":"Plan and conduct research to develop and test theories about societal issues such as crime, group relations, poverty, and aging.","core":true,"importance":4.25,"relevance":100,"frequency":3.8},{"id":5469,"text":"Teach sociology.","core":true,"importance":4.25,"relevance":100,"frequency":4.9},{"id":20868,"text":"Present research findings at professional meetings.","core":true,"importance":4,"relevance":100,"frequency":2.05},{"id":23963,"text":"Explain sociological research to the general public.","core":true,"importance":3.95,"relevance":100,"frequency":2.75},{"id":5475,"text":"Develop problem intervention pro