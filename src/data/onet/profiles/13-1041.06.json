{"code":"13-1041.06","title":"Coroners","description":"Direct activities such as autopsies, pathological and toxicological analyses, and inquests relating to the investigation of deaths occurring within a legal jurisdiction to determine cause of death or to fix responsibility for accidental, violent, or unexplained deaths.","jobZone":3,"kinds":{"R":{"score":4.04,"share":0.1839},"I":{"score":4.94,"share":0.2384},"A":{"score":1.5,"share":0.0302},"S":{"score":3.1,"share":0.127},"E":{"score":4.09,"share":0.1869},"C":{"score":4.86,"share":0.2335}},"highPoints":["I","C","E"],"tasks":[{"id":8912,"text":"Perform medicolegal examinations and autopsies, conducting preliminary examinations of the body to identify victims, locate signs of trauma, and identify factors that would indicate time of death.","core":true,"importance":5,"relevance":100,"frequency":5.53},{"id":8915,"text":"Complete death certificates, including the assignment of cause and manner of death.","core":true,"importance":5,"relevance":85,"frequency":5.29},{"id":8921,"text":"Interview persons present at death scenes to obtain information useful in determining the manner of death.","core":true,"importance":5,"relevance":100,"frequency":5.35},{"id":8916,"text":"Observe and record the positions and conditions of bodies and related evidence.","core":true,"importance":4.9,"relevance":100,"frequency":4.95},{"id":8920,"text":"Remove or supervise removal of bodies from death scenes, using the proper equipment and supplies, and arrange for transportation to morgues.","core":true,"importance":4.85,"relevance":100,"frequency":5.05},{"id":8923,"text":"Provide information concerning the circumstances of death to relatives of the deceased.","core":true,"importance":4.85,"relevance":100,"frequency":5.1},{"id":8913,"text":"Inquire into the cause, manner, and circumstances of human deaths and establish the identities of deceased persons.","core":true,"importance":4.84,"relevance":100,"frequency":5.1},{"id":8918,"text":"Observe,