{"code":"31-2022.00","title":"Physical Therapist Aides","description":"Under close supervision of a physical therapist or physical therapy assistant, perform only delegated, selected, or routine tasks in specific situations. These duties include preparing the patient and the treatment area.","jobZone":2,"kinds":{"R":{"score":4.74,"share":0.2612},"I":{"score":2.58,"share":0.1103},"A":{"score":1.07,"share":0.0049},"S":{"score":5.95,"share":0.3457},"E":{"score":2.06,"share":0.074},"C":{"score":3.92,"share":0.2039}},"highPoints":["S","R","C"],"tasks":[{"id":4273,"text":"Clean and organize work area and disinfect equipment after treatment.","core":true,"importance":4.48,"relevance":100,"frequency":6.5},{"id":4276,"text":"Secure patients into or onto therapy equipment.","core":true,"importance":4.48,"relevance":95.53,"frequency":6.03},{"id":4275,"text":"Instruct, motivate, safeguard, or assist patients practicing exercises or functional activities, under direction of medical staff.","core":true,"importance":4.36,"relevance":95.33,"frequency":5.92},{"id":4278,"text":"Confer with physical therapy staff or others to discuss and evaluate patient information for planning, modifying, or coordinating treatment.","core":true,"importance":4.27,"relevance":84.92,"frequency":5.72},{"id":4274,"text":"Observe patients during treatment to compile and evaluate data on patients' responses and progress and report to physical therapist.","core":true,"importance":4.24,"relevance":80.98,"frequency":5.92},{"id":4282,"text":"Administer active or passive manual therapeutic exercises, therapeutic massage, or heat, light, sound, water, or electrical modality treatments, such as ultrasound.","core":true,"importance":4.24,"relevance":77.97,"frequency":5.6},{"id":4283,"text":"Change linens, such as bed sheets and pillow cases.","core":true,"importance":4.24,"relevance":90.31,"frequency":6.11},{"id":4279,"text":"Record treatment given and equipment used.","core":false,"importance":4.23,"relevance":64