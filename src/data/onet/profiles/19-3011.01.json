{"code":"19-3011.01","title":"Environmental Economists","description":"Conduct economic analysis related to environmental protection and use of the natural environment, such as water, air, land, and renewable energy resources. Evaluate and quantify benefits, costs, incentives, and impacts of alternative options using economic principles and statistical techniques.","jobZone":5,"kinds":{"R":{"score":2.74,"share":0.1039},"I":{"score":7,"share":0.3584},"A":{"score":2.53,"share":0.0914},"S":{"score":2.28,"share":0.0765},"E":{"score":4.11,"share":0.1858},"C":{"score":4.08,"share":0.184}},"highPoints":["I","E","C"],"tasks":[{"id":16902,"text":"Write technical documents or academic articles to communicate study results or economic forecasts.","core":true,"importance":4.48,"relevance":100,"frequency":3.15},{"id":16915,"text":"Conduct research on economic and environmental topics, such as alternative fuel use, public and private land use, soil conservation, air and water pollution control, and endangered species protection.","core":true,"importance":4.41,"relevance":100,"frequency":3.96},{"id":16910,"text":"Collect and analyze data to compare the environmental implications of economic policy or practice alternatives.","core":true,"importance":4.22,"relevance":100,"frequency":3.37},{"id":19985,"text":"Assess the costs and benefits of various activities, policies, or regulations that affect the environment or natural resource stocks.","core":true,"importance":3.93,"relevance":100,"frequency":2.96},{"id":16897,"text":"Prepare and deliver presentations to communicate economic and environmental study results, to present policy recommendations, or to raise awareness of environmental consequences.","core":true,"importance":3.89,"relevance":100,"frequency":2.41},{"id":19984,"text":"Develop programs or policy recommendations to achieve environmental goals in cost-effective ways.","core":true,"importance":3.89,"relevance":100,"frequency":2.48},{"id":16909,"text":"Develop economic mode