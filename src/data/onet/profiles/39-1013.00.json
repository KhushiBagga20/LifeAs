{"code":"39-1013.00","title":"First-Line Supervisors of Gambling Services Workers","description":"Directly supervise and coordinate activities of workers in assigned gambling areas. May circulate among tables, observe operations, and ensure that stations and games are covered for each shift. May verify and pay off jackpots. May reset slot machines after payoffs and make repairs or adjustments to slot machines or recommend removal of slot machines for repair. May plan and organize activities and services for guests in hotels/casinos.","jobZone":2,"kinds":{"R":{"score":3.7,"share":0.1909},"I":{"score":1,"share":0},"A":{"score":1,"share":0},"S":{"score":3.02,"share":0.1429},"E":{"score":5.93,"share":0.3487},"C":{"score":5.49,"share":0.3175}},"highPoints":["E","C","R"],"tasks":[{"id":23127,"text":"Monitor game operations to ensure that house rules are followed, that tribal, state, and federal regulations are adhered to, and that employees provide prompt and courteous service.","core":true,"importance":4.79,"relevance":93.6,"frequency":6.12},{"id":23129,"text":"Observe gamblers' behavior for signs of cheating, such as marking, switching, or counting cards, and notify security staff of suspected cheating.","core":true,"importance":4.76,"relevance":95.59,"frequency":5.96},{"id":23133,"text":"Perform paperwork required for monetary transactions.","core":true,"importance":4.63,"relevance":93.54,"frequency":5.95},{"id":23128,"text":"Respond to and resolve patrons' complaints.","core":true,"importance":4.61,"relevance":98.8,"frequency":5.35},{"id":23132,"text":"Greet customers and ask about the quality of service they are receiving.","core":true,"importance":4.61,"relevance":100,"frequency":6.43},{"id":23130,"text":"Perform minor repairs or make adjustments to slot machines, resolving problems such as machine tilts and coin jams.","core":true,"importance":4.55,"relevance":99.65,"frequency":5.84},{"id":23135,"text":"Maintain familiarity with the games at a facility and with strategies or tricks used by cheaters at such games.","core":true,"importance":4.52,"relevance":95.64,"frequency":5.01},{"id":23131,"text":"Monitor payment of hand-delivered jackpots to ensure promptness.","core":true,"importance":4.51,"relevance":94.2,"frequency":5.82},{"id":23134,"text":"Explain and interpret house rules, such as game rules or betting limits, for patrons.","core":true,"importance":4.5,"relevance":100,"frequency":5.82},{"id":23140,"text":"Establish and maintain banks and table limits for each game.","core":true,"importance":4.49,"relevance":89.12,"frequency":5.44},{"id":23136,"text":"Reset slot machines after payoffs.","core":true,"importance":4.45,"relevance":89.38,"frequency":5.79},{"id":23137,"text":"Answer patrons' questions about gaming machine functions and payouts.","core":true,"importance":4.37,"relevance":100,"frequency":5.81},{"id":23138,"text":"Record the specifics of malfunctioning machines and document malfunctions needing repair.","core":true,"importance":4.34,"relevance":96.95,"frequency":5.22},{"id":23147,"text":"Monitor patrons for signs of compulsive gambling, offering assistance if necessary.","core":true,"importance":4.31,"relevance":100,"frequency":4.81},{"id":23149,"text":"Monitor functioning of slot machine coin dispensers and fill coin hoppers when necessary.","core":false,"importance":4.3,"relevance":34.08,"frequency":4.98},{"id":23139,"text":"Report customer-related incidents occurring in gaming areas to supervisors.","core":true,"importance":4.29,"relevance":93.6,"frequency":4.83},{"id":23152,"text":"Supervise the distribution of complimentary meals, hotel rooms, discounts, or other items given to players, based on length of play and amount bet.","core":true,"importance":4.29,"relevance":89.07,"frequency":5.96},{"id":23148,"text":"Record, issue receipts for, and pay off bets.","core":false,"importance":4.24,"relevance":60.32,"frequency":null},{"id":23141,"text":"Attach \"out of order\" signs to malfunctioning machines, and notify technicians when machines need to be repaired or removed.","core":true,"importance":4.18,"relevance":93.01,"frequency":5.01},{"id":23142,"text":"Enforce safety rules, and report or remove safety hazards as well as guests who are underage, intoxicated, disruptive, or cheating.","core":true,"importance":4.15,"relevance":94.38,"frequency":4.38},{"id":23143,"text":"Exchange currency for customers, converting currency into requested combinations of bills and coins.","core":true,"importance":4.12,"relevance":85.88,"frequency":5.7},{"id":23150,"text":"Determine how many gaming tables to open each day and schedule staff accordingly.","core":false,"importance":4.05,"relevance":59.1,"frequency":4.89},{"id":23146,"text":"Evaluate workers' performance and prepare written performance evaluations.","core":true,"importance":4.01,"relevance":91.11,"frequency":2.3},{"id":23151,"text":"Direct workers compiling summary sheets for each race or event to record amounts wagered and amounts to be paid to winners.","core":false,"importance":3.88,"relevance":36.63,"frequency":null},{"id":23144,"text":"Monitor stations and games and move dealers from game to game to ensure adequate staffing.","core":true,"importance":3.83,"relevance":82.78,"frequency":5.45},{"id":23145,"text":"Clean and maintain slot machines and surrounding areas.","core":true,"importance":3.76,"relevance":91.33,"frequency":4.99},{"id":23153,"text":"Review operational expenses, budget estimates, betting accounts, or collection reports for accuracy.","core":false,"importance":3.2,"relevance":39.88,"frequency":null},{"id":23154,"text":"Establish policies on types of gambling offered, odds, or extension of credit.","core":false,"importance":null,"relevance":28.01,"frequency":null},{"id":23155,"text":"Interview and hire workers.","core":true,"importance":null,"relevance":null,"frequency":null},{"id":23156,"text":"Train, supervise, schedule, and evaluate workers.","core":true,"importance":null,"relevance":null,"frequency":n