{"code":"53-4031.00","title":"Railroad Conductors and Yardmasters","description":"Coordinate activities of switch-engine crew within railroad yard, industrial plant, or similar location. Conductors coordinate activities of train crew on passenger or freight trains. Yardmasters review train schedules and switching orders and coordinate activities of workers engaged in railroad traffic operations, such as the makeup or breakup of trains and yard switching.","jobZone":2,"kinds":{"R":{"score":5.8,"share":0.362},"I":{"score":1.97,"share":0.0732},"A":{"score":1,"share":0},"S":{"score":1.85,"share":0.0641},"E":{"score":3.77,"share":0.2089},"C":{"score":4.87,"share":0.2919}},"highPoints":["R","C","E"],"tasks":[{"id":10702,"text":"Observe yard traffic to determine tracks available to accommodate inbound and outbound traffic.","core":true,"importance":4.77,"relevance":72.65,"frequency":5.95},{"id":10708,"text":"Inspect freight cars for compliance with sealing procedures, and record car numbers and seal numbers.","core":false,"importance":4.61,"relevance":56.88,"frequency":5.69},{"id":10697,"text":"Receive instructions from dispatchers regarding trains' routes, timetables, and cargoes.","core":true,"importance":4.59,"relevance":90.92,"frequency":5.81},{"id":10692,"text":"Direct and instruct workers engaged in yard activities, such as switching tracks, coupling and uncoupling cars, and routing inbound and outbound traffic.","core":true,"importance":4.54,"relevance":93.84,"frequency":5.82},{"id":10690,"text":"Signal engineers to begin train runs, stop trains, or change speed, using telecommunications equipment or hand signals.","core":true,"importance":4.52,"relevance":89.43,"frequency":5.73},{"id":10696,"text":"Direct engineers to move cars to fit planned train configurations, combining or separating cars to make up or break up trains.","core":true,"importance":4.47,"relevance":100,"frequency":5.95},{"id":10704,"text":"Confirm routes and destination information for freight cars.","core":true,"importance":4.45,"relevance":74.29,"frequency":5.69},{"id":10700,"text":"Arrange for the removal of defective cars from trains at stations or stops.","core":true,"importance":4.38,"relevance":85.61,"frequency":4.49},{"id":10698,"text":"Review schedules, switching orders, way bills, and shipping records to obtain cargo loading and unloading information and to plan work.","core":true,"importance":4.32,"relevance":97.98,"frequency":5.92},{"id":10705,"text":"Supervise and coordinate crew activities to transport freight and passengers and to provide boarding, porter, maid, and meal services to passengers.","core":false,"importance":4.25,"relevance":60.98,"frequency":5.38},{"id":10691,"text":"Receive information regarding train or rail problems from dispatchers or from electronic monitoring devices.","core":true,"importance":4.23,"relevance":83.19,"frequency":4.83},{"id":10694,"text":"Operate controls to activate track switches and traffic signals.","core":true,"importance":4.21,"relevance":69.16,"frequency":5.21},{"id":10706,"text":"Supervise workers in the inspection and maintenance of mechanical equipment to ensure efficient and safe train operation.","core":false,"importance":4.17,"relevance":59.06,"frequency":5.34},{"id":10701,"text":"Inspect each car periodically during runs.","core":false,"importance":4.03,"relevance":56.7,"frequency":4.5},{"id":10693,"text":"Keep records of the contents and destination of each train car, and make sure that cars are added or removed at proper points on routes.","core":true,"importance":4.02,"relevance":84.31,"frequency":5.38},{"id":10695,"text":"Instruct workers to set warning signals in front and at rear of trains during emergency stops.","core":false,"importance":4.02,"relevance":44.78,"frequency":2.32},{"id":10699,"text":"Confer with engineers regarding train routes, timetables, and cargoes, and to discuss alternative routes when there are rail defects or obstructions.","core":true,"importance":4.01,"relevance":7