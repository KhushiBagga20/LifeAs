{"code":"31-1131.00","title":"Nursing Assistants","description":"Provide or assist with basic care or support under the direction of onsite licensed nursing staff. Perform duties such as monitoring of health status, feeding, bathing, dressing, grooming, toileting, or ambulation of patients in a health or nursing facility. May include medication administration and other health-related tasks. Includes nursing care attendants, nursing aides, and nursing attendants.","jobZone":3,"kinds":{"R":{"score":4.58,"share":0.2555},"I":{"score":2.72,"share":0.1228},"A":{"score":1,"share":0},"S":{"score":5.7,"share":0.3355},"E":{"score":1.77,"share":0.055},"C":{"score":4.24,"share":0.2313}},"highPoints":["S","R","C"],"tasks":[{"id":19341,"text":"Turn or reposition bedridden patients.","core":true,"importance":4.76,"relevance":95.32,"frequency":5.89},{"id":19317,"text":"Answer patient call signals, signal lights, bells, or intercom systems to determine patients' needs.","core":true,"importance":4.69,"relevance":94.2,"frequency":6.41},{"id":19325,"text":"Feed patients or assist patients to eat or drink.","core":true,"importance":4.64,"relevance":95.59,"frequency":5.64},{"id":19329,"text":"Position or hold patients in position for surgical preparation.","core":false,"importance":4.6,"relevance":32.35,"frequency":4.79},{"id":19327,"text":"Measure and record food and liquid intake or urinary and fecal output, reporting changes to medical or nursing staff.","core":true,"importance":4.58,"relevance":83.4,"frequency":5.53},{"id":19324,"text":"Document or otherwise report observations of patient behavior, complaints, or physical symptoms to nurses.","core":true,"importance":4.52,"relevance":100,"frequency":5.47},{"id":19331,"text":"Provide physical support to assist patients to perform daily living activities, such as getting out of bed, bathing, dressing, using the toilet, standing, walking, or exercising.","core":true,"importance":4.52,"relevance":100,"frequency":5.84},{"id":19334,"text":"Remind patients to take medications or nutritional supplements.","core":true,"importance":4.46,"relevance":70.84,"frequency":5.23},{"id":19336,"text":"Review patients' dietary restrictions, food allergies, and preferences to ensure patient receives appropriate diet.","core":true,"importance":4.45,"relevance":89.85,"frequency":5.12},{"id":19342,"text":"Undress, wash, and dress patients who are unable to do so for themselves.","core":true,"importance":4.43,"relevance":97.29,"frequency":5.41},{"id":19328,"text":"Observe or examine patients to detect symptoms that may require medical attention, such as bruises, open wounds, or blood in urine.","core":true,"importance":4.42,"relevance":94.38,"frequency":5.22},{"id":19339,"text":"Supply, collect, or empty bedpans.","core":true,"importance":4.41,"relevance":83.03,"frequency":5.49},{"id":19346,"text":"Lift or assist others to lift patients to move them on or off beds, examination tables, surgical tables, or stretchers.","core":true,"importance":4.41,"relevance":91.39,"frequency":5.53},{"id":19323,"text":"Communicate with patients to ascertain feelings or need for assistance or social and emotional support.","core":true,"importance":4.39,"relevance":99.18,"frequency":5.64},{"id":19333,"text":"Record vital signs, such as temperature, blood pressure, pulse, or respiration rate, as directed by medical or nursing staff.","core":true,"importance":4.38,"relevance":80.09,"frequency":4.97},{"id":19337,"text":"Set up treating or testing equipment, such as oxygen tents, portable radiograph (x-ray) equipment, or overhead irrigation bottles, as directed by a physician or nurse.","core":false,"importance":4.38,"relevance":52.21,"frequency":4.82},{"id":19326,"text":"Gather information from caregivers, nurses, or physicians about patient condition, treatment plans, or appropriate activities.","core":true,"importance":4.37,"relevance":91.7,"frequency":5.03},{"id":19330,"text":"Prepare or serve food trays.","core":true,"importance":4.32,"relevance":93.56,"frequency":5.5},{"id":19343,"text":"Wash, groom, shave, or drape patients to prepare them for surgery, treatment, or examination.","core":true,"importance":4.32,"relevance":77.8,"frequency":5.21},{"id":19320,"text":"Change bed linens or make beds.","core":true,"importance":4.25,"relevance":97.2,"frequency":5.34},{"id":19344,"text":"Exercise patients who are comatose, paralyzed, or have restricted mobility.","core":true,"importance":4.21,"relevance":79.07,"frequency":4.72},{"id":19335,"text":"Restock patient rooms with personal hygiene items, such as towels, washcloths, soap, or toilet paper.","core":true,"importance":4.14,"relevance":86.04,"frequency":5.07},{"id":19316,"text":"Administer medications or treatments, such as catheterizations, suppositories, irrigations, enemas, massages, or douches, as directed by a physician or nurse.","core":false,"importance":4.13,"relevance":39.54,"frequency":4.93},{"id":19321,"text":"Clean and sanitize patient rooms, bathrooms, examination rooms, or other patient areas.","core":true,"importance":4.13,"relevance":79.12,"frequency":5.02},{"id":19319,"text":"Assist nurses or physicians in the operation of medical equipment or provision of patient care.","core":true,"importance":4.11,"relevance":69.3,"frequency":5.13},{"id":19332,"text":"Record height or weight of patients.","core":true,"importance":4.07,"relevance":85.5,"frequency":4.02},{"id":19318,"text":"Apply clean dressings, slings, stockings, or support bandages, under direction of nurse or physician.","core":false,"importance":4.03,"relevance":60.99,"frequency":4.41},{"id":19340,"text":"Transport patients to treatment units, testing units, operating rooms, or other areas, using wheelchairs, stretchers, or moveable beds.","core":true,"importance":3.99,"relevance":79,"frequency":4.78},{"id":19338,"text":"Stock or issue medical supplies, such as dressing packs or treatment trays.","core":false,"importance":3.97,"relevance":51.51,"frequency":4.69},{"id":19322,"text