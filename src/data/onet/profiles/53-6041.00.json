{"code":"53-6041.00","title":"Traffic Technicians","description":"Conduct field studies to determine traffic volume, speed, effectiveness of signals, adequacy of lighting, and other factors influencing traffic conditions, under direction of traffic engineer.","jobZone":3,"kinds":{"R":{"score":4.87,"share":0.2975},"I":{"score":4.38,"share":0.2598},"A":{"score":1.4,"share":0.0307},"S":{"score":1.93,"share":0.0715},"E":{"score":1.96,"share":0.0738},"C":{"score":4.47,"share":0.2667}},"highPoints":["R","C","I"],"tasks":[{"id":8631,"text":"Prepare drawings of proposed signal installations or other control devices, using drafting instruments or computer-automated drafting equipment.","core":false,"importance":4.09,"relevance":66.31,"frequency":3.35},{"id":8635,"text":"Study factors affecting traffic conditions, such as lighting or sign and marking visibility, to assess their effectiveness.","core":true,"importance":4.03,"relevance":80.68,"frequency":3.36},{"id":8630,"text":"Interact with the public to answer traffic-related questions, respond to complaints or requests, or discuss traffic control ordinances, plans, policies, or procedures.","core":true,"importance":4.01,"relevance":84.19,"frequency":3.31},{"id":8632,"text":"Plan, design, and improve components of traffic control systems to accommodate current or projected traffic and to increase usability and efficiency.","core":true,"importance":3.94,"relevance":75.55,"frequency":2.93},{"id":8634,"text":"Prepare work orders for repair, maintenance, or changes in traffic systems.","core":true,"importance":3.94,"relevance":86.17,"frequency":3.31},{"id":8633,"text":"Analyze data related to traffic flow, accident rates, or proposed development to determine the most efficient methods to expedite traffic flow.","core":true,"importance":3.89,"relevance":80.41,"frequency":3.06},{"id":8636,"text":"Visit development or work sites to determine projects' effect on traffic and the adequacy of traffic control and safety plans or to sugg