{"code":"29-1221.00","title":"Pediatricians, General","description":"Diagnose, treat, and help prevent diseases and injuries in children. May refer patients to specialists for further diagnosis or treatment, as needed.","jobZone":5,"kinds":{"R":{"score":3.64,"share":0.143},"I":{"score":6.18,"share":0.2806},"A":{"score":1.88,"share":0.0477},"S":{"score":6.64,"share":0.3055},"E":{"score":2.54,"share":0.0834},"C":{"score":3.58,"share":0.1398}},"highPoints":["S","I"],"tasks":[{"id":7821,"text":"Prescribe or administer treatment, therapy, medication, vaccination, and other specialized medical care to treat or prevent illness, disease, or injury in infants and children.","core":true,"importance":4.95,"relevance":99.8,"frequency":6.92},{"id":7820,"text":"Examine children regularly to assess their growth and development.","core":true,"importance":4.94,"relevance":99.8,"frequency":6.89},{"id":7824,"text":"Treat children who have minor illnesses, acute and chronic health problems, and growth and development concerns.","core":true,"importance":4.91,"relevance":100,"frequency":6.92},{"id":7819,"text":"Examine patients or order, perform, and interpret diagnostic tests to obtain information on medical condition and determine diagnosis.","core":true,"importance":4.86,"relevance":100,"frequency":6.49},{"id":7823,"text":"Advise patients, parents or guardians, and community members concerning diet, activity, hygiene, and disease prevention.","core":true,"importance":4.84,"relevance":99.25,"frequency":6.61},{"id":7825,"text":"Explain procedures and discuss test results or prescribed treatments with patients and parents or guardians.","core":true,"importance":4.81,"relevance":100,"frequency":6.42},{"id":7822,"text":"Collect, record, and maintain patient information, such as medical history, reports, or examination results.","core":true,"importance":4.77,"relevance":95.09,"frequency":6.88},{"id":7826,"text":"Monitor patients' conditions and progress and reevaluate treatments as necessar