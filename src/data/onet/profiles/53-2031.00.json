{"code":"53-2031.00","title":"Flight Attendants","description":"Monitor safety of the aircraft cabin. Provide services to airline passengers, explain safety information, serve food and beverages, and respond to emergency incidents.","jobZone":2,"kinds":{"R":{"score":4.04,"share":0.2239},"I":{"score":2.04,"share":0.0766},"A":{"score":1.27,"share":0.0199},"S":{"score":4.19,"share":0.2349},"E":{"score":3.63,"share":0.1937},"C":{"score":4.41,"share":0.2511}},"highPoints":["C","S","R"],"tasks":[{"id":9639,"text":"Verify that first aid kits and other emergency equipment, including fire extinguishers and oxygen bottles, are in working order.","core":true,"importance":4.86,"relevance":100,"frequency":5.74},{"id":9637,"text":"Announce and demonstrate safety and emergency procedures, such as the use of oxygen masks, seat belts, and life jackets.","core":true,"importance":4.81,"relevance":100,"frequency":5.97},{"id":23942,"text":"Monitor passenger behavior to identify threats to the safety of the crew and other passengers.","core":true,"importance":4.74,"relevance":98.71,"frequency":6.13},{"id":9638,"text":"Walk aisles of planes to verify that passengers have complied with federal regulations prior to takeoffs and landings.","core":true,"importance":4.73,"relevance":100,"frequency":6.17},{"id":9636,"text":"Direct and assist passengers in emergency procedures, such as evacuating a plane following an emergency landing.","core":true,"importance":4.69,"relevance":89.25,"frequency":null},{"id":9642,"text":"Prepare passengers and aircraft for landing, following procedures.","core":true,"importance":4.68,"relevance":100,"frequency":5.9},{"id":9640,"text":"Administer first aid to passengers in distress.","core":true,"importance":4.64,"relevance":99.25,"frequency":3.33},{"id":9643,"text":"Determine special assistance needs of passengers, such as small children, the elderly, or persons with disabilities.","core":true,"importance":4.3,"relevance":99.16,"frequency":5.85},{"id":9641,"text":"Attend preflight briefings concerning weather, altitudes, routes, emergency procedures, crew coordination, lengths of flights, food and beverage services offered, and numbers of passengers.","core":true,"importance":4.29,"relevance":100,"frequency":5.7},{"id":9645,"text":"Reassure passengers when situations, such as turbulence, are encountered.","core":true,"importance":4.24,"relevance":100,"frequency":5.52},{"id":9644,"text":"Check to ensure that food, beverages, blankets, reading material, emergency equipment, and other supplies are aboard and are in adequate supply.","core":true,"importance":4.15,"relevance":100,"frequency":5.58},{"id":9646,"text":"Announce flight delays and descent preparations.","core":true,"importance":4.01,"relevance":96.42,"frequency":5.39},{"id":9656,"text":"Prepare reports showing places of departure and destination, passenger ticket numbers, meal and beverage inventories, the conditions of cabin equipment, and any problems encountered by passengers.","core":true,"importance":4.01,"relevance":80.64,"frequency":4.76},{"id":9651,"text":"Greet passengers boarding aircraft and direct them to assigned seats.","core":true,"importance":3.99,"relevance":100,"frequency":5.86},{"id":9649,"text":"Assist passengers entering or disembarking the aircraft.","core":true,"importance":3.93,"relevance":100,"frequency":5.61},{"id":9650,"text":"Inspect and clean cabins, checking for any problems and making sure that cabins are in order.","core":true,"importance":3.84,"relevance":99.01,"frequency":5.81},{"id":9652,"text":"Conduct periodic trips through the cabin to ensure passenger comfort and to distribute reading material, headphones, pillows, playing cards, and blankets.","core":true,"importance":3.84,"relevance":81.41,"frequency":6.05},{"id":9654,"text":"Operate audio and video systems.","core":true,"importance":3.66,"relevance":84.48,"frequency":5.02},{"id":9648,"text":"Answer passengers' questions about flights, aircraft, weather, travel routes and services, arrival times, or schedules.","core":true,"importance":3.6,"relevance":100,"frequency":5.85},{"id":9657,"text":"Collect money for meals and beverages.","core":true,"importance":3.56,"relevance":72.48,"frequency":5.94},{"id":9658,"text":"Heat and serve prepared foods.","core":true,"importance":3.43,"relevance":91.61,"frequency":5.1},{"id":9647,"text":"Inspect passenger tickets to verify information and to obtain destination information.","core":true,"importance":3.41,"relevance":81.54,"frequency":5.17},{"id":9655,"text":"Assist passengers in placing carry-on luggage in overhead, garment, or under-seat storage.","core":true,"importance":3.34,"relevance":100,"frequency":5.31},{"id":9653,"text":"Take inventory of headsets, alcoholic beverages, and money collected.","core":false,"importance":3.1,"relevance":62.55,"frequency":5.43},{"id":9659,"text":"Sell alcoholic beverages to passengers.","core":false,"importance":2.92,"relevance":100,"frequency":5.9}],"activities":[{"id":"4.A.4.a.8","importance":4.81},{"id":"4.A.1.a.1","importance":4.26},{"id":"4.A.2.b.1","importance":4.25},{"id":"4.A.1.b.1","importance":4.09},{"id":"4.A.4.a.5","importance":4.06},{"id":"4.A.4.a.7","importance":4.05},{"id":"4.A.1.a.2","importance":4.04},{"id":"4.A.3.a.2","importance":4.04},{"id":"4.A.2.a.3","importance":3.98},{"id":"4.A.3.a.1","importance":3.97},{"id":"4.A.1.b.2","importance":3.89},{"id":"4.A.2.b.3","importance":3.75},{"id":"4.A.2.a.1","importance":3.61},{"id":"4.A.2.a.2","importance":3.53},{"id":"4.A.4.a.4","importance":3.51},{"id":"4.A.2.b.6","importance":3.4},{"id":"4.A.2.b.5","importance":3.35},{"id":"4.A.4.a.2","importance":3.34},{"id":"4.A.4.b.1","importance":3.06},{"id":"4.A.2.a.4","importance":2.99},{"id":"4.A.1.b.3","importance":2.92},{"id":"4.A.3.b.6","importance":2.87},{"id":"4.A.2.b.2","importance":2.86},{"id":"4.A.3.b.1","importance":2.81},{"id":"4.A.4.a.3","importance":2.71},{"id":"4.A.4.b.3","importance":2.7},{"id":"4.A.4.a.1","importance":2.57},{"id":"4.A.4.a.6","i