{"code":"51-4051.00","title":"Metal-Refining Furnace Operators and Tenders","description":"Operate or tend furnaces, such as gas, oil, coal, electric-arc or electric induction, open-hearth, or oxygen furnaces, to melt and refine metal before casting or to produce specified types of steel.","jobZone":2,"kinds":{"R":{"score":6.88,"share":0.5516},"I":{"score":2.75,"share":0.1642},"A":{"score":1.05,"share":0.0047},"S":{"score":1.01,"share":0.0009},"E":{"score":1,"share":0},"C":{"score":3.97,"share":0.2786}},"highPoints":["R","C"],"tasks":[{"id":10163,"text":"Regulate supplies of fuel and air, or control flow of electric current and water coolant to heat furnaces and adjust temperatures.","core":true,"importance":4.62,"relevance":85.86,"frequency":6.01},{"id":10158,"text":"Draw smelted metal samples from furnaces or kettles for analysis, and calculate types and amounts of materials needed to ensure that materials meet specifications.","core":true,"importance":4.6,"relevance":82.05,"frequency":5.74},{"id":10171,"text":"Prepare material to load into furnaces, including cleaning, crushing, or applying chemicals, by using crushing machines, shovels, rakes, or sprayers.","core":false,"importance":4.55,"relevance":60.34,"frequency":5.44},{"id":10162,"text":"Weigh materials to be charged into furnaces, using scales.","core":true,"importance":4.54,"relevance":73.41,"frequency":5.79},{"id":10160,"text":"Record production data, and maintain production logs.","core":true,"importance":4.51,"relevance":90.03,"frequency":6.27},{"id":10165,"text":"Observe air and temperature gauges or metal color and fluidity, and turn fuel valves or adjust controls to maintain required temperatures.","core":true,"importance":4.49,"relevance":89.44,"frequency":6.1},{"id":10161,"text":"Operate controls to move or discharge metal workpieces from furnaces.","core":true,"importance":4.48,"relevance":84.42,"frequency":5.72},{"id":10164,"text":"Inspect furnaces and equipment to locate defects and wear.","cor