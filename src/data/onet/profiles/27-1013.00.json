{"code":"27-1013.00","title":"Fine Artists, Including Painters, Sculptors, and Illustrators","description":"Create original artwork using any of a wide variety of media and techniques.","jobZone":3,"kinds":{"R":{"score":4.05,"share":0.2072},"I":{"score":2.68,"share":0.1141},"A":{"score":7,"share":0.4076},"S":{"score":2.28,"share":0.087},"E":{"score":2.37,"share":0.0931},"C":{"score":2.34,"share":0.091}},"highPoints":["A","R"],"tasks":[{"id":10989,"text":"Use materials such as pens and ink, watercolors, charcoal, oil, or computer software to create artwork.","core":true,"importance":4.47,"relevance":89.51,"frequency":5.03},{"id":10990,"text":"Integrate and develop visual elements, such as line, space, mass, color, and perspective, to produce desired effects, such as the illustration of ideas, emotions, or moods.","core":true,"importance":4.26,"relevance":96.57,"frequency":4.72},{"id":11011,"text":"Model substances such as clay or wax, using fingers and small hand tools to form objects.","core":false,"importance":4.16,"relevance":26.77,"frequency":null},{"id":11000,"text":"Create sculptures, statues, and other three-dimensional artwork by using abrasives and tools to shape, carve, and fabricate materials such as clay, stone, wood, or metal.","core":false,"importance":4.01,"relevance":47.04,"frequency":null},{"id":20992,"text":"Set up exhibitions of artwork for display or sale.","core":false,"importance":3.99,"relevance":61.4,"frequency":2.1},{"id":10998,"text":"Render drawings, illustrations, and sketches of buildings, manufactured products, or models, working from sketches, blueprints, memory, models, or reference materials.","core":false,"importance":3.92,"relevance":39.68,"frequency":3.43},{"id":10991,"text":"Confer with clients, editors, writers, art directors, and other interested parties regarding the nature and content of artwork to be produced.","core":true,"importance":3.86,"relevance":73.75,"frequency":3.44},{"id":11003,"text":"Shade and fill in sketch outli