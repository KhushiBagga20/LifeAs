{"code":"29-1299.01","title":"Naturopathic Physicians","description":"Diagnose, treat, and help prevent diseases using a system of practice that is based on the natural healing capacity of individuals. May use physiological, psychological or mechanical methods. May also use natural medicines, prescription or legend drugs, foods, herbs, or other natural remedies.","jobZone":5,"kinds":{"R":{"score":4.53,"share":0.2054},"I":{"score":5.89,"share":0.2845},"A":{"score":1.81,"share":0.0471},"S":{"score":5.73,"share":0.2752},"E":{"score":1.98,"share":0.057},"C":{"score":3.25,"share":0.1309}},"highPoints":["I","S","R"],"tasks":[{"id":18418,"text":"Document patients' histories, including identifying data, chief complaints, illnesses, previous medical or family histories, or psychosocial characteristics.","core":true,"importance":4.96,"relevance":100,"frequency":6.64},{"id":18412,"text":"Educate patients about health care management.","core":true,"importance":4.88,"relevance":100,"frequency":6.6},{"id":18413,"text":"Advise patients about therapeutic exercise and nutritional medicine regimens.","core":true,"importance":4.88,"relevance":100,"frequency":6.56},{"id":18410,"text":"Conduct physical examinations and physiological function tests for diagnostic purposes.","core":true,"importance":4.87,"relevance":92,"frequency":5.7},{"id":18409,"text":"Administer, dispense, or prescribe natural medicines, such as food or botanical extracts, herbs, dietary supplements, vitamins, nutraceuticals, and amino acids.","core":true,"importance":4.84,"relevance":100,"frequency":6.52},{"id":18411,"text":"Interview patients to document symptoms and health histories.","core":true,"importance":4.84,"relevance":100,"frequency":6.8},{"id":18414,"text":"Diagnose health conditions, based on patients' symptoms and health histories, laboratory and diagnostic radiology test results, or other physiological measurements, such as electrocardiograms and electroencephalographs.","core":true,"importance":4.71,"relevance":96,"frequency":6},{"id":18408,"text":"Administer treatments or therapies, such as homeopathy, hydrotherapy, Oriental or Ayurvedic medicine, electrotherapy, and diathermy, using physical agents including air, heat, cold, water, sound, or ultraviolet light to catalyze the body to heal itself.","core":true,"importance":4.4,"relevance":100,"frequency":5.76},{"id":18420,"text":"Consult with other health professionals to provide optimal patient care, referring patients to traditional health care professionals as necessary.","core":true,"importance":4.36,"relevance":100,"frequency":4.24},{"id":18407,"text":"Order diagnostic imaging procedures such as radiographs (x-rays), ultrasounds, mammograms, and bone densitometry tests, or refer patients to other health professionals for these procedures.","core":true,"importance":4.26,"relevance":96,"frequency":4.04},{"id":18406,"text":"Maintain professional development through activities such as postgraduate education, continuing education, preceptorships, and residency programs.","core":true,"importance":4.16,"relevance":100,"frequency":3.24},{"id":18424,"text":"Obtain medical records from previous physicians or other health care providers for the purpose of patient evaluation.","core":true,"importance":4.04,"relevance":100,"frequency":4.52},{"id":18423,"text":"Conduct periodic public health maintenance activities such as immunizations and screenings for diseases and disease risk factors.","core":true,"importance":3.86,"relevance":88,"frequency":3.95},{"id":18415,"text":"Perform venipuncture or skin pricking to collect blood samples.","core":true,"importance":3.67,"relevance":87.5,"frequency":3.29},{"id":18422,"text":"Monitor updates from public health agencies to keep abreast of health trends.","core":true,"importance":3.67,"relevance":96,"frequency":3.25},{"id":18405,"text":"Perform mobilizations and high-velocity adjustments to joints or soft tissues, using principles of massage, stretching, or resistance.","core":true,"importance":3.63,"relevance":76,"frequency":3.61},{"id":18417,"text":"Prescribe synthetic drugs under the supervision of medical doctors or within the allowances of regulatory bodies.","core":true,"importance":3.47,"relevance":76,"frequency":3.84},{"id":18419,"text":"Perform minor surgical procedures, such as removing warts, moles, or cysts, sampling tissues for skin cancer or lipomas, and applying or removing sutures.","core":false,"importance":3.33,"relevance":60,"frequency":2.86},{"id":18421,"text":"Report patterns of patients' health conditions, such as disease status and births, to public health agencies.","core":true,"importance":3.29,"relevance":88,"frequency":1.77},{"id":18416,"text":"Treat minor cuts, abrasions, or contusions.","core":true,"importance":3.24,"relevance":84,"frequency":2.86}],"activities":[{"id":"4.A.4.a.5","importance":4.84},{"id":"4.A.3.b.6","importance":4.76},{"id":"4.A.1.a.1","importance":4.72},{"id":"4.A.2.b.1","importance":4.62},{"id":"4.A.2.b.3","importance":4.28},{"id":"4.A.4.a.1","importance":4.28},{"id":"4.A.2.a.4","importance":4.24},{"id":"4.A.4.a.4","importance":4.2},{"id":"4.A.1.b.1","importance":4.16},{"id":"4.A.4.a.8","importance":4.04},{"id":"4.A.1.a.2","importance":3.92},{"id":"4.A.3.b.1","importance":3.88},{"id":"4.A.2.a.2","importance":3.84},{"id":"4.A.2.b.2","importance":3.72},{"id":"4.A.2.b.6","importance":3.72},{"id":"4.A.4.c.1","importance":3.68},{"id":"4.A.4.a.3","importance":3.64},{"id":"4.A.2.b.5","importance":3.6},{"id":"4.A.4.a.2","importance":3.6},{"id":"4.A.2.b.4","importance":3.44},{"id":"4.A.2.a.1","importance":3.4},{"id":"4.A.4.b.6","importance":3.36},{"id":"4.A.4.b.5","importance":3.32},{"id":"4.A.4.c.3","importance":3.29},{"id":"4.A.2.a.3","importance":3.28},{"id":"4.A.4.a.6","importance":3.24},{"id":"4.A.4.a.7","importance":3.24},{"id":"4.A.4.b.3","importance":3.24},{"id":"4.A.1.b.3","importance":2.92},{"id":"4.A.4.b.2","importance":2.92},{"id":"4.A.4.b.4","importance":2.72},{"id":"4.A.1.b.2","importance"