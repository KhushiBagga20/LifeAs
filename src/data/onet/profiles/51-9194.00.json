{"code":"51-9194.00","title":"Etchers and Engravers","description":"Engrave or etch metal, wood, rubber, or other materials. Includes such workers as etcher-circuit processors, pantograph engravers, and silk screen etchers.","jobZone":2,"kinds":{"R":{"score":6.52,"share":0.4402},"I":{"score":2.45,"share":0.1156},"A":{"score":3.75,"share":0.2193},"S":{"score":1.38,"share":0.0303},"E":{"score":1,"share":0},"C":{"score":3.44,"share":0.1946}},"highPoints":["R","A","C"],"tasks":[{"id":14395,"text":"Inspect etched work for depth of etching, uniformity, and defects, using calibrated microscopes, gauges, fingers, or magnifying lenses.","core":true,"importance":4.55,"relevance":84.96,"frequency":5.98},{"id":14396,"text":"Prepare workpieces for etching or engraving by cutting, sanding, cleaning, polishing, or treating them with wax, acid resist, lime, etching powder, or light-sensitive enamel.","core":false,"importance":4.53,"relevance":53.84,"frequency":5.94},{"id":14379,"text":"Engrave and print patterns, designs, etchings, trademarks, or lettering onto flat or curved surfaces of a wide variety of metal, glass, plastic, or paper items, using hand tools or hand-held power tools.","core":false,"importance":4.52,"relevance":55.89,"frequency":5.52},{"id":14388,"text":"Prepare etching chemicals according to formulas, diluting acid with water to obtain solutions of specified concentration.","core":false,"importance":4.5,"relevance":31.29,"frequency":4.13},{"id":21027,"text":"Use computer software to design patterns for engraving.","core":false,"importance":4.49,"relevance":45.53,"frequency":5.93},{"id":14386,"text":"Examine sketches, diagrams, samples, blueprints, or photographs to decide how designs are to be etched, cut, or engraved onto workpieces.","core":true,"importance":4.45,"relevance":84.56,"frequency":5.72},{"id":14409,"text":"Expose workpieces to acid to develop etch patterns such as designs, lettering, or figures.","core":false,"importance":4.43,"relevance":42.82,"frequency":null},{"id":14378,"text":"Adjust depths and sizes of cuts by adjusting heights of worktables, or by adjusting machine-arm gauges.","core":false,"importance":4.42,"relevance":33.17,"frequency":6.27},{"id":14383,"text":"Measure and compute dimensions of lettering, designs, or patterns to be engraved.","core":false,"importance":4.34,"relevance":62.77,"frequency":5.79},{"id":14394,"text":"Neutralize workpieces to remove acid, wax, or enamel, using water, solvents, brushes, or specialized machines.","core":false,"importance":4.33,"relevance":34.42,"frequency":5.36},{"id":14382,"text":"Examine engraving for quality of cut, burrs, rough spots, and irregular or incomplete engraving.","core":false,"importance":4.31,"relevance":66.76,"frequency":5.3},{"id":14399,"text":"Transfer image to workpiece, using contact printer, pantograph stylus, silkscreen printing device, or stamp pad.","core":false,"importance":4.29,"relevance":37.45,"frequency":5.63},{"id":14392,"text":"Set reduction scales to attain specified sizes of reproduction on workpieces, and set pantograph controls for required heights, depths, and widths of cuts.","core":false,"importance":4.22,"relevance":25.79,"frequency":null},{"id":14398,"text":"Print proofs or examine designs to verify accuracy of engraving, and rework engraving as required.","core":false,"importance":4.2,"relevance":66.6,"frequency":5.6},{"id":14380,"text":"Position and clamp workpieces, plates, or rollers in holding fixtures.","core":false,"importance":4.19,"relevance":42.35,"frequency":5.22},{"id":14404,"text":"Remove wax or tape from etched glassware by using a stylus or knife, or by immersing ware in hot water.","core":false,"importance":4.19,"relevance":26.01,"frequency":4.75},{"id":14384,"text":"Start machines and lower cutting tools to beginning points on patterns.","core":false,"importance":4.18,"relevance":42.27,"frequency":5.12},{"id":14401,"text":"Guide stylus over template, causing cutting tool to duplicate design or letters on workpiece.","core":false,"importance":4.18,"relevance":27.52,"frequency":null},{"id":14381,"text":"Determine machine settings, and move bars or levers to reproduce designs on rollers or plates.","core":false,"importance":4.13,"relevance":47.79,"frequency":5.9},{"id":14402,"text":"Remove completed workpieces and place them in trays.","core":false,"importance":4.08,"relevance":57.87,"frequency":6.21},{"id":14385,"text":"Clean and polish engraved areas.","core":true,"importance":4.03,"relevance":67.25,"frequency":4.92},{"id":14397,"text":"Insert cutting tools or bits into machines and secure them with wrenches.","core":false,"importance":3.93,"relevance":40.44,"frequency":4.81},{"id":14391,"text":"Sandblast exposed areas of glass to cut designs in surfaces, using spray guns.","core":false,"importance":3.72,"relevance":27.63,"frequency":5.28},{"id":14400,"text":"Sketch, trace, or scribe layout lines and designs on workpieces, plates, dies, or rollers, using compasses, scribers, gravers, or pencils.","core":false,"importance":3.63,"relevance":41.83,"frequency":4.32},{"id":14407,"text":"Fill etched characters with opaque paste to improve readability.","core":false,"importance":3.48,"relevance":30.33,"frequency":3.74},{"id":14408,"text":"Brush or wipe acid over engraving to darken or highlight inscriptions.","core":false,"importance":3.25,"relevance":26.69,"frequency":4.55}],"activities":[{"id":"4.A.1.a.1","importance":4.14},{"id":"4.A.3.a.3","importance":3.94},{"id":"4.A.2.b.6","importance":3.71},{"id":"4.A.1.b.1","importance":3.69},{"id":"4.A.3.a.2","importance":3.65},{"id":"4.A.3.b.4","importance":3.62},{"id":"4.A.2.a.1","importance":3.61},{"id":"4.A.1.a.2","importance":3.57},{"id":"4.A.4.a.2","importance":3.56},{"id":"4.A.2.b.2","importance":3.52},{"id":"4.A.2.b.1","importance":3.46},{"id":"4.A.2.a.2","importance":3.44},{"id":"4.A.3.b.1","importance":3.44},{"id":"4.A.2.a.4","importance":3.43},{"id":"4.A.2.a.3","importance":3.39},{"id":"4.A.1.b.2","importance":3.25},{