{"code":"29-1229.04","title":"Physical Medicine and Rehabilitation Physicians","description":"Diagnose and treat disorders requiring physiotherapy to provide physical, mental, and occupational rehabilitation.","jobZone":5,"kinds":{"R":{"score":4.92,"share":0.221},"I":{"score":6.26,"share":0.2965},"A":{"score":1.87,"share":0.049},"S":{"score":6,"share":0.2818},"E":{"score":1.69,"share":0.0389},"C":{"score":3,"share":0.1127}},"highPoints":["I","S","R"],"tasks":[{"id":17201,"text":"Document examination results, treatment plans, and patients' outcomes.","core":true,"importance":4.86,"relevance":100,"frequency":6},{"id":17200,"text":"Examine patients to assess mobility, strength, communication, or cognition.","core":true,"importance":4.82,"relevance":100,"frequency":5.91},{"id":17203,"text":"Develop comprehensive plans for immediate and long-term rehabilitation, including therapeutic exercise, speech and occupational therapy, counseling, cognitive retraining, patient, family or caregiver education, or community reintegration.","core":true,"importance":4.77,"relevance":100,"frequency":5.41},{"id":17198,"text":"Assess characteristics of patients' pain, such as intensity, location, or duration, using standardized clinical measures.","core":true,"importance":4.71,"relevance":100,"frequency":5.91},{"id":17199,"text":"Monitor effectiveness of pain management interventions, such as medication or spinal injections.","core":true,"importance":4.7,"relevance":90.91,"frequency":5.45},{"id":17210,"text":"Provide inpatient or outpatient medical management of neuromuscular disorders, musculoskeletal trauma, acute and chronic pain, deformity or amputation, cardiac or pulmonary disease, or other disabling conditions.","core":true,"importance":4.68,"relevance":100,"frequency":5.41},{"id":17206,"text":"Consult or coordinate with other rehabilitative professionals, including physical and occupational therapists, rehabilitation nurses, speech pathologists, neuropsychologists, behavioral psychologists, social workers, or medical technicians.","core":true,"importance":4.59,"relevance":100,"frequency":5.09},{"id":17209,"text":"Prescribe orthotic and prosthetic applications and adaptive equipment, such as wheelchairs, bracing, or communication devices, to maximize patient function and self-sufficiency.","core":true,"importance":4.45,"relevance":100,"frequency":4.41},{"id":17202,"text":"Diagnose or treat performance-related conditions, such as sports injuries or repetitive-motion injuries.","core":true,"importance":4.41,"relevance":100,"frequency":5},{"id":17205,"text":"Coordinate physical medicine and rehabilitation services with other medical activities.","core":true,"importance":4.33,"relevance":95.45,"frequency":5.1},{"id":17207,"text":"Perform electrodiagnosis, including electromyography, nerve conduction studies, or somatosensory evoked potentials of neuromuscular disorders or damage.","core":true,"importance":4.33,"relevance":95.45,"frequency":4.33},{"id":17204,"text":"Prescribe physical therapy to relax the muscles and improve strength.","core":true,"importance":4.27,"relevance":100,"frequency":5.09},{"id":17208,"text":"Prescribe therapy services, such as electrotherapy, ultrasonography, heat or cold therapy, hydrotherapy, debridement, short-wave or microwave diathermy, and infrared or ultraviolet radiation, to enhance rehabilitation.","core":true,"importance":4.23,"relevance":100,"frequency":4.82},{"id":17196,"text":"Instruct interns and residents in the diagnosis and treatment of temporary or permanent physically disabling conditions.","core":true,"importance":3.94,"relevance":77.27,"frequency":3.76},{"id":17197,"text":"Conduct physical tests, such as functional capacity evaluations, to determine injured workers' capabilities to perform the physical demands of their jobs.","core":true,"importance":3.85,"relevance":90.91,"frequency":3.53}],"activities":[{"id":"4.A.2.b.1","importance":4.72},{"id":"4.A.3.b.6","importance":4.72},{"id":"4.A.1.a.1","imp