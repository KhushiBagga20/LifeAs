{"code":"47-4041.00","title":"Hazardous Materials Removal Workers","description":"Identify, remove, pack, transport, or dispose of hazardous materials, including asbestos, lead-based paint, waste oil, fuel, transmission fluid, radioactive materials, or contaminated soil. Specialized training and certification in hazardous materials handling or a confined entry permit are generally required. May operate earth-moving equipment or trucks.","jobZone":2,"kinds":{"R":{"score":7,"share":0.5172},"I":{"score":2.57,"share":0.1353},"A":{"score":1,"share":0},"S":{"score":1.48,"share":0.0414},"E":{"score":1.19,"share":0.0164},"C":{"score":4.36,"share":0.2897}},"highPoints":["R","C"],"tasks":[{"id":11591,"text":"Remove asbestos or lead from surfaces, using hand or power tools such as scrapers, vacuums, or high-pressure sprayers.","core":true,"importance":4.56,"relevance":75.89,"frequency":5.1},{"id":20796,"text":"Build containment areas prior to beginning abatement or decontamination work.","core":true,"importance":4.46,"relevance":90.84,"frequency":4.31},{"id":20797,"text":"Prepare hazardous material for removal or storage.","core":true,"importance":4.35,"relevance":96.76,"frequency":5.04},{"id":11584,"text":"Comply with prescribed safety procedures or federal laws regulating waste disposal methods.","core":true,"importance":4.3,"relevance":96.79,"frequency":4.99},{"id":11594,"text":"Identify asbestos, lead, or other hazardous materials to be removed, using monitoring devices.","core":false,"importance":4.14,"relevance":64.1,"frequency":4.39},{"id":11585,"text":"Record numbers of containers stored at disposal sites, specifying amounts or types of equipment or waste disposed.","core":true,"importance":4.11,"relevance":73.91,"frequency":4.46},{"id":11589,"text":"Clean contaminated equipment or areas for reuse, using detergents or solvents, sandblasters, filter pumps, or steam cleaners.","core":true,"importance":4.06,"relevance":80.31,"frequency":4.37},{"id":19869,"text":"Clean mol