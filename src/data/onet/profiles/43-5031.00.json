{"code":"43-5031.00","title":"Public Safety Telecommunicators","description":"Operate telephone, radio, or other communication systems to receive and communicate requests for emergency assistance at 9-1-1 public safety answering points and emergency operations centers. Take information from the public and other sources regarding crimes, threats, disturbances, acts of terrorism, fires, medical emergencies, and other public safety matters. May coordinate and provide information to law enforcement and emergency response personnel. May access sensitive databases and other information sources as needed. May provide additional instructions to callers based on knowledge of and certification in law enforcement, fire, or emergency medical procedures.","jobZone":2,"kinds":{"R":{"score":4.33,"share":0.2329},"I":{"score":2.91,"share":0.1336},"A":{"score":1,"share":0},"S":{"score":3.65,"share":0.1853},"E":{"score":2.89,"share":0.1322},"C":{"score":5.52,"share":0.3161}},"highPoints":["C","R","S"],"tasks":[{"id":2719,"text":"Provide emergency medical instructions to callers.","core":true,"importance":4.94,"relevance":81.13,"frequency":5.4},{"id":2707,"text":"Question callers to determine their locations and the nature of their problems to determine type of response needed.","core":true,"importance":4.87,"relevance":100,"frequency":6.57},{"id":2705,"text":"Determine response requirements and relative priorities of situations, and dispatch units in accordance with established procedures.","core":true,"importance":4.84,"relevance":99.93,"frequency":6.43},{"id":2711,"text":"Receive incoming telephone or alarm system calls regarding emergency and non-emergency police and fire service, emergency ambulance service, information, and after-hours calls for departments within a city.","core":true,"importance":4.77,"relevance":99.08,"frequency":6.36},{"id":2710,"text":"Relay information and messages to and from emergency sites, to law enforcement agencies, and to all other individuals or groups requiring notification.","core":true,"importance":4.73,"relevance":98.36,"frequency":6.37},{"id":2706,"text":"Record details of calls, dispatches, and messages.","core":true,"importance":4.7,"relevance":98.5,"frequency":6.61},{"id":2715,"text":"Monitor various radio frequencies, such as those used by public works departments, school security, and civil defense, to stay apprised of developing situations.","core":true,"importance":4.68,"relevance":93.15,"frequency":6.29},{"id":2717,"text":"Read and effectively interpret small-scale maps and information from a computer screen to determine locations and provide directions.","core":true,"importance":4.63,"relevance":99.93,"frequency":6.09},{"id":2712,"text":"Maintain access to, and security of, highly sensitive materials.","core":true,"importance":4.6,"relevance":93.76,"frequency":5.78},{"id":2722,"text":"Operate and maintain mobile dispatch vehicles and equipment.","core":false,"importance":4.6,"relevance":36.52,"frequency":5.52},{"id":2708,"text":"Enter, update, and retrieve information from teletype networks and computerized data systems regarding such things as wanted persons, stolen property, vehicle registration, and stolen vehicles.","core":true,"importance":4.57,"relevance":98.33,"frequency":5.96},{"id":2709,"text":"Scan status charts and computer screens, and contact emergency response field units to determine emergency units available for dispatch.","core":true,"importance":4.5,"relevance":93.02,"frequency":6},{"id":2718,"text":"Answer routine inquiries, and refer calls not requiring dispatches to appropriate departments and agencies.","core":true,"importance":4.48,"relevance":100,"frequency":6.56},{"id":2716,"text":"Learn material and pass required tests for certification.","core":true,"importance":4.39,"relevance":100,"frequency":2.49},{"id":2713,"text":"Observe alarm registers and scan maps to determine whether a specific emergency is in the dispatch service area.","core":true,"importance":4.31,"relevance":81.75,"frequency":5.74},{"id":2720,"text":"Monitor alarm systems to detect emergencies, such as fires and illegal entry into establishments.","core":false,"importance":4.31,"relevance":62.49,"frequency":5.24},{"id":2714,"text":"Maintain files of information relating to emergency calls, such as personnel rosters and emergency call-out and pager files.","core":true,"importance":4.2,"relevance":89.83,"frequency":5.07},{"id":2721,"text":"Test and adjust communication and alarm systems, and report malfunctions to maintenance units.","core":true,"importance":4.01,"relevance":71.54,"frequency":3.91}],"activities":[{"id":"4.A.3.b.1","importance":4.89},{"id":"4.A.4.a.3","importance":4.78},{"id":"4.A.3.b.6","importance":4.77},{"id":"4.A.1.a.1","importance":4.63},{"id":"4.A.2.a.2","importance":4.49},{"id":"4.A.2.b.1","importance":4.41},{"id":"4.A.4.a.2","importance":4.39},{"id":"4.A.4.a.8","importance":4.38},{"id":"4.A.2.b.3","importance":4.37},{"id":"4.A.4.a.5","importance":4.21},{"id":"4.A.4.a.1","importance":4.14},{"id":"4.A.1.b.1","importance":4.11},{"id":"4.A.4.c.1","importance":4.02},{"id":"4.A.2.b.6","importance":3.96},{"id":"4.A.4.a.7","importance":3.9},{"id":"4.A.4.a.4","importance":3.81},{"id":"4.A.1.a.2","importance":3.72},{"id":"4.A.4.b.3","importance":3.65},{"id":"4.A.2.b.4","importance":3.61},{"id":"4.A.2.a.3","importance":3.6},{"id":"4.A.2.a.4","importance":3.59},{"id":"4.A.4.b.5","importance":3.54},{"id":"4.A.1.b.2","importance":3.35},{"id":"4.A.1.b.3","importance":3.33},{"id":"4.A.4.b.2","importance":3.3},{"id":"4.A.4.c.2","importance":3.3},{"id":"4.A.2.b.5","importance":3.28},{"id":"4.A.2.a.1","importance":3.22},{"id":"4.A.4.b.1","importance":3.21},{"id":"4.A.2.b.2","importance":3.17},{"id":"4.A.4.b.4","importance":3.03},{"id":"4.A.4.b.6","importance":2.96},{"id":"4.A.4.c.3","importance":2.68},{"id":"4.A.3.b.5","importance":2.65},{"id":"4.A.3.a.3","importance":2.54},{"id":"4.A.4.a.6","importance":2.38},{"id":"4.A.3.b.4","importance":2.2},{"id":"4.A.3.a.2","