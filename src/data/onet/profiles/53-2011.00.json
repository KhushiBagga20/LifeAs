{"code":"53-2011.00","title":"Airline Pilots, Copilots, and Flight Engineers","description":"Pilot and navigate the flight of fixed-wing aircraft, usually on scheduled air carrier routes, for the transport of passengers and cargo. Requires Federal Air Transport certificate and rating for specific aircraft type used. Includes regional, national, and international airline pilots and flight instructors of airline pilots.","jobZone":4,"kinds":{"R":{"score":4.74,"share":0.2608},"I":{"score":3.15,"share":0.1499},"A":{"score":1.44,"share":0.0307},"S":{"score":2.5,"share":0.1046},"E":{"score":3.81,"share":0.196},"C":{"score":4.7,"share":0.258}},"highPoints":["R","C","E"],"tasks":[{"id":10562,"text":"Use instrumentation to guide flights when visibility is poor.","core":true,"importance":4.91,"relevance":100,"frequency":5.65},{"id":10568,"text":"Start engines, operate controls, and pilot airplanes to transport passengers, mail, or freight, adhering to flight plans, regulations, and procedures.","core":true,"importance":4.89,"relevance":100,"frequency":6.11},{"id":10564,"text":"Work as part of a flight team with other crew members, especially during takeoffs and landings.","core":true,"importance":4.88,"relevance":97.94,"frequency":6.04},{"id":10563,"text":"Respond to and report in-flight emergencies and malfunctions.","core":true,"importance":4.86,"relevance":100,"frequency":1.98},{"id":10569,"text":"Inspect aircraft for defects and malfunctions, according to pre-flight checklists.","core":true,"importance":4.82,"relevance":100,"frequency":5.64},{"id":10565,"text":"Contact control towers for takeoff clearances, arrival instructions, and other information, using radio equipment.","core":true,"importance":4.81,"relevance":100,"frequency":6.22},{"id":10571,"text":"Monitor engine operation, fuel consumption, and functioning of aircraft systems during flights.","core":true,"importance":4.72,"relevance":100,"frequency":6.5},{"id":10567,"text":"Monitor gauges, warning devices, and control panels to verify aircraft performance and to regulate engine speed.","core":true,"importance":4.7,"relevance":100,"frequency":6.49},{"id":10566,"text":"Steer aircraft along planned routes, using autopilot and flight management computers.","core":true,"importance":4.69,"relevance":100,"frequency":6.44},{"id":10570,"text":"Check passenger and cargo distributions and fuel amounts to ensure that weight and balance specifications are met.","core":true,"importance":4.6,"relevance":95.09,"frequency":5.64},{"id":10572,"text":"Confer with flight dispatchers and weather forecasters to keep abreast of flight conditions.","core":true,"importance":4.41,"relevance":97.5,"frequency":5.2},{"id":10573,"text":"Coordinate flight activities with ground crews and air traffic control and inform crew members of flight and test procedures.","core":false,"importance":4.31,"relevance":60.12,"frequency":5.33},{"id":10574,"text":"Order changes in fuel supplies, loads, routes, or schedules to ensure safety of flights.","core":true,"importance":4.25,"relevance":84.18,"frequency":3.9},{"id":10577,"text":"Brief crews about flight details, such as destinations, duties, and responsibilities.","core":true,"importance":4.23,"relevance":88.28,"frequency":5.39},{"id":10583,"text":"Conduct in-flight tests and evaluations at specified altitudes and in all types of weather to determine the receptivity and other characteristics of equipment and systems.","core":false,"importance":4.15,"relevance":35.01,"frequency":2.23},{"id":10580,"text":"File instrument flight plans with air traffic control to ensure that flights are coordinated with other air traffic.","core":false,"importance":4.09,"relevance":36.83,"frequency":3.17},{"id":10581,"text":"Perform minor maintenance work, or arrange for major maintenance.","core":false,"importance":4.02,"relevance":30.2,"frequency":3.28},{"id":10575,"text":"Choose routes, altitudes, and speeds that will provide the fastest, safest, and smoothest flights.","core":true