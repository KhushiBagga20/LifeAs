{"code":"51-8093.00","title":"Petroleum Pump System Operators, Refinery Operators, and Gaugers","description":"Operate or control petroleum refining or processing units. May specialize in controlling manifold and pumping systems, gauging or testing oil in storage tanks, or regulating the flow of oil into pipelines.","jobZone":2,"kinds":{"R":{"score":6.17,"share":0.4224},"I":{"score":2.44,"share":0.1176},"A":{"score":1,"share":0},"S":{"score":1.33,"share":0.027},"E":{"score":2.24,"share":0.1013},"C":{"score":5.06,"share":0.3317}},"highPoints":["R","C"],"tasks":[{"id":14309,"text":"Signal other workers by telephone or radio to operate pumps, open and close valves, and check temperatures.","core":true,"importance":4.3,"relevance":94.96,"frequency":5.3},{"id":14318,"text":"Maintain and repair equipment, or report malfunctioning equipment to supervisors so that repairs can be scheduled.","core":true,"importance":4.29,"relevance":100,"frequency":4.87},{"id":14305,"text":"Monitor process indicators, instruments, gauges, and meters to detect and report any possible problems.","core":true,"importance":4.28,"relevance":96.62,"frequency":5.88},{"id":14306,"text":"Start pumps and open valves or use automated equipment to regulate the flow of oil in pipelines and into and out of tanks.","core":true,"importance":4.23,"relevance":92.72,"frequency":5.25},{"id":14308,"text":"Operate control panels to coordinate and regulate process variables such as temperature and pressure, and to direct product flow rate, according to process schedules.","core":true,"importance":4.23,"relevance":85.06,"frequency":5.54},{"id":14310,"text":"Verify that incoming and outgoing products are moving through the correct meters, and that meters are working properly.","core":true,"importance":4.2,"relevance":90.12,"frequency":5.39},{"id":14317,"text":"Patrol units to monitor the amount of oil in storage tanks, and to verify that activities and operations are safe, efficient, and in compliance with regulations.","core":true,"importance":4.13,"relevance":84.09,"frequency":5.51},{"id":14313,"text":"Plan movement of products through lines to processing, storage, and shipping units, using knowledge of system interconnections and capacities.","core":true,"importance":4.12,"relevance":86.71,"frequency":5.25},{"id":14307,"text":"Control or operate manifold and pumping systems to circulate liquids through a petroleum refinery.","core":true,"importance":4.09,"relevance":79.32,"frequency":5.42},{"id":14312,"text":"Operate auxiliary equipment and control multiple processing units during distilling or treating operations, moving controls that regulate valves, pumps, compressors, and auxiliary equipment.","core":true,"importance":4.08,"relevance":77.55,"frequency":5.17},{"id":14319,"text":"Collect product samples by turning bleeder valves, or by lowering containers into tanks to obtain oil samples.","core":true,"importance":4.06,"relevance":92.8,"frequency":4.83},{"id":14311,"text":"Read automatic gauges at specified intervals to determine the flow rate of oil into or from tanks, and the amount of oil in tanks.","core":true,"importance":3.97,"relevance":85.36,"frequency":5.08},{"id":14314,"text":"Read and analyze specifications, schedules, logs, test results, and laboratory recommendations to determine how to set equipment controls to produce the required qualities and quantities of products.","core":false,"importance":3.97,"relevance":62.31,"frequency":4.92},{"id":14316,"text":"Synchronize activities with other pumphouses to ensure a continuous flow of products and a minimum of contamination between products.","core":true,"importance":3.96,"relevance":67.18,"frequency":4.7},{"id":14315,"text":"Record and compile operating data, instrument readings, documentation, and results of laboratory analyses.","core":true,"importance":3.95,"relevance":88.98,"frequency":5.14},{"id":14323,"text":"Perform tests to check the qualities and grades of products, such as assessing levels of bottom sediment, water, and foreign materials in oil samples, using centrifugal testers.","core":false,"importance":3.95,"relevance":58.9,"frequency":4.66},{"id":14321,"text":"Conduct general housekeeping of units, including wiping up oil spills and performing general cleaning duties.","core":true,"importance":3.87,"relevance":97.67,"frequency":4.92},{"id":14320,"text":"Inspect pipelines, tightening connections and lubricating valves as necessary.","core":true,"importance":3.64,"relevance":81.79,"frequency":4.48},{"id":14328,"text":"Calculate test result values, using standard formulas.","core":false,"importance":3.51,"relevance":53.53,"frequency":4.76},{"id":14326,"text":"Clean interiors of processing units by circulating chemicals and solvents within units.","core":false,"importance":3.5,"relevance":57.27,"frequency":3.37},{"id":14327,"text":"Clamp seals around valves to secure tanks.","core":false,"importance":3.37,"relevance":52.03,"frequency":3.27},{"id":14322,"text":"Coordinate shutdowns and major projects.","core":false,"importance":3.29,"relevance":66.42,"frequency":2.41},{"id":14324,"text":"Prepare calculations for receipts and deliveries of oil and oil products.","core":false,"importance":3.27,"relevance":51.08,"frequency":3.9},{"id":14325,"text":"Lower thermometers into tanks to obtain temperature readings.","core":false,"importance":2.81,"relevance":39.35,"frequency":3.29}],"activities":[{"id":"4.A.1.b.2","importance":4.24},{"id":"4.A.1.a.2","importance":4.15},{"id":"4.A.3.a.3","importance":4.1},{"id":"4.A.1.b.1","importance":4.09},{"id":"4.A.4.a.2","importance":4.01},{"id":"4.A.3.a.1","importance":3.93},{"id":"4.A.1.a.1","importance":3.88},{"id":"4.A.2.b.1","importance":3.63},{"id":"4.A.3.b.6","importance":3.6},{"id":"4.A.3.a.2","importance":3.53},{"id":"4.A.2.a.3","importance":3.4},{"id":"4.A.2.b.6","importance":3.4},{"id":"4.A.4.a.4","importance":3.4},{"id":"4.A.3.a.4","importance":3.39},{"id":"4.A.1.b.3","importance":3.37},{"id":"4.A.2.a.2","importance":3.28},