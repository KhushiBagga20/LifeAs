{"code":"19-1032.00","title":"Foresters","description":"Manage public and private forested lands for economic, recreational, and conservation purposes. May inventory the type, amount, and location of standing timber, appraise the timber's worth, negotiate the purchase, and draw up contracts for procurement. May determine how to conserve wildlife habitats, creek beds, water quality, and soil stability, and how best to comply with environmental regulations. May devise plans for planting and growing new trees, monitor trees for healthy growth, and determine optimal harvesting schedules.","jobZone":4,"kinds":{"R":{"score":5.32,"share":0.2784},"I":{"score":4.48,"share":0.2242},"A":{"score":1.25,"share":0.0161},"S":{"score":2.3,"share":0.0838},"E":{"score":3.78,"share":0.1791},"C":{"score":4.39,"share":0.2184}},"highPoints":["R","I","C"],"tasks":[{"id":196,"text":"Establish short- and long-term plans for management of forest lands and forest resources.","core":true,"importance":4.38,"relevance":95.45,"frequency":2.76},{"id":212,"text":"Plan cutting programs and manage timber sales from harvested areas, assisting companies to achieve production goals.","core":true,"importance":4.28,"relevance":90.91,"frequency":2.95},{"id":202,"text":"Determine methods of cutting and removing timber with minimum waste and environmental damage.","core":true,"importance":4.24,"relevance":95.45,"frequency":2.95},{"id":200,"text":"Negotiate terms and conditions of agreements and contracts for forest harvesting, forest management and leasing of forest lands.","core":true,"importance":4.17,"relevance":95.45,"frequency":2.57},{"id":207,"text":"Perform inspections of forests or forest nurseries.","core":true,"importance":4.17,"relevance":97.67,"frequency":3.07},{"id":195,"text":"Monitor contract compliance and results of forestry activities to assure adherence to government regulations.","core":true,"importance":4.09,"relevance":100,"frequency":3.07},{"id":197,"text":"Supervise activities of other forestry workers.","core":true,"importance":4.07,"relevance":100,"frequency":4.02},{"id":216,"text":"Provide advice and recommendations, as a consultant on forestry issues, to private woodlot owners, firefighters, government agencies or to companies.","core":true,"importance":4.05,"relevance":90.91,"frequency":3.15},{"id":219,"text":"Develop techniques for measuring and identifying trees.","core":true,"importance":4.05,"relevance":90.91,"frequency":2.9},{"id":199,"text":"Plan and supervise forestry projects, such as determining the type, number and placement of trees to be planted, managing tree nurseries, thinning forest and monitoring growth of new seedlings.","core":true,"importance":4.02,"relevance":95.45,"frequency":2.71},{"id":208,"text":"Map forest area soils and vegetation to estimate the amount of standing timber and future value and growth.","core":true,"importance":4.02,"relevance":95.45,"frequency":2.64},{"id":206,"text":"Plan and direct forest surveys and related studies and prepare reports and recommendations.","core":true,"importance":3.95,"relevance":95.45,"frequency":2.71},{"id":198,"text":"Choose and prepare sites for new trees, using controlled burning, bulldozers, or herbicides to clear weeds, brush, and logging debris.","core":true,"importance":3.88,"relevance":93.18,"frequency":2.37},{"id":204,"text":"Monitor forest-cleared lands to ensure that they are reclaimed to their most suitable end use.","core":true,"importance":3.82,"relevance":90.91,"frequency":2.3},{"id":205,"text":"Plan and implement projects for conservation of wildlife habitats and soil and water quality.","core":true,"importance":3.82,"relevance":93.18,"frequency":2.46},{"id":201,"text":"Direct, and participate in, forest fire suppression.","core":true,"importance":3.79,"relevance":75,"frequency":1.94},{"id":217,"text":"Study different tree species' classification, life history, light and soil requirements, adaptation to new environmental conditions and resistance to disease and insects.","core":true,"importance":3.67,"relevance":97.73,"frequency":2.49},{"id":211,"text":"Subcontract with loggers or pulpwood cutters for tree removal and to aid in road layout.","core":true,"importance":3.65,"relevance":90.91,"frequency":2.52},{"id":203,"text":"Analyze effect of forest conditions on tree growth rates and tree species prevalence and the yield, duration, seed production, growth viability, and germination of different species.","core":true,"importance":3.5,"relevance":90.7,"frequency":2.23},{"id":209,"text":"Conduct public educational programs on forest care and conservation.","core":true,"importance":3.5,"relevance":90.91,"frequency":2},{"id":210,"text":"Procure timber from private landowners.","core":true,"importance":3.49,"relevance":79.55,"frequency":2.43},{"id":214,"text":"Plan and direct construction and maintenance of recreation facilities, fire towers, trails, roads and bridges, ensuring that they comply with guidelines and regulations set for forested public lands.","core":true,"importance":3.33,"relevance":68.18,"frequency":1.97},{"id":215,"text":"Contact local forest owners and gain permission to take inventory of the type, amount, and location of all standing timber on the property.","core":true,"importance":3.28,"relevance":83.72,"frequency":2.22},{"id":213,"text":"Monitor wildlife populations and assess the impacts of forest operations on population and habitats.","core":true,"importance":3.1,"relevance":93.18,"frequency":2},{"id":218,"text":"Develop new techniques for wood or residue use.","core":false,"importance":2.88,"relevance":59.09,"frequency":1.27}],"activities":[{"id":"4.A.1.a.1","importance":4.08},{"id":"4.A.2.b.1","importance":4.04},{"id":"4.A.4.a.2","importance":4.02},{"id":"4.A.4.a.4","importance":3.96},{"id":"4.A.3.b.1","importance":3.94},{"id":"4.A.1.b.3","importance":3.92},{"id":"4.A.3.a.1","importance":3.88},{"id":"4.A.4.a.3","importance":3.85},{"id":"4.A.2.a.2","importance":3.78},{"id":"4.A.2.b.5","importance":3.7