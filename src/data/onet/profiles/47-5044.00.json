{"code":"47-5044.00","title":"Loading and Moving Machine Operators, Underground Mining","description":"Operate underground loading or moving machine to load or move coal, ore, or rock using shuttle or mine car or conveyors. Equipment may include power shovels, hoisting engines equipped with cable-drawn scraper or scoop, or machines equipped with gathering arms and conveyor.","jobZone":2,"kinds":{"R":{"score":7,"share":0.6091},"I":{"score":2.15,"share":0.1168},"A":{"score":1,"share":0},"S":{"score":1,"share":0},"E":{"score":1,"share":0},"C":{"score":3.7,"share":0.2741}},"highPoints":["R","C"],"tasks":[{"id":23501,"text":"Handle high voltage sources and hang electrical cables.","core":true,"importance":4.57,"relevance":null,"frequency":6.07},{"id":23498,"text":"Drive loaded shuttle cars to ramps and move controls to discharge loads into mine cars or onto conveyors.","core":true,"importance":4.46,"relevance":98.3,"frequency":6.74},{"id":15183,"text":"Pry off loose material from roofs and move it into the paths of machines, using crowbars.","core":true,"importance":4.41,"relevance":81.1,"frequency":5.41},{"id":15184,"text":"Move trailing electrical cables clear of obstructions, using rubber safety gloves.","core":true,"importance":4.4,"relevance":70.95,"frequency":5.53},{"id":15190,"text":"Stop gathering arms when cars are full.","core":false,"importance":4.39,"relevance":44.62,"frequency":6.54},{"id":23496,"text":"Control conveyors that run the entire length of shuttle cars to distribute loads as loading progresses.","core":true,"importance":4.29,"relevance":84.51,"frequency":6.44},{"id":23499,"text":"Examine roadway and clear obstructions from the path of travel.","core":true,"importance":4.27,"relevance":94.56,"frequency":6.21},{"id":23506,"text":"Observe hand signals, grade stakes, or other markings when operating machines.","core":true,"importance":4.27,"relevance":92.87,"frequency":6.41},{"id":15185,"text":"Drive machines into piles of material blasted from working faces.","core":true,"importance":4.25,"relevance":77.98,"frequency":5.04},{"id":15186,"text":"Operate levers to move conveyor booms or shovels so that mine contents such as coal, rock, and ore can be placed into cars or onto conveyors.","core":true,"importance":4.2,"relevance":74.73,"frequency":5.65},{"id":23505,"text":"Move mine cars into position for loading and unloading, using pinchbars inserted under car wheels to position cars under loading spouts.","core":false,"importance":4.18,"relevance":53.8,"frequency":5.39},{"id":15191,"text":"Advance machines to gather material and convey it into cars.","core":false,"importance":4.15,"relevance":66.29,"frequency":5.85},{"id":23495,"text":"Clean, fuel, service, and perform safety checks on all equipment, and repair and replace parts as necessary.","core":true,"importance":4.15,"relevance":79.43,"frequency":5.34},{"id":15187,"text":"Clean hoppers, and clean spillage from tracks, walks, driveways, and conveyor decking.","core":true,"importance":4.07,"relevance":69.2,"frequency":4.82},{"id":15193,"text":"Signal workers to move loaded cars.","core":false,"importance":4.01,"relevance":58.79,"frequency":5.81},{"id":15188,"text":"Oil, lubricate, and adjust conveyors, crushers, and other equipment, using hand tools and lubricating equipment.","core":true,"importance":3.97,"relevance":71.78,"frequency":4.57},{"id":23500,"text":"Guide and stop cars by switching, applying brakes, or placing scotches, or wooden wedges, between wheels and rails.","core":false,"importance":3.88,"relevance":46.6,"frequency":5.44},{"id":15194,"text":"Observe and record car numbers, carriers, customers, tonnages, and grades and conditions of material.","core":false,"importance":3.87,"relevance":30.46,"frequency":5.19},{"id":23509,"text":"Read written instructions or confer with supervisors about schedules and materials to be moved.","core":false,"importance":3.87,"relevance":59.53,"frequency":5.61},{"id":23504,"text":"Monitor loading processes to ensure that materials are loaded according to specifications.","core":true,"importance":3.85,"relevance":78.85,"frequency":6.31},{"id":23502,"text":"Maintain records of materials moved.","core":false,"importance":3.58,"relevance":64.47,"frequency":5.39},{"id":23497,"text":"Direct other workers to move stakes, place blocks, position anchors or cables, or move materials.","core":false,"importance":3.56,"relevance":54.04,"frequency":4.89},{"id":23503,"text":"Measure, weigh, or verify levels of rock, gravel, or other excavated material to prevent equipment overloads.","core":true,"importance":3.54,"relevance":69.24,"frequency":6.43},{"id":15189,"text":"Replace hydraulic hoses, headlight bulbs, and gathering-arm teeth.","core":true,"importance":3.5,"relevance":73.74,"frequency":3.78},{"id":23508,"text":"Push or ride cars down slopes, or hook cars to cables and control cable drum brakes, to ease cars down inclines.","core":false,"importance":3.09,"relevance":30.69,"frequency":3.21}],"activities":[{"id":"4.A.3.a.4","importance":4.4},{"id":"4.A.1.b.2","importance":4.05},{"id":"4.A.3.a.3","importance":3.97},{"id":"4.A.1.b.1","importance":3.9},{"id":"4.A.1.a.1","importance":3.65},{"id":"4.A.1.a.2","importance":3.57},{"id":"4.A.3.b.4","importance":3.53},{"id":"4.A.4.a.2","importance":3.46},{"id":"4.A.3.a.2","importance":3.37},{"id":"4.A.3.a.1","importance":3.28},{"id":"4.A.2.a.3","importance":3.16},{"id":"4.A.4.b.3","importance":2.91},{"id":"4.A.4.b.1","importance":2.85},{"id":"4.A.2.b.1","importance":2.81},{"id":"4.A.4.b.2","importance":2.75},{"id":"4.A.2.a.1","importance":2.69},{"id":"4.A.4.a.4","importance":2.66},{"id":"4.A.1.b.3","importance":2.59},{"id":"4.A.4.b.5","importance":2.58},{"id":"4.A.2.a.2","importance":2.56},{"id":"4.A.2.b.6","importance":2.52},{"id":"4.A.3.b.5","importance":2.52},{"id":"4.A.2.b.3","importance":2.49},{"id":"4.A.2.b.2","importance":2.48},{"id":"4.A.4.b.4","importance":2.43},{"id":"4.A.2.b.4","importance":2.36},{"id":"4.A.4.a.1","importance":2.3},{"