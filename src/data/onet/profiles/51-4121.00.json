{"code":"51-4121.00","title":"Welders, Cutters, Solderers, and Brazers","description":"Use hand-welding, flame-cutting, hand-soldering, or brazing equipment to weld or join metal components or to fill holes, indentations, or seams of fabricated metal products.","jobZone":2,"kinds":{"R":{"score":7,"share":0.5587},"I":{"score":2.08,"share":0.1006},"A":{"score":1.4,"share":0.0372},"S":{"score":1.08,"share":0.0074},"E":{"score":1.53,"share":0.0493},"C":{"score":3.65,"share":0.2467}},"highPoints":["R","C"],"tasks":[{"id":23583,"text":"Operate safety equipment and use safe work habits.","core":true,"importance":4.61,"relevance":97.52,"frequency":5.93},{"id":23584,"text":"Examine workpieces for defects and measure workpieces with straightedges or templates to ensure conformance with specifications.","core":true,"importance":4.26,"relevance":84.18,"frequency":5.21},{"id":23582,"text":"Weld components in flat, vertical, or overhead positions.","core":true,"importance":4.15,"relevance":94.23,"frequency":5.39},{"id":23605,"text":"Check grooves, angles, or gap allowances, using micrometers, calipers, and precision measuring instruments.","core":false,"importance":4.15,"relevance":58.86,"frequency":5.37},{"id":23600,"text":"Detect faulty operation of equipment or defective materials and notify supervisors.","core":true,"importance":4.11,"relevance":92.67,"frequency":3.79},{"id":23585,"text":"Recognize, set up, and operate hand and power tools common to the welding trade, such as shielded metal arc and gas metal arc welding equipment.","core":true,"importance":4.09,"relevance":94.46,"frequency":5.36},{"id":23587,"text":"Select and install torches, torch tips, filler rods, and flux, according to welding chart specifications or types and thicknesses of metals.","core":true,"importance":4.09,"relevance":69.37,"frequency":5.15},{"id":23592,"text":"Mark or tag material with proper job number, piece marks, and other identifying marks as required.","core":true,"importance":4.08,"relevance":85.87,"frequency":4.93},{"id":23590,"text":"Determine required equipment and welding methods, applying knowledge of metallurgy, geometry, and welding techniques.","core":true,"importance":4.07,"relevance":77.69,"frequency":5.36},{"id":23594,"text":"Prepare all material surfaces to be welded, ensuring that there is no loose or thick scale, slag, rust, moisture, grease, or other foreign matter.","core":true,"importance":4.06,"relevance":87.13,"frequency":5.29},{"id":23596,"text":"Align and clamp workpieces together, using rules, squares, or hand tools, or position items in fixtures, jigs, or vises.","core":true,"importance":4.05,"relevance":78.59,"frequency":5.26},{"id":23609,"text":"Melt and apply solder to fill holes, indentations, or seams of fabricated metal products, using soldering equipment.","core":false,"importance":4.01,"relevance":54.03,"frequency":4.84},{"id":23589,"text":"Connect and turn regulator valves to activate and adjust gas flow and pressure so that desired flames are obtained.","core":true,"importance":4,"relevance":73.09,"frequency":4.46},{"id":23599,"text":"Position and secure workpieces, using hoists, cranes, wire, and banding machines or hand tools.","core":true,"importance":3.97,"relevance":86.81,"frequency":5.19},{"id":23602,"text":"Melt and apply solder along adjoining edges of workpieces to solder joints, using soldering irons, gas torches, or electric-ultrasonic equipment.","core":true,"importance":3.96,"relevance":69.56,"frequency":5.38},{"id":23591,"text":"Monitor the fitting, burning, and welding processes to avoid overheating of parts or warping, shrinking, distortion, or expansion of material.","core":true,"importance":3.94,"relevance":83.18,"frequency":5.14},{"id":23588,"text":"Ignite torches or start power supplies and strike arcs by touching electrodes to metals being welded, completing electrical circuits.","core":false,"importance":3.89,"relevance":64.9,"frequency":5.23},{"id":23603,"text":"Grind, cut, buff, or bend edges of workpieces to be joined to ensure snug fit, using power grinders and hand tools.","core":true,"importance":3.89,"relevance":76.82,"frequency":5.01},{"id":23586,"text":"Weld separately or in combination, using aluminum, stainless steel, cast iron, and other alloys.","core":true,"importance":3.76,"relevance":70.35,"frequency":4.84},{"id":23593,"text":"Chip or grind off excess weld, slag, or spatter, using hand scrapers or power chippers, portable grinders, or arc-cutting equipment.","core":true,"importance":3.75,"relevance":85.08,"frequency":5.29},{"id":23598,"text":"Guide and direct flames or electrodes on or across workpieces to straighten, bend, melt, or build up metal.","core":false,"importance":3.72,"relevance":52.9,"frequency":4.97},{"id":23610,"text":"Use fire suppression methods in industrial emergencies.","core":false,"importance":3.71,"relevance":42.47,"frequency":2.63},{"id":23597,"text":"Develop templates and models for welding projects, using mathematical calculations based on blueprint information.","core":true,"importance":3.69,"relevance":77.89,"frequency":4.24},{"id":23604,"text":"Repair products by dismantling, straightening, reshaping, and reassembling parts, using cutting torches, straightening presses, and hand tools.","core":true,"importance":3.57,"relevance":68.9,"frequency":3.89},{"id":23595,"text":"Preheat workpieces prior to welding or bending, using torches or heating furnaces.","core":false,"importance":3.54,"relevance":56.04,"frequency":4.05},{"id":23601,"text":"Clean or degrease parts, using wire brushes, portable grinders, or chemical baths.","core":true,"importance":3.49,"relevance":74.75,"frequency":4.98},{"id":23607,"text":"Set up and use ladders and scaffolding as necessary to complete work.","core":false,"importance":3.47,"relevance":47.95,"frequency":4.25},{"id":23608,"text":"Hammer out bulges or bends in metal workpieces.","core":true,"importance":3.39,"relevance":73.69,"frequency":3.84},{"id":23606,"text":"Operate metal shaping, straightening, and bending machines, such as brakes and shears.","core":false,"importance":3.25,"relevance":46.57,"frequency":3.86},{"id":23611,"text":"Analyze engineering drawings, blueprints, specifications, sketches, work orders, and material safety data sheets to plan layout, assembly, and operations.","core":true,"importance":null,"relevance":null,"frequency":null}],"activities":[{"id":"4.A.1.a.1","importance":3.76},{"id":"4.A.1.b.2","importance":3.65},{"id":"4.A.1.b.1","importance":3.57},{"id":"4.A.3.a.2","importance":3.49},{"id":"4.A.1.a.2","importance":3.4},{"id":"4.A.3.a.1","importance":3.31},{"id":"4.A.4.a.2","importance":3.03},{"id":"4.A.2.b.1","importance":2.96},{"id":"4.A.3.a.3","importance":2.9},{"id":"4.A.2.a.3","importance":2.82},{"id":"4.A.1.b.3","importance":2.7},{"id":"4.A.2.b.6","importance":2.67},{"id":"4.A.2.b.2","importance":2.65},{"id":"4.A.2.b.3","importance":2.63},{"id":"4.A.3.a.4","importance":2.62},{"id":"4.A.4.a.4","importance":2.6},{"id":"4.A.4.b.3","importance":2.56},{"id":"4.A.2.a.1","importance":2.5},{"id":"4.A.2.a.2","importance":2.49},{"id":"4.A.2.a.4","importance":2.49},{"id":"4.A.2.b.4","importance":2.43},{"id":"4.A.4.b.5","importance":2.4},{"id":"4.A.2.b.5","importance":2.36},{"id":"4.A.3.b.4","importance":2.36},{"id":"4.A.4.a.5","importance":2.36},{"id":"4.A.4.a.1","importance":2.29},{"id":"4.A.3.b.2","importance":2.22},{"id":"4.A.4.b.1","importance":2.2},{"id":"4.A.3.b.1","importance":2.14},{"id":"4.A.3.b.6","importance":2.07},{"id":"4.A.4.b.2","importance":2.02},{"id":"4.A.4.b.6","importance":1.92},{"id":"4.A.4.c.3","importance":1.92},{"id":"4.A.4.a.7","importance":1.8},{"id":"4.A.4.b.4","importance":1.78},{"id":"4.A.4.c.1","importance":1.78},{"id":"4.A.3.b.5","importance":1.76},{"id":"4.A.4.c.2","importance":1.74},{"id":"4.A.4.a.6","importance":1.55},{"id":"4.A.4.a.3","importance":1.51},{"id":"4.A.4.a.8","importance":1.35}],"context":[{"id":"4.C.1.a.2.c","mean":1.46,"modal":{"category":1,"percent":63.9}},{"id":"4.C.1.a.2.f