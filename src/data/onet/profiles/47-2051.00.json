{"code":"47-2051.00","title":"Cement Masons and Concrete Finishers","description":"Smooth and finish surfaces of poured concrete, such as floors, walks, sidewalks, roads, or curbs using a variety of hand and power tools. Align forms for sidewalks, curbs, or gutters; patch voids; and use saws to cut expansion joints.","jobZone":2,"kinds":{"R":{"score":7,"share":0.5871},"I":{"score":2.29,"share":0.1262},"A":{"score":1.66,"share":0.0646},"S":{"score":1,"share":0},"E":{"score":1,"share":0},"C":{"score":3.27,"share":0.2221}},"highPoints":["R","C"],"tasks":[{"id":7047,"text":"Check the forms that hold the concrete to see that they are properly constructed.","core":true,"importance":4.2,"relevance":100,"frequency":4.96},{"id":7048,"text":"Set the forms that hold concrete to the desired pitch and depth, and align them.","core":true,"importance":4.13,"relevance":99.04,"frequency":4.25},{"id":7049,"text":"Spread, level, and smooth concrete, using rake, shovel, hand or power trowel, hand or power screed, and float.","core":true,"importance":4.07,"relevance":100,"frequency":5.31},{"id":7051,"text":"Monitor how the wind, heat, or cold affect the curing of the concrete throughout the entire process.","core":true,"importance":3.99,"relevance":88.63,"frequency":4.83},{"id":7050,"text":"Mold expansion joints and edges, using edging tools, jointers, and straightedge.","core":true,"importance":3.88,"relevance":91.04,"frequency":5.13},{"id":7052,"text":"Signal truck driver to position truck to facilitate pouring concrete, and move chute to direct concrete on forms.","core":true,"importance":3.86,"relevance":96.3,"frequency":4.7},{"id":7055,"text":"Direct the casting of the concrete and supervise laborers who use shovels or special tools to spread it.","core":true,"importance":3.83,"relevance":83.94,"frequency":4.34},{"id":7053,"text":"Produce rough concrete surface, using broom.","core":true,"importance":3.8,"relevance":95.37,"frequency":4.67},{"id":7061,"text":"Apply hardening and sealing compounds to cure surface of concrete, and waterproof or restore surface.","core":true,"importance":3.74,"relevance":86.91,"frequency":3.96},{"id":7054,"text":"Operate power vibrator to compact concrete.","core":true,"importance":3.68,"relevance":86.34,"frequency":3.6},{"id":7059,"text":"Wet surface to prepare for bonding, fill holes and cracks with grout or slurry, and smooth, using trowel.","core":true,"importance":3.63,"relevance":95.32,"frequency":4.38},{"id":7069,"text":"Install anchor bolts, steel plates, door sills and other fixtures in freshly poured concrete or pattern or stamp the surface to provide a decorative finish.","core":true,"importance":3.63,"relevance":70.48,"frequency":3.21},{"id":7068,"text":"Waterproof or restore concrete surfaces, using appropriate compounds.","core":true,"importance":3.55,"relevance":67.13,"frequency":3.63},{"id":7056,"text":"Mix cement, sand, and water to produce concrete, grout, or slurry, using hoe, trowel, tamper, scraper, or concrete-mixing machine.","core":true,"importance":3.48,"relevance":81.05,"frequency":4.3},{"id":7062,"text":"Chip, scrape, and grind high spots, ridges, and rough projections to finish concrete, using pneumatic chisels, power grinders, or hand tools.","core":true,"importance":3.33,"relevance":91.73,"frequency":4.18},{"id":7065,"text":"Sprinkle colored marble or stone chips, powdered steel, or coloring powder over surface to produce prescribed finish.","core":false,"importance":3.32,"relevance":62.13,"frequency":2.97},{"id":7057,"text":"Cut out damaged areas, drill holes for reinforcing rods, and position reinforcing rods to repair concrete, using power saw and drill.","core":true,"importance":3.27,"relevance":80.35,"frequency":3.32},{"id":7058,"text":"Wet concrete surface, and rub with stone to smooth surface and obtain specified finish.","core":true,"importance":3.27,"relevance":69.8,"frequency":3.52},{"id":7067,"text":"Fabricate concrete beams, columns, and panels.","core":false,"importance":3.23,"relevance":48.79,"frequency":3.51},{"id":7072,"text":"Polish surface, using polishing or surfacing machine.","core":false,"importance":3.18,"relevance":59.07,"frequency":3.07},{"id":7060,"text":"Clean chipped area, using wire brush, and feel and observe surface to determine if it is rough or uneven.","core":true,"importance":3.17,"relevance":85.89,"frequency":3.51},{"id":7064,"text":"Build wooden molds, and clamp molds around area to be repaired, using hand tools.","core":true,"importance":3.17,"relevance":76.47,"frequency":3.55},{"id":7066,"text":"Cut metal division strips, and press them into terrazzo base so that top edges form desired design or pattern.","core":false,"importance":3.12,"relevance":50.96,"frequency":3.48},{"id":7071,"text":"Push roller over surface to embed chips in surface.","core":false,"importance":2.98,"relevance":38.32,"frequency":3.19},{"id":7070,"text":"Apply muriatic acid to clean surface, and rinse with water.","core":false,"importance":2.87,"relevance":58.99,"frequency":2.17},{"id":7063,"text":"Spread roofing paper on surface of foundation, and spread concrete onto roofing paper with trowel to form terrazzo base.","core":false,"importance":2.78,"relevance":34.57,"frequency":2.87}],"activities":[{"id":"4.A.3.a.2","importance":4.32},{"id":"4.A.1.b.2","importance":4.3},{"id":"4.A.1.a.1","importance":4.22},{"id":"4.A.3.a.1","importance":4.21},{"id":"4.A.2.b.5","importance":4.18},{"id":"4.A.3.a.3","importance":4.17},{"id":"4.A.1.b.1","importance":4.14},{"id":"4.A.2.b.1","importance":4.08},{"id":"4.A.1.a.2","importance":3.9},{"id":"4.A.4.b.1","importance":3.77},{"id":"4.A.2.b.6","importance":3.72},{"id":"4.A.4.a.2","importance":3.67},{"id":"4.A.2.a.1","importance":3.64},{"id":"4.A.3.a.4","importance":3.61},{"id":"4.A.4.b.2","importance":3.49},{"id":"4.A.2.b.3","importance":3.38},{"id":"4.A.2.a.2","importance":3.37},{"id":"4.A.1.b.3","importance":3.36},{"id":"4.A.3.b.4","importance":3.32},{"id":"4.A.4.b.4","importance":3.31},{"id":"4.A.2