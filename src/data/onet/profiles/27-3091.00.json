{"code":"27-3091.00","title":"Interpreters and Translators","description":"Interpret oral or sign language, or translate written text from one language into another.","jobZone":4,"kinds":{"R":{"score":1.89,"share":0.0658},"I":{"score":3.19,"share":0.1619},"A":{"score":4.28,"share":0.2424},"S":{"score":3.48,"share":0.1833},"E":{"score":1.9,"share":0.0665},"C":{"score":4.79,"share":0.2801}},"highPoints":["C","A","S"],"tasks":[{"id":9326,"text":"Follow ethical codes that protect the confidentiality of information.","core":true,"importance":4.86,"relevance":97.61,"frequency":5.95},{"id":9328,"text":"Translate messages simultaneously or consecutively into specified languages, orally or by using hand signs, maintaining message content, context, and style as much as possible.","core":true,"importance":4.73,"relevance":90.27,"frequency":5.9},{"id":9335,"text":"Listen to speakers' statements to determine meanings and to prepare translations, using electronic listening systems as necessary.","core":true,"importance":4.48,"relevance":82.58,"frequency":5.26},{"id":9333,"text":"Compile terminology and information to be used in translations, including technical terms such as those for legal or medical material.","core":true,"importance":4.45,"relevance":90.04,"frequency":4.49},{"id":9334,"text":"Adapt translations to students' cognitive and grade levels, collaborating with educational team members as necessary.","core":false,"importance":4.42,"relevance":53.23,"frequency":4.77},{"id":9332,"text":"Refer to reference materials, such as dictionaries, lexicons, encyclopedias, and computerized terminology banks, as needed to ensure translation accuracy.","core":true,"importance":4.41,"relevance":98.09,"frequency":4.74},{"id":9330,"text":"Check translations of technical terms and terminology to ensure that they are accurate and remain consistent throughout translation revisions.","core":true,"importance":4.35,"relevance":81.68,"frequency":4.56},{"id":9327,"text":"Identify and resolve c