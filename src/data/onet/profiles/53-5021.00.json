{"code":"53-5021.00","title":"Captains, Mates, and Pilots of Water Vessels","description":"Command or supervise operations of ships and water vessels, such as tugboats and ferryboats. Required to hold license issued by U.S. Coast Guard.","jobZone":3,"kinds":{"R":{"score":5.61,"share":0.3314},"I":{"score":2.64,"share":0.1179},"A":{"score":1,"share":0},"S":{"score":1.88,"share":0.0633},"E":{"score":4.22,"share":0.2315},"C":{"score":4.56,"share":0.2559}},"highPoints":["R","C","E"],"tasks":[{"id":23802,"text":"Direct courses and speeds of ships, based on specialized knowledge of local winds, weather, water depths, tides, currents, and hazards.","core":true,"importance":5,"relevance":97.9,"frequency":6.43},{"id":23803,"text":"Prevent ships under navigational control from engaging in unsafe operations.","core":true,"importance":4.9,"relevance":94.73,"frequency":6.11},{"id":23804,"text":"Serve as a vessel's docking master upon arrival at a port or at a berth.","core":true,"importance":4.87,"relevance":97.06,"frequency":4.73},{"id":23805,"text":"Consult maps, charts, weather reports, or navigation equipment to determine and direct ship movements.","core":true,"importance":4.83,"relevance":100,"frequency":6.09},{"id":23806,"text":"Steer and operate vessels, using radios, depth finders, radars, lights, buoys, or lighthouses.","core":true,"importance":4.75,"relevance":99.75,"frequency":6.14},{"id":23807,"text":"Operate ship-to-shore radios to exchange information needed for ship operations.","core":true,"importance":4.72,"relevance":94.69,"frequency":6.39},{"id":23808,"text":"Dock or undock vessels, sometimes maneuvering through narrow spaces, such as locks.","core":true,"importance":4.7,"relevance":97.9,"frequency":5.2},{"id":23809,"text":"Stand watches on vessels during specified periods while vessels are under way.","core":true,"importance":4.64,"relevance":97.33,"frequency":5.71},{"id":23810,"text":"Inspect vessels to ensure efficient and safe operation of vessels and equipment and conformance to regulations.","core":true,"importance":4.58,"relevance":98.72,"frequency":5.21},{"id":23811,"text":"Read gauges to verify sufficient levels of hydraulic fluid, air pressure, or oxygen.","core":true,"importance":4.57,"relevance":77.15,"frequency":6.07},{"id":23827,"text":"Tow and maneuver barges or signal tugboats to tow barges to destinations.","core":false,"importance":4.52,"relevance":58.03,"frequency":5.46},{"id":23812,"text":"Report to appropriate authorities any violations of federal or state pilotage laws.","core":true,"importance":4.49,"relevance":93.14,"frequency":1.68},{"id":23813,"text":"Provide assistance in maritime rescue operations.","core":true,"importance":4.45,"relevance":93.87,"frequency":1.34},{"id":23814,"text":"Signal passing vessels, using whistles, flashing lights, flags, or radios.","core":true,"importance":4.39,"relevance":84.11,"frequency":5.49},{"id":23815,"text":"Measure depths of water, using depth-measuring equipment.","core":true,"importance":4.38,"relevance":89.49,"frequency":5.85},{"id":23816,"text":"Maintain boats or equipment on board, such as engines, winches, navigational systems, fire extinguishers, or life preservers.","core":true,"importance":4.34,"relevance":98.79,"frequency":4.79},{"id":23817,"text":"Signal crew members or deckhands to rig tow lines, open or close gates or ramps, or pull guard chains across entries.","core":true,"importance":4.34,"relevance":74.08,"frequency":5.46},{"id":23828,"text":"Perform various marine duties, such as checking for oil spills or other pollutants around ports or harbors or patrolling beaches.","core":false,"importance":4.27,"relevance":61.59,"frequency":5.54},{"id":23818,"text":"Advise ships' masters on harbor rules and customs procedures.","core":true,"importance":4.25,"relevance":78.46,"frequency":5.36},{"id":23819,"text":"Maintain records of daily activities, personnel reports, ship positions and movements, ports of call, weather and sea conditions, pollution control efforts, or cargo or passenger status.","core":true,"importance":4.25,"relevance":94.78,"frequency":5.57},{"id":23820,"text":"Observe loading or unloading of cargo or equipment to ensure that handling and storage are performed according to specifications.","core":true,"importance":4.24,"relevance":70.41,"frequency":4.43},{"id":23821,"text":"Calculate sightings of land, using electronic sounding devices and following contour lines on charts.","core":true,"importance":4.21,"relevance":75.99,"frequency":5.24},{"id":23822,"text":"Learn to operate new technology systems and procedures through instruction, simulators, or models.","core":true,"importance":4.17,"relevance":97.81,"frequency":2.07},{"id":23823,"text":"Direct or coordinate crew members or workers performing activities such as loading or unloading cargo, steering vessels, operating engines, or operating, maintaining, or repairing ship equipment.","core":true,"importance":4.1,"relevance":78.61,"frequency":4.96},{"id":23824,"text":"Arrange for ships to be fueled, restocked with supplies, or repaired.","core":true,"importance":4.09,"relevance":85.8,"frequency":4.12},{"id":23829,"text":"Assign watches or living quarters to crew members.","core":false,"importance":3.54,"relevance":63.62,"frequency":3.48},{"id":23825,"text":"Supervise crews in cleaning or maintaining decks, superstructures, or bridges.","core":true,"importance":3.53,"relevance":90.49,"frequency":4.95},{"id":23826,"text":"Purchase supplies or equipment.","core":true,"importance":3.51,"relevance":74.35,"frequency":3.54},{"id":23830,"text":"Interview and hire crew members.","core":false,"importance":3.2,"relevance":30.23,"frequency":1.84},{"id":23831,"text":"Conduct safety drills such as man overboard or fire drills.","core":true,"importance":null,"relevance":null,"frequency":null}],"activities":[{"id":"4.A.3.a.4","importance":4.55},{"id":"4.A.1.b.2","importance":4.4},{"id":"4.A.1.b.1","importance":4.24},{"id":"4.A.2.b.1","importance":4.2},{"id":