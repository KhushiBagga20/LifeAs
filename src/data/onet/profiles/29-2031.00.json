{"code":"29-2031.00","title":"Cardiovascular Technologists and Technicians","description":"Conduct tests on pulmonary or cardiovascular systems of patients for diagnostic, therapeutic, or research purposes. May conduct or assist in electrocardiograms, cardiac catheterizations, pulmonary functions, lung capacity, and similar tests.","jobZone":3,"kinds":{"R":{"score":5.61,"share":0.2851},"I":{"score":5.31,"share":0.2665},"A":{"score":1,"share":0},"S":{"score":4.25,"share":0.201},"E":{"score":1.3,"share":0.0186},"C":{"score":4.7,"share":0.2288}},"highPoints":["R","I","C"],"tasks":[{"id":4132,"text":"Conduct electrocardiogram (EKG), phonocardiogram, echocardiogram, stress testing, or other cardiovascular tests to record patients' cardiac activity, using specialized electronic test equipment, recording devices, or laboratory instruments.","core":true,"importance":4.83,"relevance":88.32,"frequency":6.5},{"id":4144,"text":"Compare measurements of heart wall thickness and chamber sizes to standard norms to identify abnormalities.","core":false,"importance":4.72,"relevance":56.67,"frequency":6.28},{"id":4129,"text":"Explain testing procedures to patients to obtain cooperation and reduce anxiety.","core":true,"importance":4.71,"relevance":93.6,"frequency":6.48},{"id":15235,"text":"Maintain a proper sterile field during surgical procedures.","core":false,"importance":4.71,"relevance":38.67,"frequency":5.14},{"id":4142,"text":"Observe ultrasound display screen and listen to signals to record vascular information, such as blood pressure, limb volume changes, oxygen saturation, or cerebral circulation.","core":false,"importance":4.69,"relevance":51.76,"frequency":6.47},{"id":4127,"text":"Monitor patients' blood pressure and heart rate using electrocardiogram (EKG) equipment during diagnostic or therapeutic procedures to notify the physician if something appears wrong.","core":true,"importance":4.66,"relevance":76.42,"frequency":6.22},{"id":15236,"text":"Assist physicians in the d