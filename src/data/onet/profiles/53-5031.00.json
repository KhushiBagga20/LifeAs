{"code":"53-5031.00","title":"Ship Engineers","description":"Supervise and coordinate activities of crew engaged in operating and maintaining engines, boilers, deck machinery, and electrical, sanitary, and refrigeration equipment aboard ship.","jobZone":3,"kinds":{"R":{"score":6.44,"share":0.3537},"I":{"score":3.54,"share":0.1651},"A":{"score":1,"share":0},"S":{"score":1.76,"share":0.0494},"E":{"score":3.73,"share":0.1775},"C":{"score":4.91,"share":0.2542}},"highPoints":["R","C","E"],"tasks":[{"id":14553,"text":"Monitor engine, machinery, or equipment indicators when vessels are underway, and report abnormalities to appropriate shipboard staff.","core":true,"importance":4.82,"relevance":98.72,"frequency":5.44},{"id":14552,"text":"Monitor the availability, use, or condition of lifesaving equipment or pollution preventatives to ensure that international regulations are followed.","core":true,"importance":4.78,"relevance":94.48,"frequency":4.58},{"id":14559,"text":"Monitor and test operations of engines or other equipment so that malfunctions and their causes can be identified.","core":true,"importance":4.73,"relevance":98.98,"frequency":4.91},{"id":14558,"text":"Start engines to propel ships, and regulate engines and power transmissions to control speeds of ships, according to directions from captains or bridge computers.","core":true,"importance":4.68,"relevance":94.43,"frequency":5.35},{"id":14556,"text":"Perform or participate in emergency drills, as required.","core":true,"importance":4.56,"relevance":98.72,"frequency":3.09},{"id":14561,"text":"Perform general marine vessel maintenance or repair work, such as repairing leaks, finishing interiors, refueling, or maintaining decks.","core":true,"importance":4.55,"relevance":97.8,"frequency":5.01},{"id":14560,"text":"Maintain or repair engines, electric motors, pumps, winches, or other mechanical or electrical equipment, or assist other crew members with maintenance or repair duties.","core":true,"importance":4.5,"rel