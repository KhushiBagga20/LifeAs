{"code":"19-1031.02","title":"Range Managers","description":"Research or study range land management practices to provide sustained production of forage, livestock, and wildlife.","jobZone":4,"kinds":{"R":{"score":5.76,"share":0.2843},"I":{"score":5.02,"share":0.2401},"A":{"score":1.47,"share":0.0281},"S":{"score":2.42,"share":0.0848},"E":{"score":4.39,"share":0.2025},"C":{"score":3.68,"share":0.1601}},"highPoints":["R","I","E"],"tasks":[{"id":7504,"text":"Tailor conservation plans to landowners' goals, such as livestock support, wildlife, or recreation.","core":true,"importance":4.35,"relevance":95.83,"frequency":2.78},{"id":7506,"text":"Study grazing patterns to determine number and kind of livestock that can be most profitably grazed and to determine the best grazing seasons.","core":true,"importance":4.3,"relevance":95.83,"frequency":2.65},{"id":7498,"text":"Maintain soil stability and vegetation for non-grazing uses, such as wildlife habitats and outdoor recreation.","core":true,"importance":4.24,"relevance":87.5,"frequency":2.76},{"id":7500,"text":"Manage forage resources through fire, herbicide use, or revegetation to maintain a sustainable yield from the land.","core":true,"importance":4.23,"relevance":91.67,"frequency":2.82},{"id":7499,"text":"Mediate agreements among rangeland users and preservationists as to appropriate land use and management.","core":true,"importance":4.2,"relevance":83.33,"frequency":2.7},{"id":7501,"text":"Study rangeland management practices and research range problems to provide sustained production of forage, livestock, and wildlife.","core":true,"importance":4.17,"relevance":100,"frequency":2.96},{"id":7502,"text":"Offer advice to rangeland users on water management, forage production methods, and control of brush.","core":true,"importance":4.13,"relevance":95.83,"frequency":3.04},{"id":21170,"text":"Coordinate with federal land managers and other agencies and organizations to manage and protect rangelands.","core":true,"importanc