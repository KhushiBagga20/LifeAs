{"code":"17-3026.01","title":"Nanotechnology Engineering Technologists and Technicians","description":"Implement production processes and operate commercial-scale production equipment to produce, test, or modify materials, devices, or systems of unique molecular or macromolecular composition. Operate advanced microscopy equipment to manipulate nanoscale objects. Work under the supervision of nanoengineering staff.","jobZone":4,"kinds":{"R":{"score":6.16,"share":0.3539},"I":{"score":4.98,"share":0.273},"A":{"score":1.55,"share":0.0377},"S":{"score":1.05,"share":0.0034},"E":{"score":2.01,"share":0.0693},"C":{"score":4.83,"share":0.2627}},"highPoints":["R","I","C"],"tasks":[{"id":22047,"text":"Produce images or measurements, using tools or techniques such as atomic force microscopy, scanning electron microscopy, optical microscopy, particle size analysis, or zeta potential analysis.","core":true,"importance":4.42,"relevance":95,"frequency":4.16},{"id":22063,"text":"Maintain accurate record or batch-record documentation of nanoproduction.","core":true,"importance":4.36,"relevance":70,"frequency":4.14},{"id":22053,"text":"Calibrate nanotechnology equipment, such as weighing, testing, or production equipment.","core":true,"importance":4.28,"relevance":90,"frequency":3.11},{"id":22046,"text":"Maintain work area according to cleanroom or other processing standards.","core":true,"importance":4.22,"relevance":90,"frequency":4.83},{"id":22049,"text":"Repair nanotechnology processing or testing equipment or submit work orders for equipment repair.","core":true,"importance":4.1,"relevance":100,"frequency":2.55},{"id":22048,"text":"Collaborate with scientists or engineers to design or conduct experiments for the development of nanotechnology materials, components, devices, or systems.","core":true,"importance":4.06,"relevance":95,"frequency":3.84},{"id":22068,"text":"Assist nanoscientists or engineers in processing or characterizing materials according to physical or chemical pro