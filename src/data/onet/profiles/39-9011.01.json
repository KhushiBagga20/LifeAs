{"code":"39-9011.01","title":"Nannies","description":"Care for children in private households and provide support and expertise to parents in satisfying children's physical, emotional, intellectual, and social needs. Duties may include meal planning and preparation, laundry and clothing care, organization of play activities and outings, discipline, intellectual stimulation, language activities, and transportation.","jobZone":2,"kinds":{"R":{"score":2.91,"share":0.128},"I":{"score":2.19,"share":0.0798},"A":{"score":3.5,"share":0.1676},"S":{"score":6.3,"share":0.3552},"E":{"score":2.68,"share":0.1126},"C":{"score":3.34,"share":0.1568}},"highPoints":["S"],"tasks":[{"id":2355,"text":"Instruct children in safe behavior, such as seeking adult assistance when crossing the street and avoiding contact with unsafe objects.","core":true,"importance":4.92,"relevance":100,"frequency":5.64},{"id":2351,"text":"Perform first aid or cardiopulmonary resuscitation (CPR) when required.","core":true,"importance":4.88,"relevance":96,"frequency":2},{"id":2368,"text":"Remove hazards and develop appropriate boundaries and rules to create a safe environment for children.","core":true,"importance":4.88,"relevance":100,"frequency":5.72},{"id":2365,"text":"Instruct and assist children in the development of health and personal habits, such as eating, resting, and toilet behavior.","core":true,"importance":4.84,"relevance":100,"frequency":6.2},{"id":2352,"text":"Regulate children's rest periods and nap schedules.","core":true,"importance":4.83,"relevance":96,"frequency":5.46},{"id":2367,"text":"Teach and perform age-appropriate activities, such as lap play, reading, and arts and crafts, to encourage intellectual development of children.","core":true,"importance":4.76,"relevance":100,"frequency":5.96},{"id":2354,"text":"Help prepare and serve nutritionally balanced meals and snacks for children.","core":true,"importance":4.72,"relevance":100,"frequency":5.88},{"id":2358,"text":"Model appropriate s