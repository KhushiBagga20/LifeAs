vance":95.24,"frequency":4.49},{"id":1451,"text":"Position instructions and comments onto drawings.","core":true,"importance":3.93,"relevance":100,"frequency":4.57},{"id":1448,"text":"Coordinate with and consult other workers to design, lay out, or detail components and systems and to resolve design or other problems.","core":true,"importance":3.92,"relevance":99.13,"frequency":4.08},{"id":1450,"text":"Compute mathematical formulas to develop and design detailed specifications for components or machinery, using computer-assisted equipment.","core":true,"importance":3.69,"relevance":78.36,"frequency":3.92},{"id":1456,"text":"Confer with customer representatives to review schematics and answer questions pertaining to installation of systems.","core":true,"importance":3.55,"relevance":90.13,"frequency":2.81},{"id":1458,"text":"Supervise and train other drafters, technologists, and technicians.","core":true,"importance":3.25,"relevance":86.82,"frequency":2.6},{"id":1459,"text":"Lay out, draw, and reproduce illustrations for reference manuals and technical publications to describe operation and maintenance of mechanical systems.","core":false,"importance":2.87,"relevance":62.57,"frequency":2.68},{"id":1460,"text":"Shade or color drawings to clarify and emphasize details and dimensions or eliminate background, using ink, crayon, airbrush, and overlays.","core":false,"importance":2.76,"relevance":49.73,"frequency":3.06},{"id":1457,"text":"Draw freehand sketches of designs, trace finished drawings onto designated paper for the reproduction of blueprints, and reproduce working drawings on copy machines.","core":false,"importance":2.54,"relevance":33.72,"frequency":2.6}],"activities":[{"id":"4.A.3.b.1","importance":4.82},{"id":"4.A.3.b.2","importance":4.29},{"id":"4.A.1.a.1","importance":4.1},{"id":"4.A.2.b.2","importance":3.84},{"id":"4.A.2.b.3","importance":3.77},{"id":"4.A.2.a.3","importance":3.71},{"id":"4.A.2.a.2","importance":3.66},{"id":"4.A.2.b.1","importance":3.65},{