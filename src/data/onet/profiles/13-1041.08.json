{"code":"13-1041.08","title":"Customs Brokers","description":"Prepare customs documentation and ensure that shipments meet all applicable laws to facilitate the import and export of goods. Determine and track duties and taxes payable and process payments on behalf of client. Sign documents under a power of attorney. Represent clients in meetings with customs officials and apply for duty refunds and tariff reclassifications. Coordinate transportation and storage of imported goods.","jobZone":3,"kinds":{"R":{"score":2.37,"share":0.1121},"I":{"score":1.53,"share":0.0434},"A":{"score":1,"share":0},"S":{"score":2.17,"share":0.0957},"E":{"score":5.02,"share":0.329},"C":{"score":6.13,"share":0.4198}},"highPoints":["C","E"],"tasks":[{"id":15936,"text":"Pay, or arrange for payment of, taxes and duties on shipments.","core":true,"importance":4.94,"relevance":90,"frequency":5.11},{"id":15941,"text":"Classify goods according to tariff coding system.","core":true,"importance":4.8,"relevance":100,"frequency":5.95},{"id":15946,"text":"Clear goods through customs and to their destinations for clients.","core":true,"importance":4.78,"relevance":90,"frequency":6.56},{"id":15945,"text":"Prepare and process import and export documentation according to customs regulations, laws, or procedures.","core":true,"importance":4.75,"relevance":100,"frequency":5.85},{"id":15933,"text":"Stay abreast of changes in import or export laws or regulations by reading current literature, attending meetings or conferences, or conferring with colleagues.","core":true,"importance":4.6,"relevance":100,"frequency":4.8},{"id":15942,"text":"Calculate duty and tariff payments owed on shipments.","core":true,"importance":4.58,"relevance":95,"frequency":6.26},{"id":15940,"text":"Confer with officials in various agencies to facilitate clearance of goods through customs and quarantine.","core":true,"importance":4.55,"relevance":100,"frequency":4.8},{"id":15928,"text":"Obtain line releases for frequent shippers of lo