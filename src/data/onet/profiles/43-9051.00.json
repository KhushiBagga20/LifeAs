{"code":"43-9051.00","title":"Mail Clerks and Mail Machine Operators, Except Postal Service","description":"Prepare incoming and outgoing mail for distribution. Time-stamp, open, read, sort, and route incoming mail; and address, seal, stamp, fold, stuff, and affix postage to outgoing mail or packages. Duties may also include keeping necessary records and completed forms.","jobZone":2,"kinds":{"R":{"score":4.01,"share":0.2834},"I":{"score":1,"share":0},"A":{"score":1,"share":0},"S":{"score":2.01,"share":0.0951},"E":{"score":2.14,"share":0.1073},"C":{"score":6.46,"share":0.5141}},"highPoints":["C","R"],"tasks":[{"id":13267,"text":"Lift and unload containers of mail or parcels onto equipment for transportation to sortation stations.","core":true,"importance":4.56,"relevance":74.05,"frequency":5.59},{"id":13261,"text":"Verify that items are addressed correctly, marked with the proper postage, and in suitable condition for processing.","core":true,"importance":4.51,"relevance":90.56,"frequency":5.78},{"id":13273,"text":"Read production orders to determine types and sizes of items scheduled for printing and mailing.","core":false,"importance":4.5,"relevance":51.28,"frequency":null},{"id":13263,"text":"Clear jams in sortation equipment.","core":true,"importance":4.47,"relevance":80.91,"frequency":4.41},{"id":13262,"text":"Place incoming or outgoing letters or packages into sacks or bins based on destination or type, and place identifying tags on sacks or bins.","core":true,"importance":4.4,"relevance":82.03,"frequency":5.52},{"id":13283,"text":"Release packages or letters to customers upon presentation of written notices or other identification.","core":true,"importance":4.36,"relevance":70.37,"frequency":4.36},{"id":13276,"text":"Remove containers of sorted mail or parcels and transfer them to designated areas according to established procedures.","core":true,"importance":4.3,"relevance":83.05,"frequency":4.9},{"id":13281,"text":"Adjust guides, rollers, loose card inserters, weighing machines, and tying arms, using rules and hand tools.","core":false,"importance":4.29,"relevance":52.91,"frequency":null},{"id":13266,"text":"Determine manner in which mail is to be sent, and prepare it for delivery to mailing facilities.","core":true,"importance":4.26,"relevance":95.33,"frequency":5.41},{"id":13272,"text":"Start machines that automatically feed plates, stencils, or tapes through mechanisms, and observe machine operations to detect any malfunctions.","core":false,"importance":4.26,"relevance":53.87,"frequency":null},{"id":13264,"text":"Sort and route incoming mail, and collect outgoing mail, using carts as necessary.","core":true,"importance":4.2,"relevance":98.32,"frequency":5.56},{"id":13265,"text":"Weigh packages or letters to determine postage needed, using weighing scales and rate charts.","core":true,"importance":4.19,"relevance":93.29,"frequency":5.69},{"id":13269,"text":"Fold letters or circulars and insert them in envelopes.","core":true,"importance":4.19,"relevance":68.73,"frequency":null},{"id":13279,"text":"Stamp dates and times of receipt of incoming mail.","core":false,"importance":4.11,"relevance":57.79,"frequency":5},{"id":13270,"text":"Remove from machines printed materials, such as labeled articles, postmarked envelopes or tape, and folded sheets.","core":false,"importance":4.08,"relevance":66.6,"frequency":5.3},{"id":13259,"text":"Seal or open envelopes, by hand or by using machines.","core":true,"importance":4.07,"relevance":90.16,"frequency":5.63},{"id":13280,"text":"Operate computer-controlled keyboards or voice recognition equipment to direct items according to established routing schemes.","core":false,"importance":4.04,"relevance":46.57,"frequency":null},{"id":13282,"text":"Accept and check containers of mail or parcels from large volume mailers, couriers, and contractors.","core":true,"importance":3.96,"relevance":71.09,"frequency":4.92},{"id":13271,"text":"Add ink, fill paste reservoirs, and change machine ribbons when necessary.","core":true,"importance":3.92,"relevance":82.82,"frequency":3.11},{"id":13260,"text":"Affix postage to packages or letters by hand, or stamp materials, using postage meters.","core":true,"importance":3.9,"relevance":93.87,"frequency":5.31},{"id":13284,"text":"Answer inquiries regarding shipping or mailing policies.","core":true,"importance":3.88,"relevance":94.41,"frequency":4.92},{"id":13277,"text":"Contact delivery or courier services to arrange delivery of letters and parcels.","core":true,"importance":3.77,"relevance":72.79,"frequency":4.15},{"id":13275,"text":"Inspect mail machine output for defects and determine how to eliminate causes of any defects.","core":true,"importance":3.64,"relevance":70.21,"frequency":4.4},{"id":13268,"text":"Wrap packages or bundles by hand, or by using tying machines.","core":false,"importance":3.55,"relevance":65.4,"frequency":4.77},{"id":13286,"text":"Sell mail products, and accept payment for products and mailing charges.","core":false,"importance":3.53,"relevance":40.33,"frequency":null},{"id":13274,"text":"Mail merchandise samples or promotional literature in response to requests.","core":false,"importance":3.39,"relevance":64.44,"frequency":4.48},{"id":13278,"text":"Insert material for printing or addressing into loading racks on machines, select type or die sizes, and position plates, stencils, or tapes in machine magazines.","core":false,"importance":null,"relevance":36.18,"frequency":null},{"id":13285,"text":"Use equipment, such as forklifts and automated \"trains,\" to move containers of mail.","core":false,"importance":null,"relevance":25.68,"frequency":null},{"id":13287,"text":"Operate embossing machines or typewriters to make corrections, additions, and changes to address plates.","core":false,"importance":null,"relevance":40.66,"frequency":null}],"activities":[{"id":"4.A.3.a.1","importance":3.74},{"id":"4.A.3.a.2","importance":3.7},{"id":"4.A.4.a.2","importance":3.59},{"id":"4.A.1.a.1","importanc