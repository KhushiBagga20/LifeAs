{"code":"29-2057.00","title":"Ophthalmic Medical Technicians","description":"Assist ophthalmologists by performing ophthalmic clinical functions. May administer eye exams, administer eye medications, and instruct the patient in care and use of corrective lenses.","jobZone":3,"kinds":{"R":{"score":5.33,"share":0.2716},"I":{"score":4.81,"share":0.239},"A":{"score":1,"share":0},"S":{"score":4.64,"share":0.2284},"E":{"score":1.75,"share":0.0471},"C":{"score":4.41,"share":0.2139}},"highPoints":["R","I","S"],"tasks":[{"id":19252,"text":"Take and document patients' medical histories.","core":true,"importance":4.95,"relevance":100,"frequency":6.8},{"id":19250,"text":"Operate ophthalmic equipment, such as autorefractors, phoropters, tomographs, or retinoscopes.","core":true,"importance":4.91,"relevance":100,"frequency":6.67},{"id":19257,"text":"Conduct tonometry or tonography tests to measure intraocular pressure.","core":true,"importance":4.91,"relevance":100,"frequency":6.81},{"id":19249,"text":"Measure visual acuity, including near, distance, pinhole, or dynamic visual acuity, using appropriate tests.","core":true,"importance":4.9,"relevance":100,"frequency":6.81},{"id":19251,"text":"Take anatomical or functional ocular measurements of the eye or surrounding tissue, such as axial length measurements.","core":true,"importance":4.9,"relevance":100,"frequency":5.48},{"id":19248,"text":"Measure and record lens power, using lensometers.","core":true,"importance":4.86,"relevance":100,"frequency":6.71},{"id":19239,"text":"Administer topical ophthalmic or oral medications.","core":true,"importance":4.77,"relevance":100,"frequency":6.71},{"id":19245,"text":"Conduct visual field tests to measure field of vision.","core":true,"importance":4.73,"relevance":100,"frequency":5.33},{"id":19255,"text":"Assist physicians in performing ophthalmic procedures, including surgery.","core":true,"importance":4.71,"relevance":95.45,"frequency":4.15},{"id":19258,"text":"Measure corneal curvature wi