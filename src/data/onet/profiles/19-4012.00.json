{"code":"19-4012.00","title":"Agricultural Technicians","description":"Work with agricultural scientists in plant, fiber, and animal research, or assist with animal breeding and nutrition. Set up or maintain laboratory equipment and collect samples from crops or animals. Prepare specimens or record data to assist scientists in biology or related life science experiments. Conduct tests and experiments to improve yield and quality of crops or to increase the resistance of plants and animals to disease or insects.","jobZone":3,"kinds":{"R":{"score":6.82,"share":0.4128},"I":{"score":4.57,"share":0.2532},"A":{"score":1,"share":0},"S":{"score":1.46,"share":0.0326},"E":{"score":1.99,"share":0.0702},"C":{"score":4.26,"share":0.2312}},"highPoints":["R","I","C"],"tasks":[{"id":20533,"text":"Prepare land for cultivated crops, orchards, or vineyards by plowing, discing, leveling, or contouring.","core":true,"importance":4.28,"relevance":67.25,"frequency":3.93},{"id":5541,"text":"Operate farm machinery, including tractors, plows, mowers, combines, balers, sprayers, earthmoving equipment, or trucks.","core":true,"importance":4.27,"relevance":79.9,"frequency":5.22},{"id":5528,"text":"Record data pertaining to experimentation, research, or animal care.","core":true,"importance":4.16,"relevance":83.26,"frequency":4.26},{"id":5544,"text":"Maintain or repair agricultural facilities, equipment, or tools to ensure operational readiness, safety, and cleanliness.","core":true,"importance":4,"relevance":82.24,"frequency":4.46},{"id":19781,"text":"Conduct studies of nitrogen or alternative fertilizer application methods, quantities, or timing to ensure satisfaction of crop needs and minimization of leaching, runoff, or denitrification.","core":false,"importance":3.94,"relevance":47.3,"frequency":2.98},{"id":20528,"text":"Prepare laboratory samples for analysis, following proper protocols to ensure that they will be stored, prepared, and disposed of efficiently and effectively.","core":false,"importance":3.92,"relevance":58.85,"frequency":3.26},{"id":20526,"text":"Measure or weigh ingredients used in laboratory testing.","core":false,"importance":3.87,"relevance":64.23,"frequency":3.41},{"id":5542,"text":"Perform crop production duties, such as tilling, hoeing, pruning, weeding, or harvesting crops.","core":true,"importance":3.86,"relevance":78.72,"frequency":4},{"id":20535,"text":"Perform tests on seeds to evaluate seed viability.","core":false,"importance":3.86,"relevance":41.02,"frequency":2.77},{"id":5530,"text":"Prepare data summaries, reports, or analyses that include results, charts, or graphs to document research findings and results.","core":false,"importance":3.85,"relevance":64.97,"frequency":3.1},{"id":20530,"text":"Collect animal or crop samples.","core":true,"importance":3.74,"relevance":89,"frequency":2.89},{"id":20534,"text":"Perform laboratory or field testing, using spectrometers, nitrogen determination apparatus, air samplers, centrifuges, or potential hydrogen (pH) meters to perform tests.","core":false,"importance":3.74,"relevance":47.64,"frequency":2.99},{"id":20529,"text":"Examine animals or crop specimens to determine the presence of diseases or other problems.","core":true,"importance":3.71,"relevance":71.68,"frequency":3.57},{"id":20531,"text":"Supervise pest or weed control operations, including locating and identifying pests or weeds, selecting chemicals and application methods, or scheduling application.","core":false,"importance":3.67,"relevance":56.32,"frequency":3.19},{"id":20527,"text":"Set up laboratory or field equipment as required for site testing.","core":true,"importance":3.62,"relevance":67.82,"frequency":3.15},{"id":5548,"text":"Supervise or train agricultural technicians or farm laborers.","core":true,"importance":3.6,"relevance":72.74,"frequency":3.11},{"id":5543,"text":"Devise cultural methods or environmental controls for plants for which guidelines are sketchy or nonexistent.","core":false,"importance":3.55