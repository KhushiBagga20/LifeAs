{"code":"29-2056.00","title":"Veterinary Technologists and Technicians","description":"Perform medical tests in a laboratory environment for use in the treatment and diagnosis of diseases in animals. Prepare vaccines and serums for prevention of diseases. Prepare tissue samples, take blood samples, and execute laboratory tests, such as urinalysis and blood counts. Clean and sterilize instruments and materials and maintain equipment and machines. May assist a veterinarian during surgery.","jobZone":3,"kinds":{"R":{"score":6.71,"share":0.3672},"I":{"score":5.26,"share":0.274},"A":{"score":1,"share":0},"S":{"score":3.02,"share":0.1299},"E":{"score":1,"share":0},"C":{"score":4.56,"share":0.2289}},"highPoints":["R","I","C"],"tasks":[{"id":4176,"text":"Administer anesthesia to animals, under the direction of a veterinarian, and monitor animals' responses to anesthetics so that dosages can be adjusted.","core":true,"importance":4.84,"relevance":92.03,"frequency":4.89},{"id":4177,"text":"Care for and monitor the condition of animals recovering from surgery.","core":true,"importance":4.76,"relevance":98.98,"frequency":5.12},{"id":18548,"text":"Maintain controlled drug inventory and related log books.","core":true,"importance":4.72,"relevance":96.54,"frequency":5.05},{"id":4179,"text":"Perform laboratory tests on blood, urine, or feces, such as urinalyses or blood counts, to assist in the diagnosis and treatment of animal health problems.","core":true,"importance":4.7,"relevance":99.46,"frequency":5.72},{"id":4178,"text":"Prepare and administer medications, vaccines, serums, or treatments, as prescribed by veterinarians.","core":true,"importance":4.68,"relevance":100,"frequency":6.19},{"id":20422,"text":"Restrain animals during exams or procedures.","core":true,"importance":4.66,"relevance":99.49,"frequency":6.54},{"id":4180,"text":"Administer emergency first aid, such as performing emergency resuscitation or other life saving procedures.","core":true,"importance":4.62,"relevance":91.08,"frequency":2.67},{"id":4182,"text":"Clean and sterilize instruments, equipment, or materials.","core":true,"importance":4.58,"relevance":99.45,"frequency":5.3},{"id":4183,"text":"Provide veterinarians with the correct equipment or instruments, as needed.","core":true,"importance":4.57,"relevance":98.98,"frequency":5.84},{"id":4193,"text":"Perform dental work, such as cleaning, polishing, or extracting teeth.","core":true,"importance":4.56,"relevance":92,"frequency":4.32},{"id":4187,"text":"Observe the behavior and condition of animals and monitor their clinical symptoms.","core":true,"importance":4.52,"relevance":98.93,"frequency":5.71},{"id":4184,"text":"Fill prescriptions, measuring medications and labeling containers.","core":true,"importance":4.46,"relevance":99.26,"frequency":5.84},{"id":4190,"text":"Give enemas and perform catheterizations, ear flushes, intravenous feedings, or gavages.","core":true,"importance":4.46,"relevance":98.51,"frequency":4.73},{"id":4181,"text":"Collect, prepare, and label samples for laboratory testing, culture, or microscopic examination.","core":true,"importance":4.45,"relevance":99.46,"frequency":5.63},{"id":4185,"text":"Prepare animals for surgery, performing such tasks as shaving surgical areas.","core":true,"importance":4.45,"relevance":100,"frequency":4.74},{"id":4188,"text":"Take and develop diagnostic radiographs, using x-ray equipment.","core":true,"importance":4.42,"relevance":98.13,"frequency":5.05},{"id":20423,"text":"Discuss medical health of pets with clients, such as post-operative status.","core":true,"importance":4.42,"relevance":98.56,"frequency":5.41},{"id":4194,"text":"Clean kennels, animal holding areas, surgery suites, examination rooms, or animal loading or unloading facilities to control the spread of disease.","core":true,"importance":4.41,"relevance":100,"frequency":5.93},{"id":4186,"text":"Take animals into treatment areas and assist with physical examinations by performing such duties as obtaining temperature, pulse, or respiration data.","core":true,"importance":4.39,"relevance":98.98,"frequency":5.9},{"id":4191,"text":"Prepare treatment rooms for surgery.","core":true,"importance":4.38,"relevance":97.4,"frequency":4.87},{"id":4189,"text":"Maintain laboratory, research, or treatment records, as well as inventories of pharmaceuticals, equipment, or supplies.","core":true,"importance":4.3,"relevance":96.06,"frequency":5.12},{"id":4192,"text":"Maintain instruments, equipment, or machinery to ensure proper working condition.","core":true,"importance":4.3,"relevance":97.02,"frequency":4.34},{"id":4197,"text":"Dress and suture wounds and apply splints or other protective devices.","core":true,"importance":4.22,"relevance":84.23,"frequency":3.61},{"id":4196,"text":"Provide assistance with animal euthanasia and the disposal of remains.","core":true,"importance":4.18,"relevance":100,"frequency":4.27},{"id":20424,"text":"Schedule appointments and procedures for animals.","core":true,"importance":4.12,"relevance":81.61,"frequency":5.15},{"id":4195,"text":"Provide information or counseling regarding issues such as animal health care, behavior problems, or nutrition.","core":true,"importance":4.07,"relevance":95.59,"frequency":4.7},{"id":18550,"text":"Monitor medical supplies and place orders when inventory is low.","core":true,"importance":4,"relevance":95.9,"frequency":4.33},{"id":18549,"text":"Supervise or train veterinary students or other staff members.","core":true,"importance":3.95,"relevance":94.05,"frequency":3.33},{"id":4198,"text":"Perform a variety of office, clerical, or accounting duties, such as reception, billing, bookkeeping, or selling products.","core":true,"importance":3.88,"relevance":85.46,"frequency":4.45},{"id":4199,"text":"Bathe animals, clip nails or claws, and brush or cut animals' hair.","core":true,"importance":3.61,"relevance":94.92,"frequency":5.01},{"id":4200,"text":"Conduct specialized procedures, such as animal branding or tattooin