{"code":"29-1213.00","title":"Dermatologists","description":"Diagnose and treat diseases relating to the skin, hair, and nails. May perform both medical and dermatological surgery functions.","jobZone":5,"kinds":{"R":{"score":4.81,"share":0.2193},"I":{"score":6.44,"share":0.3132},"A":{"score":1.87,"share":0.0501},"S":{"score":4.65,"share":0.2101},"E":{"score":1.77,"share":0.0443},"C":{"score":3.83,"share":0.1629}},"highPoints":["I","R","S"],"tasks":[{"id":17094,"text":"Conduct complete skin examinations.","core":true,"importance":4.9,"relevance":100,"frequency":6.57},{"id":17092,"text":"Diagnose and treat pigmented lesions such as common acquired nevi, congenital nevi, dysplastic nevi, Spitz nevi, blue nevi, or melanoma.","core":true,"importance":4.86,"relevance":100,"frequency":6.3},{"id":17091,"text":"Perform incisional biopsies to diagnose melanoma.","core":true,"importance":4.83,"relevance":98.79,"frequency":4.71},{"id":17090,"text":"Perform skin surgery to improve appearance, make early diagnoses, or control diseases such as skin cancer.","core":true,"importance":4.81,"relevance":100,"frequency":6.04},{"id":17093,"text":"Counsel patients on topics such as the need for annual dermatologic screenings, sun protection, skin cancer awareness, or skin and lymph node self-examinations.","core":true,"importance":4.76,"relevance":100,"frequency":6.45},{"id":17095,"text":"Diagnose and treat skin conditions such as acne, dandruff, athlete's foot, moles, psoriasis, or skin cancer.","core":true,"importance":4.73,"relevance":100,"frequency":6.34},{"id":17078,"text":"Record patients' health histories.","core":true,"importance":4.63,"relevance":100,"frequency":6.62},{"id":17085,"text":"Recommend diagnostic tests based on patients' histories and physical examination findings.","core":true,"importance":4.62,"relevance":100,"frequency":6.09},{"id":17084,"text":"Conduct or order diagnostic tests such as chest radiographs (x-rays), microbiologic tests, or endocrinologic tests.","co