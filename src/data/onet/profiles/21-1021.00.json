{"code":"21-1021.00","title":"Child, Family, and School Social Workers","description":"Provide social services and assistance to improve the social and psychological functioning of children and their families and to maximize the family well-being and the academic functioning of children. May assist parents, arrange adoptions, and find foster homes for abandoned or abused children. In schools, they address such problems as teenage pregnancy, misbehavior, and truancy. May also advise teachers.","jobZone":4,"kinds":{"R":{"score":1.7,"share":0.0458},"I":{"score":3.32,"share":0.1518},"A":{"score":2.9,"share":0.1243},"S":{"score":6.85,"share":0.3829},"E":{"score":2.94,"share":0.127},"C":{"score":3.57,"share":0.1682}},"highPoints":["S"],"tasks":[{"id":251,"text":"Place children in foster or adoptive homes, institutions, or medical treatment centers.","core":false,"importance":4.68,"relevance":46.36,"frequency":null},{"id":237,"text":"Maintain case history records and prepare reports.","core":true,"importance":4.57,"relevance":89.01,"frequency":5.19},{"id":253,"text":"Recommend temporary foster care and advise foster or adoptive parents.","core":false,"importance":4.53,"relevance":47.14,"frequency":2.78},{"id":235,"text":"Interview clients individually, in families, or in groups, assessing their situations, capabilities, and problems to determine what services are required to meet their needs.","core":true,"importance":4.48,"relevance":87.42,"frequency":4.31},{"id":238,"text":"Counsel students whose behavior, school progress, or mental or physical impairment indicate a need for assistance, diagnosing students' problems and arranging for needed services.","core":false,"importance":4.36,"relevance":64.02,"frequency":4.62},{"id":250,"text":"Serve as liaisons between students, homes, schools, family services, child guidance clinics, courts, protective services, doctors, and other contacts to help children who face problems, such as disabilities, abuse, or poverty.","core":true,"importance":4.36,"relevance":69.03,"frequency":4.42},{"id":241,"text":"Develop and review service plans in consultation with clients and perform follow-ups assessing the quantity and quality of services provided.","core":true,"importance":4.27,"relevance":83.26,"frequency":4.24},{"id":239,"text":"Consult with parents, teachers, and other school personnel to determine causes of problems, such as truancy and misbehavior, and to implement solutions.","core":true,"importance":4.22,"relevance":84.47,"frequency":4.42},{"id":240,"text":"Counsel parents with child rearing problems, interviewing the child and family to determine whether further action is required.","core":true,"importance":4.22,"relevance":69.46,"frequency":4.02},{"id":243,"text":"Address legal issues, such as child abuse and discipline, assisting with hearings and providing testimony to inform custody arrangements.","core":true,"importance":4.22,"relevance":74.22,"frequency":3.07},{"id":249,"text":"Evaluate personal characteristics and home conditions of foster home or adoption applicants.","core":false,"importance":4.22,"relevance":38.35,"frequency":null},{"id":246,"text":"Arrange for medical, psychiatric, and other tests that may disclose causes of difficulties and indicate remedial measures.","core":true,"importance":4.21,"relevance":74.28,"frequency":3.29},{"id":255,"text":"Conduct social research.","core":false,"importance":4.17,"relevance":28.87,"frequency":2.55},{"id":245,"text":"Refer clients to community resources for services, such as job placement, debt counseling, legal aid, housing, medical treatment, or financial assistance, and provide concrete information, such as where to go and how to apply.","core":true,"importance":4.01,"relevance":98.06,"frequency":4.09},{"id":236,"text":"Counsel individuals, groups, families, or communities regarding issues including mental health, poverty, unemployment, substance abuse, physical abuse, rehabilitation, social adjustment, child care, or medical care.","core":true,"importance":3.99,"relevance":81.91,"frequency":4.35},{"id":242,"text":"Collect supplementary information needed to assist client, such as employment records, medical records, or school reports.","core":true,"importance":3.99,"relevance":76.39,"frequency":3.88},{"id":244,"text":"Provide, find, or arrange for support services, such as child care, homemaker service, prenatal care, substance abuse treatment, job training, counseling, or parenting classes to prevent more serious problems from developing.","core":true,"importance":3.99,"relevance":89.36,"frequency":3.53},{"id":252,"text":"Supervise other social workers.","core":false,"importance":3.95,"relevance":34.38,"frequency":4.71},{"id":256,"text":"Lead group counseling sessions that provide support in such areas as grief, stress, or chemical dependency.","core":false,"importance":3.75,"relevance":48.69,"frequency":3.48},{"id":257,"text":"Serve on policy-making committees, assist in community development, and assist client groups by lobbying for solutions to problems.","core":false,"importance":3.72,"relevance":43.67,"frequency":2.74},{"id":254,"text":"Determine clients' eligibility for financial assistance.","core":false,"importance":3.41,"relevance":35.85,"frequency":2.89}],"activities":[{"id":"4.A.4.a.4","importance":4.71},{"id":"4.A.4.a.2","importance":4.7},{"id":"4.A.1.a.1","importance":4.58},{"id":"4.A.3.b.6","importance":4.58},{"id":"4.A.1.b.1","importance":4.5},{"id":"4.A.4.a.3","importance":4.48},{"id":"4.A.4.a.5","importance":4.42},{"id":"4.A.4.a.8","importance":4.42},{"id":"4.A.3.b.1","importance":4.41},{"id":"4.A.2.b.1","importance":4.4},{"id":"4.A.2.b.6","importance":4.21},{"id":"4.A.4.a.7","importance":4.18},{"id":"4.A.2.a.3","importance":4.14},{"id":"4.A.4.b.2","importance":4.07},{"id":"4.A.2.b.2","importance":4.04},{"id":"4.A.2.b.4","importance":4.04},{"id":"4.A.1.a.2","importance":3.98},{"id":"4.A.2.b.3","importance":3.94},{"id":"4.A.4.a.1","importance":3.92},{"id":"4.A.4.b.5","importan