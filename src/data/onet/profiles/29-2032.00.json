{"code":"29-2032.00","title":"Diagnostic Medical Sonographers","description":"Produce ultrasonic recordings of internal organs for use by physicians. Includes vascular technologists.","jobZone":3,"kinds":{"R":{"score":5.87,"share":0.2934},"I":{"score":4.75,"share":0.2259},"A":{"score":1.32,"share":0.0193},"S":{"score":4.1,"share":0.1867},"E":{"score":1.51,"share":0.0307},"C":{"score":5.05,"share":0.244}},"highPoints":["R","C","I"],"tasks":[{"id":438,"text":"Process and code film from procedures and complete appropriate documentation.","core":false,"importance":4.98,"relevance":65.61,"frequency":6.42},{"id":432,"text":"Observe screen during scan to ensure that image produced is satisfactory for diagnostic purposes, making adjustments to equipment as required.","core":true,"importance":4.94,"relevance":100,"frequency":6.89},{"id":431,"text":"Decide which images to include, looking for differences between healthy and pathological areas.","core":true,"importance":4.93,"relevance":99.95,"frequency":6.88},{"id":435,"text":"Operate ultrasound equipment to produce and record images of the motion, shape, and composition of blood, organs, tissues, or bodily masses, such as fluid accumulations.","core":true,"importance":4.93,"relevance":100,"frequency":6.84},{"id":433,"text":"Observe and care for patients throughout examinations to ensure their safety and comfort.","core":true,"importance":4.92,"relevance":100,"frequency":6.88},{"id":434,"text":"Provide sonogram and oral or written summary of technical findings to physician for use in medical diagnosis.","core":true,"importance":4.92,"relevance":100,"frequency":6.87},{"id":436,"text":"Select appropriate equipment settings and adjust patient positions to obtain the best sites and angles.","core":true,"importance":4.92,"relevance":100,"frequency":6.88},{"id":437,"text":"Determine whether scope of exam should be extended, based on findings.","core":true,"importance":4.85,"relevance":91.12,"frequency":5.51},{"id":439,"text":"Obtai