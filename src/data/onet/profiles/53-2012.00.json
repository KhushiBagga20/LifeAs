{"code":"53-2012.00","title":"Commercial Pilots","description":"Pilot and navigate the flight of fixed-wing aircraft on nonscheduled air carrier routes, or helicopters. Requires Commercial Pilot certificate. Includes charter pilots with similar certification, and air ambulance and air tour pilots. Excludes regional, national, and international airline pilots.","jobZone":3,"kinds":{"R":{"score":4.79,"share":0.2756},"I":{"score":2.55,"share":0.1127},"A":{"score":1.1,"share":0.0073},"S":{"score":2.57,"share":0.1142},"E":{"score":3.92,"share":0.2124},"C":{"score":4.82,"share":0.2778}},"highPoints":["C","R","E"],"tasks":[{"id":10587,"text":"Check aircraft prior to flights to ensure that the engines, controls, instruments, and other systems are functioning properly.","core":true,"importance":4.97,"relevance":100,"frequency":5.49},{"id":20831,"text":"Co-pilot aircraft or perform captain's duties, as required.","core":true,"importance":4.94,"relevance":69.36,"frequency":5.47},{"id":10591,"text":"Consider airport altitudes, outside temperatures, plane weights, and wind speeds and directions to calculate the speed needed to become airborne.","core":true,"importance":4.93,"relevance":99.56,"frequency":5.63},{"id":10595,"text":"Use instrumentation to pilot aircraft when visibility is poor.","core":true,"importance":4.9,"relevance":80.49,"frequency":3.32},{"id":10590,"text":"Monitor engine operation, fuel consumption, and functioning of aircraft systems during flights.","core":true,"importance":4.82,"relevance":99.8,"frequency":6.1},{"id":10592,"text":"Order changes in fuel supplies, loads, routes, or schedules to ensure safety of flights.","core":true,"importance":4.81,"relevance":100,"frequency":5.05},{"id":10588,"text":"Contact control towers for takeoff clearances, arrival instructions, and other information, using radio equipment.","core":true,"importance":4.76,"relevance":100,"frequency":5.53},{"id":10589,"text":"Start engines, operate controls, and pilot airplanes to tran