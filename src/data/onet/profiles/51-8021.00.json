{"code":"51-8021.00","title":"Stationary Engineers and Boiler Operators","description":"Operate or maintain stationary engines, boilers, or other mechanical equipment to provide utilities for buildings or industrial processes. Operate equipment such as steam engines, generators, motors, turbines, and steam boilers.","jobZone":3,"kinds":{"R":{"score":7,"share":0.5051},"I":{"score":3.16,"share":0.1818},"A":{"score":1,"share":0},"S":{"score":1.1,"share":0.0084},"E":{"score":1.22,"share":0.0185},"C":{"score":4.4,"share":0.2862}},"highPoints":["R","C","I"],"tasks":[{"id":10468,"text":"Operate or tend stationary engines, boilers, and auxiliary equipment, such as pumps, compressors, or air-conditioning equipment, to supply and maintain steam or heat for buildings, marine vessels, or pneumatic tools.","core":true,"importance":4.41,"relevance":97.65,"frequency":5.56},{"id":10471,"text":"Activate valves to maintain required amounts of water in boilers, to adjust supplies of combustion air, and to control the flow of fuel into burners.","core":true,"importance":4.4,"relevance":88.13,"frequency":5.04},{"id":10472,"text":"Monitor boiler water, chemical, and fuel levels, and make adjustments to maintain required levels.","core":true,"importance":4.37,"relevance":94.54,"frequency":5.52},{"id":10475,"text":"Analyze problems and take appropriate action to ensure continuous and reliable operation of equipment and systems.","core":true,"importance":4.32,"relevance":100,"frequency":4.8},{"id":10469,"text":"Observe and interpret readings on gauges, meters, and charts registering various aspects of boiler operation to ensure that boilers are operating properly.","core":true,"importance":4.3,"relevance":99.66,"frequency":5.32},{"id":10473,"text":"Fire coal furnaces by hand or with stokers and gas- or oil-fed boilers, using automatic gas feeds or oil pumps.","core":false,"importance":4.28,"relevance":47.56,"frequency":4.76},{"id":10476,"text":"Maintain daily logs of operation, maintenance,