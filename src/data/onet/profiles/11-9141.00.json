7233,"text":"Review rents to ensure that they are in line with rental markets.","core":true,"importance":3.8,"relevance":80,"frequency":2},{"id":7237,"text":"Confer regularly with community association members to ensure their needs are being met.","core":true,"importance":3.79,"relevance":76,"frequency":3},{"id":7235,"text":"Purchase building and maintenance supplies, equipment, or furniture.","core":true,"importance":3.74,"relevance":92,"frequency":3.39},{"id":7226,"text":"Maintain records of sales, rental or usage activity, special permits issued, maintenance and operating costs, or property availability.","core":true,"importance":3.72,"relevance":100,"frequency":3.2},{"id":7243,"text":"Contract with architectural firms to draw up detailed plans for new structures.","core":false,"importance":3.64,"relevance":60,"frequency":2.07},{"id":7227,"text":"Determine and certify the eligibility of prospective tenants, following government regulations.","core":false,"importance":3.4,"relevance":60,"frequency":2.2},{"id":7244,"text":"Negotiate with government leaders, businesses, special interest representatives, and utility companies to gain support for new projects and to eliminate potential obstacles.","core":false,"importance":3.36,"relevance":44,"frequency":1.64},{"id":7239,"text":"Confer with legal authorities to ensure that renting and advertising practices are not discriminatory and that properties comply with state and federal regulations.","core":true,"importance":3.35,"relevance":68,"frequency":1.76},{"id":7245,"text":"Analyze information on property values, taxes, zoning, population growth, and traffic volume and patterns to determine if properties should be acquired.","core":false,"importance":3.2,"relevance":40,"frequency":1.3}],"activities":[{"id":"4.A.2.b.1","importance":4.44},{"id":"4.A.4.a.2","importance":4.26},{"id":"4.A.2.b.6","importance":4.22},{"id":"4.A.3.b.1","importance":4.19},{"id":"4.A.1.a.1","importance":4.15},{"id":"4.A.4.a.4","importance":4.15},{