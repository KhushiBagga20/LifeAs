{"code":"31-2011.00","title":"Occupational Therapy Assistants","description":"Assist occupational therapists in providing occupational therapy treatments and procedures. May, in accordance with state laws, assist in development of treatment plans, carry out routine functions, direct activity programs, and document the progress of treatments. Generally requires formal training.","jobZone":3,"kinds":{"R":{"score":3.53,"share":0.1742},"I":{"score":3.48,"share":0.1708},"A":{"score":2.06,"share":0.073},"S":{"score":6.1,"share":0.3512},"E":{"score":1.14,"share":0.0096},"C":{"score":4.21,"share":0.2211}},"highPoints":["S","C","R"],"tasks":[{"id":4258,"text":"Instruct, or assist in instructing, patients and families in home programs, basic living skills, or the care and use of adaptive equipment.","core":true,"importance":4.81,"relevance":99.83,"frequency":5.79},{"id":4255,"text":"Maintain and promote a positive attitude toward clients and their treatment programs.","core":true,"importance":4.79,"relevance":100,"frequency":5.95},{"id":4261,"text":"Implement, or assist occupational therapists with implementing, treatment plans designed to help clients function independently.","core":true,"importance":4.77,"relevance":99.83,"frequency":5.44},{"id":4262,"text":"Report to supervisors, verbally or in writing, on patients' progress, attitudes, and behavior.","core":true,"importance":4.77,"relevance":100,"frequency":5.24},{"id":4256,"text":"Monitor patients' performance in therapy activities, providing encouragement.","core":true,"importance":4.76,"relevance":100,"frequency":6.01},{"id":4254,"text":"Observe and record patients' progress, attitudes, and behavior and maintain this information in client records.","core":true,"importance":4.73,"relevance":100,"frequency":5.87},{"id":4257,"text":"Select therapy activities to fit patients' needs and capabilities.","core":true,"importance":4.72,"relevance":100,"frequency":5.74},{"id":4260,"text":"Aid patients in dressing and grooming the