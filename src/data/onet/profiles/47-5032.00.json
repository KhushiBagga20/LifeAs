{"code":"47-5032.00","title":"Explosives Workers, Ordnance Handling Experts, and Blasters","description":"Place and detonate explosives to demolish structures or to loosen, remove, or displace earth, rock, or other materials. May perform specialized handling, storage, and accounting procedures.","jobZone":2,"kinds":{"R":{"score":6.9,"share":0.4456},"I":{"score":3.77,"share":0.2092},"A":{"score":1.25,"share":0.0189},"S":{"score":1.3,"share":0.0227},"E":{"score":1.83,"share":0.0627},"C":{"score":4.19,"share":0.2409}},"highPoints":["R","C","I"],"tasks":[{"id":9904,"text":"Examine blast areas to determine amounts and kinds of explosive charges needed and to ensure that safety laws are observed.","core":true,"importance":4.88,"relevance":100,"frequency":5.25},{"id":9905,"text":"Tie specified lengths of delaying fuses into patterns in order to time sequences of explosions.","core":true,"importance":4.69,"relevance":76.19,"frequency":4.81},{"id":9906,"text":"Place safety cones around blast areas to alert other workers of danger zones, and signal workers as necessary to ensure that they clear blast sites prior to explosions.","core":true,"importance":4.64,"relevance":95.65,"frequency":4.73},{"id":9907,"text":"Place explosive charges in holes or other spots; then detonate explosives to demolish structures or to loosen, remove, or displace earth, rock, or other materials.","core":true,"importance":4.61,"relevance":100,"frequency":5.09},{"id":9908,"text":"Insert, pack, and pour explosives, such as dynamite, ammonium nitrate, black powder, or slurries into blast holes; then shovel drill cuttings, admit water into boreholes, and tamp material to compact charges.","core":true,"importance":4.57,"relevance":95.45,"frequency":5.62},{"id":9909,"text":"Mark patterns, locations, and depths of charge holes for drilling, and issue drilling instructions.","core":true,"importance":4.5,"relevance":95.65,"frequency":4.77},{"id":9910,"text":"Compile and keep gun and explosives records in compliance with local and federal laws.","core":true,"importance":4.5,"relevance":86.96,"frequency":4.45},{"id":9911,"text":"Measure depths of drilled blast holes, using weighted tape measures.","core":true,"importance":4.48,"relevance":95.45,"frequency":5.57},{"id":9912,"text":"Connect electrical wire to primers, and cover charges or fill blast holes with clay, drill chips, sand, or other material.","core":true,"importance":4.46,"relevance":100,"frequency":5.13},{"id":9913,"text":"Lay primacord between rows of charged blast holes, and tie cord into main lines to form blast patterns.","core":true,"importance":4.44,"relevance":81.82,"frequency":3.5},{"id":9914,"text":"Assemble and position equipment, explosives, and blasting caps in holes at specified depths, or load perforating guns or torpedoes with explosives.","core":true,"importance":4.35,"relevance":95.83,"frequency":5.3},{"id":9915,"text":"Verify detonation of charges by observing control panels, or by listening for the sounds of blasts.","core":true,"importance":4.32,"relevance":91.67,"frequency":4.64},{"id":9916,"text":"Move and store inventories of explosives, loaded perforating guns, and other materials, according to established safety procedures.","core":true,"importance":4.29,"relevance":100,"frequency":4.21},{"id":9917,"text":"Light fuses, drop detonating devices into wells or boreholes, or activate firing devices with plungers, dials, or buttons, in order to set off single or multiple blasts.","core":true,"importance":4.22,"relevance":81.82,"frequency":4.61},{"id":9918,"text":"Drive trucks to transport explosives and blasting equipment to blasting sites.","core":true,"importance":4.12,"relevance":100,"frequency":4.62},{"id":9919,"text":"Cut specified lengths of primacord and attach primers to cord ends.","core":true,"importance":4,"relevance":81.82,"frequency":3.5},{"id":9920,"text":"Maintain inventory levels, ordering new supplies as necessary.","core":true,"importance":3.96,"relevance":95.83,"frequency":4.3},{"id":9923,"text":"Set up and operate short-wave radio or field telephone equipment to transmit and receive blast information.","core":false,"importance":3.83,"relevance":52.17,"frequency":4.5},{"id":9924,"text":"Insert waterproof sealers, bullets, and/or powder charges into guns, and screw gun ports back into place.","core":false,"importance":3.83,"relevance":26.09,"frequency":3.67},{"id":9925,"text":"Clean, gauge, and lubricate gun ports.","core":false,"importance":3.83,"relevance":26.09,"frequency":3.17},{"id":9922,"text":"Repair and service blasting, shooting, and automotive equipment, and electrical wiring and instruments, using hand tools.","core":true,"importance":3.72,"relevance":75,"frequency":3.44},{"id":9927,"text":"Lower perforating guns into wells, using hoists; then use measuring devices and instrument panels to position guns in correct positions for taking samples.","core":false,"importance":3.71,"relevance":30.43,"frequency":2.57},{"id":23490,"text":"Create and lay out designs for drill and blast patterns.","core":true,"importance":null,"relevance":null,"frequency":null},{"id":23491,"text":"Document geological formations encountered during work.","core":true,"importance":null,"relevance":null,"frequency":null},{"id":23492,"text":"Operate machines to flush earth cuttings or to blow dust from holes.","core":true,"importance":null,"relevance":null,"frequency":null},{"id":23493,"text":"Set up and operate equipment such as hoists, jackhammers, and drills, in order to bore charge holes.","core":true,"importance":null,"relevance":null,"frequency":null},{"id":23494,"text":"Signal crane operators to move equipment.","core":true,"importance":null,"relevance":null,"frequency":null}],"activities":[{"id":"4.A.2.b.1","importance":4.42},{"id":"4.A.1.a.1","importance":4.33},{"id":"4.A.2.a.3","importance":4.29},{"id":"4.A.3.b.6","importance":4.29},{"id":"4.A.3.a.1","importance":4.25},{"id":"4.A.1.b.2","importance":4.21},{"id":"4.A.3.a.2","importance":4.21},{"id"