{"code":"49-3022.00","title":"Automotive Glass Installers and Repairers","description":"Replace or repair broken windshields and window glass in motor vehicles.","jobZone":2,"kinds":{"R":{"score":7,"share":0.5655},"I":{"score":2.24,"share":0.1169},"A":{"score":1,"share":0},"S":{"score":1.28,"share":0.0264},"E":{"score":1.39,"share":0.0368},"C":{"score":3.7,"share":0.2545}},"highPoints":["R","C"],"tasks":[{"id":8325,"text":"Select appropriate tools, safety equipment, and parts, according to job requirements.","core":true,"importance":4.51,"relevance":100,"frequency":null},{"id":20645,"text":"Prime all scratches on pinchwelds with primer and allow to dry.","core":true,"importance":4.4,"relevance":93.17,"frequency":5.94},{"id":8318,"text":"Remove all dirt, foreign matter, and loose glass from damaged areas, apply primer along windshield or window edges, and allow primer to dry.","core":true,"importance":4.39,"relevance":100,"frequency":5.66},{"id":8323,"text":"Check for and remove moisture or contamination in damaged areas and keep areas dry until repairs are complete.","core":true,"importance":4.3,"relevance":96.68,"frequency":5.61},{"id":8324,"text":"Apply a bead of urethane around the perimeter of each pinchweld and dress the remaining urethane on the pinchwelds so that it is of uniform level and thickness.","core":true,"importance":4.28,"relevance":94.93,"frequency":null},{"id":8322,"text":"Obtain windshields or windows for specific automobile makes and models from stock and examine them for defects prior to installation.","core":true,"importance":4.25,"relevance":94.93,"frequency":5.65},{"id":8329,"text":"Install, repair, or replace safety glass and related materials, such as back glass heating elements, on vehicles or equipment.","core":true,"importance":4.21,"relevance":93.17,"frequency":null},{"id":8320,"text":"Allow all glass parts installed with urethane ample time to cure, taking temperature and humidity into account.","core":true,"importance":4.2,"relevance":91.9,"frequency":null},{"id":20646,"text":"Install replacement glass in vehicles.","core":true,"importance":4.2,"relevance":98.25,"frequency":5.53},{"id":8327,"text":"Replace all moldings, clips, windshield wipers, or other parts that were removed prior to glass replacement or repair.","core":true,"importance":4.08,"relevance":100,"frequency":5.32},{"id":8326,"text":"Remove broken or damaged glass windshields or window glass from motor vehicles, using hand tools to remove screws from frames holding glass.","core":true,"importance":4.07,"relevance":97.96,"frequency":5.47},{"id":8333,"text":"Replace or adjust motorized or manual window-raising mechanisms.","core":true,"importance":4.03,"relevance":94.48,"frequency":4.65},{"id":8328,"text":"Remove moldings, clips, windshield wipers, screws, bolts, and inside A-pillar moldings and lower headliners in preparation for installation or repair work.","core":true,"importance":3.88,"relevance":100,"frequency":5.1},{"id":8332,"text":"Cut flat safety glass according to specified patterns or perform precision pattern making and glass cutting to custom fit replacement windows.","core":false,"importance":3.82,"relevance":55.16,"frequency":3.11},{"id":8334,"text":"Install new foam dams on pinchwelds, if required.","core":true,"importance":3.76,"relevance":75.29,"frequency":4.67},{"id":8330,"text":"Install rubber channeling strips around edges of glass or frames to weatherproof windows or to prevent rattling.","core":true,"importance":3.43,"relevance":86.54,"frequency":4.87},{"id":8331,"text":"Hold cut or uneven edges of glass against automated abrasive belts to shape or smooth edges.","core":false,"importance":2.81,"relevance":null,"frequency":null},{"id":8335,"text":"Cool or warm glass in the event of temperature extremes.","core":false,"importance":2.59,"relevance":78.77,"frequency":null}],"activities":[{"id":"4.A.3.a.1","importance":4.22},{"id":"4.A.3.a.2","importance":4.09},{"id":"4.A.1.a.1","importance":3.43},{"id":"4.A.2.b.3