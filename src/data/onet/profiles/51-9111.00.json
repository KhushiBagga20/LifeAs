{"code":"51-9111.00","title":"Packaging and Filling Machine Operators and Tenders","description":"Operate or tend machines to prepare industrial or consumer products for storage or shipment. Includes cannery workers who pack food products.","jobZone":2,"kinds":{"R":{"score":6.63,"share":0.5227},"I":{"score":1.37,"share":0.0344},"A":{"score":1,"share":0},"S":{"score":1.02,"share":0.0019},"E":{"score":1.84,"share":0.078},"C":{"score":4.91,"share":0.363}},"highPoints":["R","C"],"tasks":[{"id":3142,"text":"Attach identification labels to finished packaged items, or cut stencils and stencil information on containers, such as lot numbers or shipping destinations.","core":true,"importance":4.53,"relevance":95.18,"frequency":5.85},{"id":3134,"text":"Sort, grade, weigh, and inspect products, verifying and adjusting product weight or measurement to meet specifications.","core":true,"importance":4.47,"relevance":87.06,"frequency":5.72},{"id":3129,"text":"Stop or reset machines when malfunctions occur, clear machine jams, and report malfunctions to a supervisor.","core":true,"importance":4.45,"relevance":89.8,"frequency":5.19},{"id":3124,"text":"Observe machine operations to ensure quality and conformity of filled or packaged products to standards.","core":true,"importance":4.44,"relevance":89.17,"frequency":5.74},{"id":3127,"text":"Remove finished packaged items from machine and separate rejected items.","core":true,"importance":4.42,"relevance":95.63,"frequency":5.27},{"id":3136,"text":"Monitor the production line, watching for problems such as pile-ups, jams, or glue that isn't sticking properly.","core":true,"importance":4.41,"relevance":79.53,"frequency":5.51},{"id":3132,"text":"Inspect and remove defective products and packaging material.","core":true,"importance":4.39,"relevance":94.69,"frequency":5.44},{"id":3126,"text":"Tend or operate machine that packages product.","core":true,"importance":4.38,"relevance":75.94,"frequency":5},{"id":3138,"text":"Start machine by enga