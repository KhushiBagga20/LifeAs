{"code":"11-9121.01","title":"Clinical Research Coordinators","description":"Plan, direct, or coordinate clinical research projects. Direct the activities of workers engaged in clinical research projects to ensure compliance with protocols and overall clinical objectives. May evaluate and analyze clinical data.","jobZone":4,"kinds":{"R":{"score":1.58,"share":0.0364},"I":{"score":5.9,"share":0.3074},"A":{"score":1.76,"share":0.0477},"S":{"score":3.58,"share":0.1619},"E":{"score":4.31,"share":0.2077},"C":{"score":4.81,"share":0.239}},"highPoints":["I","C","E"],"tasks":[{"id":15612,"text":"Schedule subjects for appointments, procedures, or inpatient stays as required by study protocols.","core":true,"importance":4.49,"relevance":84.74,"frequency":4.38},{"id":15587,"text":"Perform specific protocol procedures such as interviewing subjects, taking vital signs, and performing electrocardiograms.","core":true,"importance":4.42,"relevance":89.66,"frequency":4.39},{"id":15595,"text":"Prepare study-related documentation, such as protocol worksheets, procedural manuals, adverse event reports, institutional review board documents, or progress reports.","core":true,"importance":4.41,"relevance":82.57,"frequency":3.56},{"id":15610,"text":"Assess eligibility of potential subjects through methods such as screening interviews, reviews of medical records, or discussions with physicians and nurses.","core":true,"importance":4.41,"relevance":89.97,"frequency":4.61},{"id":15602,"text":"Inform patients or caregivers about study aspects and outcomes to be expected.","core":true,"importance":4.38,"relevance":89.97,"frequency":4.37},{"id":15594,"text":"Record adverse event and side effect data and confer with investigators regarding the reporting of events to oversight agencies.","core":true,"importance":4.35,"relevance":89.64,"frequency":3.21},{"id":15613,"text":"Monitor study activities to ensure compliance with protocols and with all relevant local, federal, and state regulatory and institutional polices.","core":true,"importance":4.34,"relevance":93.18,"frequency":4.19},{"id":15597,"text":"Oversee subject enrollment to ensure that informed consent is properly obtained and documented.","core":true,"importance":4.32,"relevance":95.61,"frequency":3.83},{"id":15614,"text":"Maintain required records of study activity including case report forms, drug dispensation records, or regulatory forms.","core":true,"importance":4.27,"relevance":86.6,"frequency":4.17},{"id":15604,"text":"Dispense medical devices or drugs, and calculate dosages and provide instructions as necessary.","core":false,"importance":4.26,"relevance":59.56,"frequency":3.98},{"id":15603,"text":"Identify protocol problems, inform investigators of problems, or assist in problem resolution efforts, such as protocol revisions.","core":true,"importance":4.25,"relevance":95.01,"frequency":3.31},{"id":15593,"text":"Review proposed study protocols to evaluate factors such as sample collection processes, data management plans, or potential subject risks.","core":true,"importance":4.22,"relevance":89.22,"frequency":3.16},{"id":15608,"text":"Collaborate with investigators to prepare presentations or reports of clinical study procedures, results, and conclusions.","core":true,"importance":4.11,"relevance":76.34,"frequency":3.17},{"id":15592,"text":"Track enrollment status of subjects and document dropout information such as dropout causes and subject contact efforts.","core":true,"importance":4.08,"relevance":83.81,"frequency":3.99},{"id":15609,"text":"Code, evaluate, or interpret collected study data.","core":true,"importance":4.07,"relevance":72.21,"frequency":3.76},{"id":15605,"text":"Direct the requisition, collection, labeling, storage, or shipment of specimens.","core":true,"importance":4.05,"relevance":72.85,"frequency":3.43},{"id":15601,"text":"Instruct research staff in scientific and procedural aspects of studies including standards of care, informed consent procedures, or documentation procedures.","core":true,"importance":4.01,"relevance":83.9,"frequency":3.42},{"id":15600,"text":"Maintain contact with sponsors to schedule and coordinate site visits or to answer questions about issues such as incomplete data.","core":true,"importance":3.96,"relevance":68.66,"frequency":3.28},{"id":15585,"text":"Prepare for or participate in quality assurance audits conducted by study sponsors, federal agencies, or specially designated review groups.","core":true,"importance":3.93,"relevance":68.98,"frequency":2.33},{"id":15598,"text":"Order drugs or devices necessary for study completion.","core":true,"importance":3.85,"relevance":70.47,"frequency":3.06},{"id":15611,"text":"Arrange for research study sites and determine staff or equipment availability.","core":false,"importance":3.83,"relevance":57.87,"frequency":3.13},{"id":15596,"text":"Participate in the development of study protocols including guidelines for administration or data collection procedures.","core":true,"importance":3.74,"relevance":79.1,"frequency":2.7},{"id":15606,"text":"Contact outside health care providers and communicate with subjects to obtain follow-up information.","core":true,"importance":3.74,"relevance":75.59,"frequency":3.68},{"id":15588,"text":"Interpret protocols and advise treating physicians on appropriate dosage modifications or treatment calculations based on patient characteristics.","core":false,"importance":3.73,"relevance":31.04,"frequency":3.74},{"id":15591,"text":"Confer with health care professionals to determine the best recruitment practices for studies.","core":true,"importance":3.63,"relevance":69.39,"frequency":2.6},{"id":15607,"text":"Communicate with laboratories or investigators regarding laboratory findings.","core":true,"importance":3.62,"relevance":78.48,"frequency":3.89},{"id":15590,"text":"Contact industry representatives to ensure equipment and software specifications necessary for successful study completion.","core":false,"importance":3.58,"relevance":49.05,"frequency":2.85},{"id":15583,"text":"Review scientific literature, participate in continuing education activities, or attend conferences and seminars to maintain current knowledge of clinical studies affairs and issues.","core":true,"importance":3.48,"relevance":84.9,"frequency":2.32},{"id":15584,"text":"Register protocol patients with appropriate statistical centers as required.","core":false,"importance":3.48,"relevance":44.36,"frequency":3.34},{"id":15599,"text":"Organize space for study equipment and supplies.","core":true,"importance":3.38,"relevance":89.62,"frequency":3.4},{"id":15589,"text":"Develop advertising and other informational materials to be used in subject recruitment.","core":true,"importance":3.27,"relevance":71.82,"frequency":2.15},{"id":15582,"text":"Solicit industry-sponsored trials through contacts and professional organizations.","core":false,"importance":3.22,"relevance":52.72,"frequency":2.75},{"id":15586,"text":"Participate in preparation and management of research budgets and monetary disbursements.","core":false,"importance":3.08,"relevance":53.48,"frequency":2.69}],"activities":[{"id":"4.A.3.b.6","importance":4.53},{"id":"4.A.2.b.6","importance":4.43},{"id":"4.A.1.a.1","importance":4.39},{"id":"4.A.3.b.1","importance":4.39},{"id":"4.A.4.a.2","importance":4.13},{"id":"4.A.1.a.2","importance":4.1},{"id":"4.A.2.a.3","importance":4.08},{"id":"4.A.2.b.5","importance":4.01},{"id":"4.A.4.c.1","importance":3.94},{"id":"4.A.4.a.4","importance":3.86},{"id":"4.A.1.b.1","importance":3.74},{"id":"4.A.2.b.1","importance":3.7},{"id":"4.A.4.b.3","importance":3.54},{"id":"4.A.2.a.2","importance":3.48},{"id":"4.A.4.a.5","importance":3.48},{"id":"4.A.2.a.4","importance":3.45},{"id":"4.A.2.b.3","importance":3.41},{"id":"4.A.4.b.1","importance":3.23},{"id":"4.A.4.a.8","importance":3.2},{"id":"4.A.2.a.1","importance":3.18},{"id":"4.A.2.b.2","importance":3.13},{"id":"4.A.4.a.3","importance":3.13},{"id":"4.A.4.a.1","importance":3.12},{"id":"4.A.4.b.5","importa