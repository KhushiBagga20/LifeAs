{"code":"13-2052.00","title":"Personal Financial Advisors","description":"Advise clients on financial plans using knowledge of tax and investment strategies, securities, insurance, pension plans, and real estate. Duties include assessing clients' assets, liabilities, cash flow, insurance coverage, tax status, and financial objectives. May also buy and sell financial assets for clients.","jobZone":4,"kinds":{"R":{"score":1,"share":0},"I":{"score":3.27,"share":0.1465},"A":{"score":1.69,"share":0.0445},"S":{"score":4.07,"share":0.1982},"E":{"score":5.85,"share":0.3131},"C":{"score":5.61,"share":0.2976}},"highPoints":["E","C","S"],"tasks":[{"id":12907,"text":"Interview clients to determine their current income, expenses, insurance coverage, tax status, financial objectives, risk tolerance, or other information needed to develop a financial plan.","core":true,"importance":4.65,"relevance":100,"frequency":2.92},{"id":12904,"text":"Analyze financial information obtained from clients to determine strategies for meeting clients' financial objectives.","core":true,"importance":4.62,"relevance":100,"frequency":3.62},{"id":12905,"text":"Answer clients' questions about the purposes and details of financial plans and strategies.","core":true,"importance":4.54,"relevance":100,"frequency":3.23},{"id":20183,"text":"Review clients' accounts and plans regularly to determine whether life changes, economic changes, environmental concerns, or financial performance indicate a need for plan reassessment.","core":true,"importance":4.46,"relevance":100,"frequency":3.23},{"id":20184,"text":"Manage client portfolios, keeping client plans up-to-date.","core":true,"importance":4.44,"relevance":96.15,"frequency":3.8},{"id":20182,"text":"Recommend to clients strategies in cash management, insurance coverage, investment planning, or other areas to help them achieve their financial goals.","core":true,"importance":4.42,"relevance":100,"frequency":3.38},{"id":20189,"text":"Recommend financial products, such as stocks, bonds, mutual funds, or insurance.","core":true,"importance":4.21,"relevance":92.31,"frequency":3.5},{"id":12909,"text":"Implement financial planning recommendations, or refer clients to someone who can assist them with plan implementation.","core":true,"importance":4.19,"relevance":100,"frequency":3.46},{"id":12915,"text":"Contact clients periodically to determine any changes in their financial status.","core":true,"importance":4.12,"relevance":96.15,"frequency":2.88},{"id":12913,"text":"Prepare or interpret for clients information, such as investment performance reports, financial document summaries, or income projections.","core":true,"importance":4.04,"relevance":100,"frequency":3.48},{"id":20186,"text":"Explain to clients the personal financial advisor's responsibilities and the types of services to be provided.","core":true,"importance":4,"relevance":96.15,"frequency":2.76},{"id":20187,"text":"Investigate available investment opportunities to determine compatibility with client financial plans.","core":true,"importance":3.96,"relevance":96,"frequency":2.88},{"id":12918,"text":"Open accounts for clients, and disburse funds from accounts to creditors as agent for clients.","core":false,"importance":3.85,"relevance":50,"frequency":3},{"id":12914,"text":"Guide clients in the gathering of information, such as bank account records, income tax returns, life and disability insurance records, pension plans, or wills.","core":true,"importance":3.83,"relevance":92.31,"frequency":3.04},{"id":20188,"text":"Monitor financial market trends to ensure that client plans are responsive.","core":true,"importance":3.58,"relevance":92.31,"frequency":3.46},{"id":20185,"text":"Recruit and maintain client bases.","core":true,"importance":3.5,"relevance":72,"frequency":3.17},{"id":12916,"text":"Meet with clients' other advisors, such as attorneys, accountants, trust officers, or investment bankers, to fully understand clients' financial goals and circumstances.","cor