{"code":"19-3039.02","title":"Neuropsychologists","description":"Apply theories and principles of neuropsychology to evaluate and diagnose disorders of higher cerebral functioning, often in research and medical settings. Study the human brain and the effect of physiological states on human cognition and behavior. May formulate and administer programs of treatment.","jobZone":5,"kinds":{"R":{"score":2.63,"share":0.0947},"I":{"score":7,"share":0.3486},"A":{"score":3.28,"share":0.1325},"S":{"score":5.29,"share":0.2493},"E":{"score":1.69,"share":0.0401},"C":{"score":3.32,"share":0.1348}},"highPoints":["I","S"],"tasks":[{"id":22193,"text":"Conduct neuropsychological evaluations such as assessments of intelligence, academic ability, attention, concentration, sensorimotor function, language, learning, and memory.","core":true,"importance":4.8,"relevance":100,"frequency":4.96},{"id":22206,"text":"Write or prepare detailed clinical neuropsychological reports, using data from psychological or neuropsychological tests, self-report measures, rating scales, direct observations, or interviews.","core":true,"importance":4.76,"relevance":100,"frequency":5.36},{"id":22202,"text":"Interview patients to obtain comprehensive medical histories.","core":true,"importance":4.68,"relevance":100,"frequency":4.84},{"id":22197,"text":"Diagnose and treat conditions involving injury to the central nervous system, such as cerebrovascular accidents, neoplasms, infectious or inflammatory diseases, degenerative diseases, head traumas, demyelinating diseases, and various forms of dementing illnesses.","core":true,"importance":4.67,"relevance":100,"frequency":4.76},{"id":22201,"text":"Establish neurobehavioral baseline measures for monitoring progressive cerebral disease or recovery.","core":true,"importance":4.4,"relevance":100,"frequency":4.64},{"id":22204,"text":"Provide education or counseling to individuals and families.","core":true,"importance":4.4,"relevance":100,"frequency":4.92},{"id":22199,