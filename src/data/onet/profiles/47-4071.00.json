{"code":"47-4071.00","title":"Septic Tank Servicers and Sewer Pipe Cleaners","description":"Clean and repair septic tanks, sewer lines, or drains. May patch walls and partitions of tank, replace damaged drain tile, or repair breaks in underground piping.","jobZone":2,"kinds":{"R":{"score":7,"share":0.5469},"I":{"score":2.07,"share":0.0975},"A":{"score":1,"share":0},"S":{"score":1.45,"share":0.041},"E":{"score":1.19,"share":0.0173},"C":{"score":4.26,"share":0.2972}},"highPoints":["R","C"],"tasks":[{"id":11602,"text":"Communicate with supervisors and other workers, using equipment such as wireless phones, pagers, or radio telephones.","core":true,"importance":4.04,"relevance":92.45,"frequency":5.3},{"id":11601,"text":"Drive trucks to transport crews, materials, and equipment.","core":true,"importance":4.02,"relevance":93.18,"frequency":5.29},{"id":11613,"text":"Inspect manholes to locate sewer line stoppages.","core":true,"importance":3.99,"relevance":77.93,"frequency":4.31},{"id":11604,"text":"Operate sewer cleaning equipment, including power rodders, high-velocity water jets, sewer flushers, bucket machines, wayne balls, and vac-alls.","core":true,"importance":3.93,"relevance":80.7,"frequency":4.82},{"id":11603,"text":"Prepare and keep records of actions taken, including maintenance and repair work.","core":true,"importance":3.9,"relevance":68.59,"frequency":5.24},{"id":11610,"text":"Clean and repair septic tanks, sewer lines, or related structures such as manholes, culverts, and catch basins.","core":true,"importance":3.87,"relevance":85.85,"frequency":4.47},{"id":11608,"text":"Measure excavation sites, using plumbers' snakes, tapelines, or lengths of cutting heads within sewers, and mark areas for digging.","core":true,"importance":3.86,"relevance":67.53,"frequency":3.88},{"id":11612,"text":"Service, adjust, and make minor repairs to equipment, machines, and attachments.","core":true,"importance":3.72,"relevance":86.76,"frequency":3.84},{"id":11620,"text":"Clean a