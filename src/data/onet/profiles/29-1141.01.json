{"code":"29-1141.01","title":"Acute Care Nurses","description":"Provide advanced nursing care for patients with acute conditions such as heart attacks, respiratory distress syndrome, or shock. May care for pre- and post-operative patients or perform advanced, invasive diagnostic or therapeutic procedures.","jobZone":4,"kinds":{"R":{"score":3.7,"share":0.1689},"I":{"score":5.66,"share":0.2914},"A":{"score":1.75,"share":0.0469},"S":{"score":5.8,"share":0.3002},"E":{"score":1.76,"share":0.0475},"C":{"score":3.32,"share":0.1451}},"highPoints":["S","I"],"tasks":[{"id":18307,"text":"Discuss illnesses and treatments with patients and family members.","core":true,"importance":4.9,"relevance":100,"frequency":6.05},{"id":18298,"text":"Diagnose acute or chronic conditions that could result in rapid physiological deterioration or life-threatening instability.","core":true,"importance":4.87,"relevance":75,"frequency":5.87},{"id":18302,"text":"Perform emergency medical procedures, such as basic cardiac life support (BLS), advanced cardiac life support (ACLS), and other condition-stabilizing interventions.","core":true,"importance":4.8,"relevance":100,"frequency":3.55},{"id":18303,"text":"Assess urgent and emergent health conditions, using both physiologically and technologically derived data.","core":true,"importance":4.79,"relevance":95,"frequency":5.89},{"id":18304,"text":"Adjust settings on patients' assistive devices, such as temporary pacemakers.","core":false,"importance":4.69,"relevance":66.67,"frequency":4.46},{"id":18310,"text":"Set up, operate, or monitor invasive equipment and devices, such as colostomy or tracheotomy equipment, mechanical ventilators, catheters, gastrointestinal tubes, and central lines.","core":true,"importance":4.63,"relevance":95,"frequency":5.47},{"id":18308,"text":"Document data related to patients' care, including assessment results, interventions, medications, patient responses, or treatment changes.","core":true,"importance":4.57,"relevance":1