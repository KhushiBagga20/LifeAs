{"code":"29-2072.00","title":"Medical Records Specialists","description":"Compile, process, and maintain medical records of hospital and clinic patients in a manner consistent with medical, administrative, ethical, legal, and regulatory requirements of the healthcare system. Classify medical and healthcare concepts, including diagnosis, procedures, medical services, and equipment, into the healthcare industry's numerical coding system. Includes medical coders.","jobZone":3,"kinds":{"R":{"score":2.86,"share":0.1289},"I":{"score":4.33,"share":0.2308},"A":{"score":1,"share":0},"S":{"score":3.41,"share":0.167},"E":{"score":1.88,"share":0.061},"C":{"score":6.95,"share":0.4123}},"highPoints":["C","I"],"tasks":[{"id":22886,"text":"Protect the security of medical records to ensure that confidentiality is maintained.","core":true,"importance":4.8,"relevance":100,"frequency":6.17},{"id":22890,"text":"Review records for completeness, accuracy, and compliance with regulations.","core":true,"importance":4.68,"relevance":99.13,"frequency":5.92},{"id":22891,"text":"Scan patients' health records into electronic formats.","core":true,"importance":4.63,"relevance":87.55,"frequency":5.78},{"id":22888,"text":"Resolve or clarify codes or diagnoses with conflicting, missing, or unclear information by consulting with doctors or others or by participating in the coding team's regular meetings.","core":false,"importance":4.54,"relevance":45.15,"frequency":4.75},{"id":22887,"text":"Release information to persons or agencies according to regulations.","core":true,"importance":4.5,"relevance":91.11,"frequency":4.76},{"id":22878,"text":"Compile and maintain patients' medical records to document condition and treatment and to provide data for research or cost control and care improvement efforts.","core":false,"importance":4.45,"relevance":63.55,"frequency":5.2},{"id":22881,"text":"Identify, compile, abstract, and code patient data, using standard classification systems.","core":false,"importanc