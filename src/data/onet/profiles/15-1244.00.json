{"code":"15-1244.00","title":"Network and Computer Systems Administrators","description":"Install, configure, and maintain an organization's local area network (LAN), wide area network (WAN), data communications network, operating systems, and physical and virtual servers. Perform system monitoring and verify the integrity and availability of hardware, network, and server resources and systems. Review system and application logs and verify completion of scheduled jobs, including system backups. Analyze network and server resource consumption and control user access. Install and upgrade software and maintain software licenses. May assist in network modeling, analysis, planning, and coordination between network and data communications hardware and software.","jobZone":3,"kinds":{"R":{"score":4.19,"share":0.2114},"I":{"score":4.04,"share":0.2015},"A":{"score":1,"share":0},"S":{"score":2.22,"share":0.0808},"E":{"score":3.46,"share":0.163},"C":{"score":6.18,"share":0.3433}},"highPoints":["C","R","I"],"tasks":[{"id":1319,"text":"Plan, coordinate, and implement network security measures to protect data, software, and hardware.","core":true,"importance":4.56,"relevance":96.15,"frequency":3.48},{"id":1317,"text":"Perform data backups and disaster recovery operations.","core":true,"importance":4.35,"relevance":100,"frequency":3.42},{"id":15205,"text":"Diagnose, troubleshoot, and resolve hardware, software, or other network and system problems, and replace defective components when necessary.","core":true,"importance":4.12,"relevance":100,"frequency":4.38},{"id":1318,"text":"Maintain and administer computer networks and related computing environments, including computer hardware, systems software, applications software, and all configurations.","core":true,"importance":4.08,"relevance":96.15,"frequency":4.84},{"id":15206,"text":"Configure, monitor, and maintain email applications or virus protection software.","core":true,"importance":3.92,"relevance":96.15,"frequency":4.36},{