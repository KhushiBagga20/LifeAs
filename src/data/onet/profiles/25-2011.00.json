{"code":"25-2011.00","title":"Preschool Teachers, Except Special Education","description":"Instruct preschool-aged students, following curricula or lesson plans, in activities designed to promote social, physical, and intellectual growth.","jobZone":3,"kinds":{"R":{"score":2.94,"share":0.1156},"I":{"score":2.76,"share":0.1049},"A":{"score":3.98,"share":0.1776},"S":{"score":7,"share":0.3576},"E":{"score":2.49,"share":0.0888},"C":{"score":3.61,"share":0.1555}},"highPoints":["S","A"],"tasks":[{"id":6466,"text":"Teach basic skills, such as color, shape, number and letter recognition, personal hygiene, and social skills.","core":true,"importance":4.6,"relevance":99.71,"frequency":5.72},{"id":6464,"text":"Provide a variety of materials and resources for children to explore, manipulate, and use, both in learning activities and in imaginative play.","core":true,"importance":4.57,"relevance":95.08,"frequency":5.42},{"id":6467,"text":"Establish and enforce rules for behavior and procedures for maintaining order.","core":true,"importance":4.57,"relevance":97.77,"frequency":5.67},{"id":6478,"text":"Adapt teaching methods and instructional materials to meet students' varying needs and interests.","core":true,"importance":4.57,"relevance":97.62,"frequency":5.34},{"id":6476,"text":"Serve meals and snacks in accordance with nutritional guidelines.","core":true,"importance":4.54,"relevance":91.37,"frequency":5.33},{"id":6465,"text":"Attend to children's basic needs by feeding them, dressing them, and changing their diapers.","core":true,"importance":4.53,"relevance":73.23,"frequency":5.55},{"id":6472,"text":"Meet with parents and guardians to discuss their children's progress and needs, determine their priorities for their children, and suggest ways that they can promote learning and development.","core":true,"importance":4.47,"relevance":91.84,"frequency":3.14},{"id":6469,"text":"Organize and lead activities designed to promote physical, mental, and social development, such as games, arts and crafts, music, storytelling, and field trips.","core":true,"importance":4.45,"relevance":99.42,"frequency":5.35},{"id":6470,"text":"Observe and evaluate children's performance, behavior, social development, and physical health.","core":true,"importance":4.42,"relevance":93.92,"frequency":4.89},{"id":6471,"text":"Identify children showing signs of emotional, developmental, or health-related problems and discuss them with supervisors, parents or guardians, and child development specialists.","core":true,"importance":4.42,"relevance":98.69,"frequency":3.55},{"id":6477,"text":"Assimilate arriving children to the school environment by greeting them, helping them remove outerwear, and selecting activities of interest to them.","core":true,"importance":4.42,"relevance":99.43,"frequency":5.53},{"id":6482,"text":"Maintain accurate and complete student records as required by laws, district policies, and administrative regulations.","core":true,"importance":4.42,"relevance":76.36,"frequency":4.75},{"id":6474,"text":"Prepare materials and classrooms for class activities.","core":true,"importance":4.41,"relevance":99.72,"frequency":5.19},{"id":6468,"text":"Read books to entire classes or to small groups.","core":true,"importance":4.39,"relevance":100,"frequency":5.29},{"id":6479,"text":"Establish clear objectives for all lessons, units, and projects and communicate those objectives to children.","core":true,"importance":4.32,"relevance":98.2,"frequency":5.03},{"id":6481,"text":"Arrange indoor and outdoor space to facilitate creative play, motor-skill activities, and safety.","core":true,"importance":4.29,"relevance":97.1,"frequency":4.81},{"id":6475,"text":"Teach proper eating habits and personal hygiene.","core":true,"importance":4.28,"relevance":97.71,"frequency":5.27},{"id":6480,"text":"Demonstrate activities to children.","core":true,"importance":4.28,"relevance":100,"frequency":5.59},{"id":6484,"text":"Plan and conduct activities for a balanced program of instruction, demonstration, and work time that provides students with opportunities to observe, question, and investigate.","core":true,"importance":4.23,"relevance":94.13,"frequency":4.95},{"id":6473,"text":"Enforce all administration policies and rules governing students.","core":true,"importance":4.22,"relevance":89.76,"frequency":5.39},{"id":6497,"text":"Prepare and implement remedial programs for students requiring extra help.","core":true,"importance":4.08,"relevance":77.46,"frequency":3.75},{"id":6487,"text":"Confer with other staff members to plan and schedule lessons promoting learning, following approved curricula.","core":true,"importance":4.01,"relevance":87.42,"frequency":3.77},{"id":6494,"text":"Provide students with disabilities with assistive devices, supportive technology, and assistance accessing facilities, such as restrooms.","core":false,"importance":4,"relevance":42.52,"frequency":3.05},{"id":6486,"text":"Attend professional meetings, educational conferences, and teacher training workshops to maintain and improve professional competence.","core":true,"importance":3.99,"relevance":92.14,"frequency":2.34},{"id":6485,"text":"Organize and label materials and display students' work in a manner appropriate for their ages and perceptual skills.","core":true,"importance":3.97,"relevance":99.72,"frequency":4.8},{"id":6483,"text":"Prepare reports on students and activities as required by administration.","core":true,"importance":3.94,"relevance":88.66,"frequency":3.24},{"id":6489,"text":"Collaborate with other teachers and administrators in the development, evaluation, and revision of preschool programs.","core":true,"importance":3.9,"relevance":84.03,"frequency":3.15},{"id":6492,"text":"Plan and supervise class projects, field trips, visits by guests, or other experiential activities and guide students in learning from those activities.","core":true,"importance":3.86,"relevance":92.83,"frequency":3.75},{"id":6495,"text":"Perform administrative duties, such as