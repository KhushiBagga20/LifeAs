{"code":"29-1129.02","title":"Music Therapists","description":"Plan, organize, direct, or assess clinical and evidenced-based music therapy interventions to positively influence individuals' physical, psychological, cognitive, or behavioral status.","jobZone":4,"kinds":{"R":{"score":2.36,"share":0.084},"I":{"score":4.18,"share":0.1964},"A":{"score":4.76,"share":0.2322},"S":{"score":5.23,"share":0.2613},"E":{"score":2.51,"share":0.0933},"C":{"score":3.15,"share":0.1328}},"highPoints":["S","A","I"],"tasks":[{"id":19179,"text":"Design or provide music therapy experiences to address client needs, such as using music for self-care, adjusting to life changes, improving cognitive functioning, raising self-esteem, communicating, or controlling impulses.","core":true,"importance":4.92,"relevance":100,"frequency":6.12},{"id":19171,"text":"Design music therapy experiences, using various musical elements to meet client's goals or objectives.","core":true,"importance":4.88,"relevance":100,"frequency":6.08},{"id":19178,"text":"Sing or play musical instruments, such as keyboard, guitar, or percussion instruments.","core":true,"importance":4.88,"relevance":100,"frequency":6.27},{"id":19181,"text":"Communicate with clients to build rapport, acknowledge their progress, or reflect upon their reactions to musical experiences.","core":true,"importance":4.85,"relevance":100,"frequency":5.96},{"id":19170,"text":"Customize treatment programs for specific areas of music therapy, such as intellectual or developmental disabilities, educational settings, geriatrics, medical settings, mental health, physical disabilities, or wellness.","core":true,"importance":4.69,"relevance":100,"frequency":5.15},{"id":19173,"text":"Establish client goals or objectives for music therapy treatment, considering client needs, capabilities, interests, overall therapeutic program, coordination of treatment, or length of treatment.","core":true,"importance":4.68,"relevance":96.15,"frequency":4.4},{"id":19182,"text":"Document evaluations, treatment plans, case summaries, or progress or other reports related to individual clients or client groups.","core":true,"importance":4.65,"relevance":100,"frequency":5.19},{"id":19167,"text":"Assess client functioning levels, strengths, and areas of need in terms of perceptual, sensory, affective, communicative, musical, physical, cognitive, social, spiritual, or other abilities.","core":true,"importance":4.58,"relevance":96.15,"frequency":5.12},{"id":19176,"text":"Observe and document client reactions, progress, or other outcomes related to music therapy.","core":true,"importance":4.56,"relevance":96.15,"frequency":5.6},{"id":19175,"text":"Improvise instrumentally, vocally, or physically to meet client's therapeutic needs.","core":true,"importance":4.46,"relevance":100,"frequency":5.54},{"id":19174,"text":"Gather diagnostic data from sources such as case documentation, observations of clients, or interviews with clients or family members.","core":true,"importance":4.35,"relevance":100,"frequency":4.58},{"id":19177,"text":"Plan or structure music therapy sessions to achieve appropriate transitions, pacing, sequencing, energy level, or intensity in accordance with treatment plans.","core":true,"importance":4.31,"relevance":100,"frequency":5.58},{"id":19172,"text":"Engage clients in music experiences to identify client responses to different styles of music, types of musical experiences, such as improvising or listening, or elements of music, such as tempo or harmony.","core":true,"importance":4.27,"relevance":100,"frequency":5.31},{"id":20167,"text":"Participate in continuing education.","core":true,"importance":4.23,"relevance":100,"frequency":2.35},{"id":19168,"text":"Communicate client assessment findings and recommendations in oral, written, audio, video, or other forms.","core":true,"importance":4.2,"relevance":96.15,"frequency":4.28},{"id":19188,"text":"Integrate behavioral, developmental, improvisational, medical, or neurological approaches into music therapy treatments.","core":true,"importance":4.2,"relevance":96.15,"frequency":5.4},{"id":19169,"text":"Confer with professionals on client's treatment team to develop, coordinate, or integrate treatment plans.","core":true,"importance":4.17,"relevance":92.31,"frequency":4.12},{"id":19180,"text":"Select or adapt musical instruments, musical equipment, or non-musical materials, such as adaptive devices or visual aids, to meet treatment objectives.","core":true,"importance":4.16,"relevance":96.15,"frequency":4.68},{"id":19184,"text":"Compose, arrange, or adapt music for music therapy treatments.","core":true,"importance":4.04,"relevance":100,"frequency":4.46},{"id":19187,"text":"Identify and respond to emergency physical or mental health situations.","core":true,"importance":3.83,"relevance":92.31,"frequency":3.29},{"id":19166,"text":"Analyze or synthesize client data to draw conclusions or make recommendations for therapy.","core":true,"importance":3.8,"relevance":96.15,"frequency":3.64},{"id":20166,"text":"Collaborate with others to design or implement interdisciplinary treatment programs.","core":true,"importance":3.76,"relevance":100,"frequency":3.58},{"id":19185,"text":"Conduct information sharing sessions, such as in-service workshops for other professionals, potential client groups, or the general community.","core":true,"importance":3.73,"relevance":100,"frequency":2.19},{"id":19189,"text":"Apply selected research findings to practice.","core":true,"importance":3.68,"relevance":96.15,"frequency":3.72},{"id":19165,"text":"Analyze data to determine the effectiveness of specific treatments or therapy approaches.","core":true,"importance":3.67,"relevance":96.15,"frequency":3.32},{"id":19190,"text":"Supervise staff, volunteers, practicum students, or interns engaged in music therapy activities.","core":true,"importance":3.65,"relevance":100,"frequency":4.42},{"id":19183,"text":"Assess the risks and benefits of treatment termination for clients."