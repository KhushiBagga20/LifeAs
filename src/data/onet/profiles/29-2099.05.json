{"code":"29-2099.05","title":"Ophthalmic Medical Technologists","description":"Assist ophthalmologists by performing ophthalmic clinical functions and ophthalmic photography. Provide instruction and supervision to other ophthalmic personnel. Assist with minor surgical procedures, applying aseptic techniques and preparing instruments. May perform eye exams, administer eye medications, and instruct patients in care and use of corrective lenses.","jobZone":3,"kinds":{"R":{"score":5.41,"share":0.2704},"I":{"score":4.71,"share":0.2275},"A":{"score":1.12,"share":0.0074},"S":{"score":4.32,"share":0.2036},"E":{"score":2.02,"share":0.0625},"C":{"score":4.73,"share":0.2287}},"highPoints":["R","C","I"],"tasks":[{"id":19268,"text":"Conduct tonometry or tonography tests to measure intraocular pressure.","core":true,"importance":4.95,"relevance":100,"frequency":6.53},{"id":19287,"text":"Take and document patients' medical histories.","core":true,"importance":4.9,"relevance":100,"frequency":6.74},{"id":19281,"text":"Take anatomical or functional ocular measurements, such as axial length measurements, of the eye or surrounding tissue.","core":true,"importance":4.75,"relevance":100,"frequency":5.37},{"id":19275,"text":"Measure visual acuity, including near, distance, pinhole, or dynamic visual acuity, using appropriate tests.","core":true,"importance":4.7,"relevance":100,"frequency":6.74},{"id":19259,"text":"Administer topical ophthalmic or oral medications.","core":true,"importance":4.65,"relevance":100,"frequency":6.74},{"id":19278,"text":"Perform slit lamp biomicroscopy procedures to diagnose disorders of the eye, such as retinitis, presbyopia, cataracts, or retinal detachment.","core":false,"importance":4.62,"relevance":65,"frequency":6.17},{"id":19263,"text":"Calculate corrections for refractive errors.","core":true,"importance":4.6,"relevance":100,"frequency":6.05},{"id":19271,"text":"Measure and record lens power, using lensometers.","core":true,"importance":4.6,"relevance":100,"frequency":6.63},{"id":19264,"text":"Collect ophthalmic measurements or other diagnostic information, using ultrasound equipment, such as A-scan ultrasound biometry or B-scan ultrasonography equipment.","core":true,"importance":4.47,"relevance":95,"frequency":4.83},{"id":21190,"text":"Perform ophthalmic triage, in the office or by phone, to assess severity of patients' conditions.","core":true,"importance":4.47,"relevance":95,"frequency":5.22},{"id":19283,"text":"Clean or sterilize ophthalmic or surgical instruments.","core":true,"importance":4.45,"relevance":100,"frequency":4.11},{"id":21191,"text":"Educate patients on ophthalmic medical procedures, conditions of the eye, and appropriate use of medications.","core":true,"importance":4.4,"relevance":100,"frequency":6.16},{"id":19266,"text":"Conduct ocular motility tests to measure function of eye muscles.","core":true,"importance":4.35,"relevance":100,"frequency":6.16},{"id":19261,"text":"Assess refractive condition of eyes, using retinoscope.","core":true,"importance":4.25,"relevance":100,"frequency":5.74},{"id":19269,"text":"Conduct visual field tests to measure field of vision.","core":true,"importance":4.2,"relevance":100,"frequency":4.84},{"id":19270,"text":"Create three-dimensional images of the eye, using computed tomography (CT).","core":false,"importance":4.2,"relevance":52.63,"frequency":5.44},{"id":19273,"text":"Measure corneal thickness, using pachymeter or contact ultrasound methods.","core":true,"importance":4.16,"relevance":95,"frequency":5.44},{"id":19272,"text":"Measure corneal curvature with keratometers or ophthalmometers to aid in the diagnosis of conditions, such as astigmatism.","core":true,"importance":4.15,"relevance":100,"frequency":4.63},{"id":19262,"text":"Assist physicians in performing ophthalmic procedures, including surgery.","core":true,"importance":4.11,"relevance":95,"frequency":3.94},{"id":19274,"text":"Measure the thickness of the retinal nerve, using scanning laser polarimetry techniques to aid in diagnosis of glaucoma.","core":true,"importance":4.11,"relevance":90,"frequency":5.06},{"id":19280,"text":"Supervise or instruct ophthalmic staff.","core":true,"importance":4.11,"relevance":95,"frequency":5.11},{"id":19277,"text":"Perform fluorescein angiography of the eye.","core":true,"importance":4.07,"relevance":70,"frequency":3.85},{"id":19279,"text":"Photograph patients' eye areas, using clinical photography techniques, to document retinal or corneal defects.","core":true,"importance":4,"relevance":100,"frequency":4.74},{"id":19286,"text":"Maintain ophthalmic instruments or equipment.","core":true,"importance":3.95,"relevance":95,"frequency":4.72},{"id":19267,"text":"Conduct tests, such as the Amsler Grid test, to measure central visual field used in the early diagnosis of macular degeneration, glaucoma, or diseases of the eye.","core":true,"importance":3.9,"relevance":100,"frequency":4.63},{"id":19265,"text":"Conduct binocular disparity tests to assess depth perception.","core":true,"importance":3.68,"relevance":95,"frequency":4.72},{"id":19260,"text":"Assess abnormalities of color vision, such as amblyopia.","core":true,"importance":3.63,"relevance":95,"frequency":4.33},{"id":19282,"text":"Call patients to inquire about their post-operative status or recovery.","core":true,"importance":3.57,"relevance":70,"frequency":3.15},{"id":19285,"text":"Instruct patients in the care and use of contact lenses.","core":true,"importance":3.53,"relevance":85,"frequency":3.69},{"id":19284,"text":"Conduct low vision blindness tests.","core":true,"importance":3.5,"relevance":75,"frequency":2.93},{"id":19276,"text":"Perform advanced ophthalmic procedures, including electrophysiological, electrophysical, or microbial procedures.","core":true,"importance":3.31,"relevance":70,"frequency":2.46}],"activities":[{"id":"4.A.3.b.6","importance":4.6},{"id":"4.A.1.a.1","importance":4.55},{"id":"4.A.4.a.5","importance":4.42},{"id":"4.A.4.a.8","importance":4.15},{"id