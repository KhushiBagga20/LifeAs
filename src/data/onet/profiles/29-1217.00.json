{"code":"29-1217.00","title":"Neurologists","description":"Diagnose, manage, and treat disorders and diseases of the brain, spinal cord, and peripheral nerves, with a primarily nonsurgical focus.","jobZone":5,"kinds":{"R":{"score":4.1,"share":0.1696},"I":{"score":7,"share":0.3282},"A":{"score":2.08,"share":0.0591},"S":{"score":5.02,"share":0.2199},"E":{"score":2.39,"share":0.076},"C":{"score":3.69,"share":0.1472}},"highPoints":["I","S"],"tasks":[{"id":17123,"text":"Interview patients to obtain information, such as complaints, symptoms, medical histories, and family histories.","core":true,"importance":4.86,"relevance":96.37,"frequency":6.14},{"id":17132,"text":"Examine patients to obtain information about functional status of areas, such as vision, physical strength, coordination, reflexes, sensations, language skills, cognitive abilities, and mental status.","core":true,"importance":4.84,"relevance":100,"frequency":6.18},{"id":17130,"text":"Perform or interpret the outcomes of procedures or diagnostic tests, such as lumbar punctures, electroencephalography, electromyography, and nerve conduction velocity tests.","core":true,"importance":4.82,"relevance":100,"frequency":5.68},{"id":17121,"text":"Order or interpret results of laboratory analyses of patients' blood or cerebrospinal fluid.","core":true,"importance":4.79,"relevance":100,"frequency":5.83},{"id":17125,"text":"Diagnose neurological conditions based on interpretation of examination findings, histories, or test results.","core":true,"importance":4.74,"relevance":98.51,"frequency":5.93},{"id":17117,"text":"Prescribe or administer medications, such as anti-epileptic drugs, and monitor patients for behavioral and cognitive side effects.","core":true,"importance":4.72,"relevance":100,"frequency":6.01},{"id":17131,"text":"Identify and treat major neurological system diseases and disorders, such as central nervous system infection, cranio spinal trauma, dementia, and stroke.","core":true,"importance":4.66,"relevance":100,"frequency":5.54},{"id":17124,"text":"Inform patients or families of neurological diagnoses and prognoses, or benefits, risks and costs of various treatment plans.","core":true,"importance":4.62,"relevance":100,"frequency":5.89},{"id":17126,"text":"Develop treatment plans based on diagnoses and on evaluation of factors, such as age and general health, or procedural risks and costs.","core":true,"importance":4.62,"relevance":100,"frequency":6.02},{"id":17119,"text":"Prepare, maintain, or review records that include patients' histories, neurological examination findings, treatment plans, or outcomes.","core":true,"importance":4.59,"relevance":96.37,"frequency":5.8},{"id":17128,"text":"Communicate with other health care professionals regarding patients' conditions and care.","core":true,"importance":4.58,"relevance":100,"frequency":5.41},{"id":17113,"text":"Counsel patients or others on the background of neurological disorders including risk factors, or genetic or environmental concerns.","core":true,"importance":4.44,"relevance":100,"frequency":5.62},{"id":17114,"text":"Interpret the results of neuroimaging studies, such as Magnetic Resonance Imaging (MRI), Single Photon Emission Computed Tomography (SPECT), and Positron Emission Tomography (PET) scans.","core":true,"importance":4.4,"relevance":98.1,"frequency":5.24},{"id":17127,"text":"Determine brain death using accepted tests and procedures.","core":true,"importance":4.34,"relevance":93.59,"frequency":2.71},{"id":17129,"text":"Coordinate neurological services with other health care team activities.","core":true,"importance":4.32,"relevance":96.52,"frequency":4.98},{"id":17115,"text":"Refer patients to other health care practitioners as necessary.","core":true,"importance":4.27,"relevance":100,"frequency":4.89},{"id":17116,"text":"Advise other physicians on the treatment of neurological problems.","core":true,"importance":4.25,"relevance":94.62,"frequency":4.8},{"id":17120,"text":"Perform specialized treatme