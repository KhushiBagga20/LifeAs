{"code":"29-1122.01","title":"Low Vision Therapists, Orientation and Mobility Specialists, and Vision Rehabilitation Therapists","description":"Provide therapy to patients with visual impairments to improve their functioning in daily life activities. May train patients in activities such as computer use, communication skills, or home management skills.","jobZone":5,"kinds":{"R":{"score":3.93,"share":0.1777},"I":{"score":3.89,"share":0.1753},"A":{"score":3.2,"share":0.1334},"S":{"score":6.52,"share":0.3347},"E":{"score":2.12,"share":0.0679},"C":{"score":2.83,"share":0.111}},"highPoints":["S","R","I"],"tasks":[{"id":17336,"text":"Teach cane skills, including cane use with a guide, diagonal techniques, and two-point touches.","core":true,"importance":4.7,"relevance":91.3,"frequency":5.29},{"id":17355,"text":"Recommend appropriate mobility devices or systems, such as human guides, dog guides, long canes, electronic travel aids (ETAs), and other adaptive mobility devices (AMDs).","core":true,"importance":4.67,"relevance":91.3,"frequency":3.29},{"id":17352,"text":"Train clients with visual impairments to use mobility devices or systems, such as human guides, dog guides, electronic travel aids (ETAs), and other adaptive mobility devices (AMDs).","core":true,"importance":4.55,"relevance":95.65,"frequency":4.73},{"id":17350,"text":"Develop rehabilitation or instructional plans collaboratively with clients, based on results of assessments, needs, and goals.","core":true,"importance":4.45,"relevance":95.65,"frequency":3.5},{"id":17346,"text":"Train clients to use tactile, auditory, kinesthetic, olfactory, and proprioceptive information.","core":true,"importance":4.43,"relevance":100,"frequency":4.91},{"id":17349,"text":"Write reports or complete forms to document assessments, training, progress, or follow-up outcomes.","core":true,"importance":4.43,"relevance":100,"frequency":4.74},{"id":17351,"text":"Assess clients' functioning in areas such as vision, orientation and mobilit