{"code":"51-3093.00","title":"Food Cooking Machine Operators and Tenders","description":"Operate or tend cooking equipment, such as steam cooking vats, deep fry cookers, pressure cookers, kettles, and boilers, to prepare food products.","jobZone":2,"kinds":{"R":{"score":6.82,"share":0.5},"I":{"score":1.98,"share":0.0842},"A":{"score":1.15,"share":0.0129},"S":{"score":1.34,"share":0.0292},"E":{"score":1.68,"share":0.0584},"C":{"score":4.67,"share":0.3153}},"highPoints":["R","C"],"tasks":[{"id":4949,"text":"Clean, wash, and sterilize equipment and cooking area, using water hoses, cleaning or sterilizing solutions, or rinses.","core":true,"importance":4.65,"relevance":100,"frequency":5.66},{"id":4948,"text":"Read work orders, recipes, or formulas to determine cooking times and temperatures, and ingredient specifications.","core":true,"importance":4.61,"relevance":95.28,"frequency":5.73},{"id":4947,"text":"Observe gauges, dials, and product characteristics, and adjust controls to maintain appropriate temperature, pressure, and flow of ingredients.","core":true,"importance":4.56,"relevance":83.11,"frequency":6.09},{"id":4952,"text":"Measure or weigh ingredients, using scales or measuring containers.","core":true,"importance":4.52,"relevance":84.81,"frequency":5.73},{"id":4951,"text":"Tend or operate and control equipment, such as kettles, cookers, vats and tanks, and boilers, to cook ingredients or prepare products for further processing.","core":true,"importance":4.48,"relevance":84.41,"frequency":6.09},{"id":4944,"text":"Record production and test data, such as processing steps, temperature and steam readings, cooking time, batches processed, and test results.","core":true,"importance":4.45,"relevance":89.16,"frequency":5.67},{"id":4950,"text":"Set temperature, pressure, and time controls, and start conveyers, machines, or pumps.","core":true,"importance":4.41,"relevance":77.86,"frequency":5.63},{"id":4959,"text":"Activate agitators and paddles to mix or stir ingredients, stopping machines when ingredients are thoroughly mixed.","core":false,"importance":4.38,"relevance":64.35,"frequency":5.85},{"id":4954,"text":"Remove cooked material or products from equipment.","core":true,"importance":4.37,"relevance":85.27,"frequency":5.37},{"id":4946,"text":"Collect and examine product samples during production to test them for quality, color, content, consistency, viscosity, acidity, or specific gravity.","core":true,"importance":4.35,"relevance":78.55,"frequency":5.77},{"id":4960,"text":"Operate auxiliary machines and equipment, such as grinders, canners, and molding presses, to prepare or further process products.","core":false,"importance":4.33,"relevance":58.24,"frequency":5.86},{"id":4958,"text":"Pour, dump, or load prescribed quantities of ingredients or products into cooking equipment, manually or using a hoist.","core":true,"importance":4.32,"relevance":84.59,"frequency":5.64},{"id":4945,"text":"Listen for malfunction alarms, and shut down equipment and notify supervisors when necessary.","core":true,"importance":4.27,"relevance":88.53,"frequency":4.84},{"id":4955,"text":"Notify or signal other workers to operate equipment or when processing is complete.","core":true,"importance":4.24,"relevance":79.09,"frequency":5.1},{"id":4956,"text":"Turn valves or start pumps to add ingredients or drain products from equipment and to transfer products for storage, cooling, or further processing.","core":true,"importance":4.23,"relevance":82.77,"frequency":5.57},{"id":4957,"text":"Place products on conveyors or carts, and monitor product flow.","core":false,"importance":4.23,"relevance":66.06,"frequency":5.7},{"id":4953,"text":"Admit required amounts of water, steam, cooking oils, or compressed air into equipment, such as by opening water valves to cool mixtures to the desired consistency.","core":true,"importance":4.21,"relevance":72.85,"frequency":5.66}],"activities":[{"id":"4.A.3.b.6","importance":4.2},{"id":"4.A.1.a.2","importance":4.16},{"