{"code":"53-4022.00","title":"Railroad Brake, Signal, and Switch Operators and Locomotive Firers","description":"Operate or monitor railroad track switches or locomotive instruments. May couple or uncouple rolling stock to make up or break up trains. Watch for and relay traffic signals. May inspect couplings, air hoses, journal boxes, and hand brakes. May watch for dragging equipment or obstacles on rights-of-way.","jobZone":2,"kinds":{"R":{"score":7,"share":0.5469},"I":{"score":2.07,"share":0.0975},"A":{"score":1,"share":0},"S":{"score":1.22,"share":0.0201},"E":{"score":1.43,"share":0.0392},"C":{"score":4.25,"share":0.2963}},"highPoints":["R","C"],"tasks":[{"id":23775,"text":"Signal locomotive engineers to start or stop trains when coupling or uncoupling cars, using hand signals, lanterns, or radio communication.","core":true,"importance":4.83,"relevance":88.26,"frequency":6.16},{"id":23785,"text":"Inspect locomotives to detect damaged or worn parts.","core":false,"importance":4.74,"relevance":57.34,"frequency":4.84},{"id":23774,"text":"Observe train signals along routes and verify their meanings for engineers.","core":true,"importance":4.64,"relevance":92.43,"frequency":5.31},{"id":23794,"text":"Operate and drive locomotives, diesel switch engines, dinkey engines, flatcars, and railcars in train yards and at industrial sites.","core":false,"importance":4.6,"relevance":47.09,"frequency":4.84},{"id":23779,"text":"Inspect couplings, air hoses, journal boxes, and handbrakes to ensure that they are securely fastened and functioning properly.","core":true,"importance":4.59,"relevance":89.88,"frequency":5.81},{"id":23782,"text":"Raise levers to couple and uncouple cars for makeup and breakup of trains.","core":true,"importance":4.58,"relevance":94.27,"frequency":6},{"id":23788,"text":"Monitor oil, temperature, and pressure gauges on dashboards to determine if engines are operating safely and efficiently.","core":false,"importance":4.58,"relevance":39.87,"frequency":5.41},{"id":23776,"text":"Pull or push track switches to reroute cars.","core":true,"importance":4.57,"relevance":87.73,"frequency":6.2},{"id":23777,"text":"Observe signals from other crew members so that work activities can be coordinated.","core":true,"importance":4.57,"relevance":86.34,"frequency":5.79},{"id":23787,"text":"Check to see that trains are equipped with supplies such as fuel, water, and sand.","core":false,"importance":4.48,"relevance":46.83,"frequency":5.06},{"id":23801,"text":"Conduct brake tests to determine the condition of brakes on trains.","core":true,"importance":4.46,"relevance":90.13,"frequency":5.36},{"id":23783,"text":"Climb ladders to tops of cars to set brakes.","core":false,"importance":4.45,"relevance":65.46,"frequency":6.04},{"id":23789,"text":"Set flares, flags, lanterns, or torpedoes in front and at rear of trains during emergency stops to warn oncoming trains.","core":false,"importance":4.44,"relevance":51.22,"frequency":3.66},{"id":23778,"text":"Monitor trains as they go around curves to detect dragging equipment and smoking journal boxes.","core":true,"importance":4.42,"relevance":68.93,"frequency":5.8},{"id":23795,"text":"Refuel and lubricate engines.","core":false,"importance":4.4,"relevance":28.26,"frequency":null},{"id":23784,"text":"Receive oral or written instructions from yardmasters or yard conductors indicating track assignments and cars to be switched.","core":true,"importance":4.38,"relevance":87.98,"frequency":5.76},{"id":23780,"text":"Observe tracks from left sides of locomotives to detect obstructions on tracks.","core":true,"importance":4.26,"relevance":91.56,"frequency":5.49},{"id":23790,"text":"Inspect tracks, cars, and engines for defects and to determine service needs, sending engines and cars for repairs as necessary.","core":true,"importance":4.26,"relevance":98.03,"frequency":5.55},{"id":23791,"text":"Start diesel engines to warm engines before runs.","core":false,"importance":4.26,"relevance":42.92,"frequency":n