{"code":"15-1299.03","title":"Document Management Specialists","description":"Implement and administer enterprise-wide document management systems and related procedures that allow organizations to capture, store, retrieve, share, and destroy electronic records and documents.","jobZone":4,"kinds":{"R":{"score":1.75,"share":0.0559},"I":{"score":3.89,"share":0.2155},"A":{"score":1.81,"share":0.0604},"S":{"score":2.29,"share":0.0962},"E":{"score":2.93,"share":0.1439},"C":{"score":6.74,"share":0.428}},"highPoints":["C","I"],"tasks":[{"id":16234,"text":"Assist in determining document management policies to facilitate efficient, legal, and secure access to electronic content.","core":true,"importance":4.68,"relevance":95,"frequency":3.05},{"id":16232,"text":"Assist in the development of document or content classification taxonomies to facilitate information capture, search, and retrieval.","core":true,"importance":4.33,"relevance":95,"frequency":2.89},{"id":16238,"text":"Implement electronic document processing, retrieval, and distribution systems in collaboration with other information technology specialists.","core":true,"importance":4.22,"relevance":95,"frequency":2.58},{"id":16239,"text":"Identify and classify documents or other electronic content according to characteristics such as security level, function, and metadata.","core":true,"importance":4.21,"relevance":95,"frequency":4.26},{"id":16229,"text":"Develop, document, or maintain standards, best practices, or system usage procedures.","core":true,"importance":4.17,"relevance":90,"frequency":3.17},{"id":16233,"text":"Assist in the assessment, acquisition, or deployment of new electronic document management systems.","core":true,"importance":4.16,"relevance":100,"frequency":2.1},{"id":16237,"text":"Administer document and system access rights and revision control to ensure security of system and integrity of master documents.","core":true,"importance":4.14,"relevance":77.78,"frequency":3.14},{"id":16220,"text":"Write, review, or execute plans for testing new or established document management systems.","core":true,"importance":4,"relevance":80,"frequency":2.13},{"id":20368,"text":"Prepare and record changes to official documents and confirm changes with legal and compliance management staff, including enterprise-wide records management staff.","core":true,"importance":4,"relevance":90,"frequency":3.22},{"id":16219,"text":"Monitor regulatory activity to maintain compliance with records and document management laws.","core":true,"importance":3.89,"relevance":90,"frequency":3.22},{"id":16222,"text":"Retrieve electronic assets from repository for distribution to users, collecting and returning to repository, if necessary.","core":true,"importance":3.86,"relevance":70,"frequency":4.93},{"id":20367,"text":"Keep abreast of developments in document management technologies and techniques by reviewing current literature, talking with colleagues, participating in educational programs, attending meetings or workshops, or participating in professional organizations or conferences.","core":true,"importance":3.85,"relevance":100,"frequency":3.35},{"id":16231,"text":"Conduct needs assessments to identify document management requirements of departments or end users.","core":true,"importance":3.84,"relevance":100,"frequency":2.75},{"id":16240,"text":"Develop or configure document management system features, such as user interfaces, access profiles, and document workflow procedures.","core":true,"importance":3.76,"relevance":85,"frequency":2.59},{"id":16228,"text":"Document technical functions and specifications for new or proposed content management systems.","core":true,"importance":3.67,"relevance":78.95,"frequency":2},{"id":16226,"text":"Exercise security surveillance over document processing, reproduction, distribution, storage, or archiving.","core":true,"importance":3.62,"relevance":80,"frequency":3.88},{"id":16230,"text":"Consult with end users regarding problems in accessing electronic content.","core":true,"importance":3.61,"relevance":90,"frequency":3.56},{"id":16223,"text":"Propose recommendations for improving content management system capabilities.","core":true,"importance":3.58,"relevance":100,"frequency":2.7},{"id":16236,"text":"Operate data capture technology to import digitized documents into document management system.","core":true,"importance":3.53,"relevance":75,"frequency":4.33},{"id":16224,"text":"Prepare support documentation and training materials for end users of document management systems.","core":true,"importance":3.44,"relevance":90,"frequency":2.11},{"id":16221,"text":"Search electronic sources, such as databases or repositories, or manual sources for information.","core":true,"importance":3.41,"relevance":85,"frequency":4.29},{"id":16227,"text":"Implement scanning or other automated data entry procedures, using imaging devices and document imaging software.","core":true,"importance":3.38,"relevance":84.21,"frequency":2.56},{"id":16235,"text":"Analyze, interpret, or disseminate system performance data.","core":false,"importance":2.81,"relevance":80,"frequency":2.5}],"activities":[{"id":"4.A.3.b.1","importance":4.55},{"id":"4.A.2.a.3","importance":4.4},{"id":"4.A.1.a.1","importance":4.3},{"id":"4.A.4.a.2","importance":4.3},{"id":"4.A.3.b.6","importance":4.25},{"id":"4.A.2.a.2","importance":4.15},{"id":"4.A.2.b.1","importance":4},{"id":"4.A.4.a.4","importance":3.9},{"id":"4.A.2.b.3","importance":3.89},{"id":"4.A.1.b.1","importance":3.85},{"id":"4.A.2.a.4","importance":3.85},{"id":"4.A.2.b.6","importance":3.8},{"id":"4.A.2.b.4","importance":3.79},{"id":"4.A.4.c.1","importance":3.74},{"id":"4.A.4.b.6","importance":3.65},{"id":"4.A.4.a.1","importance":3.55},{"id":"4.A.4.b.1","importance":3.5},{"id":"4.A.4.b.2","importance":3.5},{"id":"4.A.4.b.3","importance":3.4},{"id":"4.A.1.a.2","importance":3.35},{"id":"4.A.4.b.5","importance":3.35},{"id":"4.A.2.b.5","importance":3.32},{"id":"4.A.4.a.3","importance":3.3},{"id":"4.A.2.b.2","im