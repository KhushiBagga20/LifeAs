{"code":"29-9099.01","title":"Midwives","description":"Provide prenatal care and childbirth assistance.","jobZone":5,"kinds":{"R":{"score":3.98,"share":0.1931},"I":{"score":3.54,"share":0.1646},"A":{"score":1.91,"share":0.059},"S":{"score":6.04,"share":0.3266},"E":{"score":2.7,"share":0.1102},"C":{"score":3.26,"share":0.1465}},"highPoints":["S","R"],"tasks":[{"id":17466,"text":"Monitor maternal condition during labor by checking vital signs, monitoring uterine contractions, or performing physical examinations.","core":true,"importance":4.71,"relevance":97.13,"frequency":4.24},{"id":17479,"text":"Identify tubal and ectopic pregnancies and refer patients for treatments.","core":true,"importance":4.69,"relevance":100,"frequency":1.61},{"id":17486,"text":"Provide necessary medical care for infants at birth, including emergency care such as resuscitation.","core":true,"importance":4.62,"relevance":93.01,"frequency":3.03},{"id":17472,"text":"Conduct ongoing prenatal health assessments, tracking changes in physical and emotional health.","core":true,"importance":4.61,"relevance":100,"frequency":5.53},{"id":17481,"text":"Monitor fetal growth and well-being through heartbeat detection, body measurement, and palpation.","core":true,"importance":4.6,"relevance":100,"frequency":5.53},{"id":17474,"text":"Establish and follow emergency or contingency plans for mothers and newborns.","core":true,"importance":4.59,"relevance":100,"frequency":3.68},{"id":17478,"text":"Identify, monitor, or treat pregnancy-related problems such as hypertension, gestational diabetes, pre-term labor, or retarded fetal growth.","core":true,"importance":4.57,"relevance":100,"frequency":3.74},{"id":17483,"text":"Obtain complete health and medical histories from patients including medical, surgical, reproductive, or mental health histories.","core":true,"importance":4.47,"relevance":100,"frequency":4.34},{"id":17476,"text":"Evaluate patients' laboratory and medical records, requesting assistance from other