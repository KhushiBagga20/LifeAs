{"code":"29-2053.00","title":"Psychiatric Technicians","description":"Care for individuals with mental or emotional conditions or disabilities, following the instructions of physicians or other health practitioners. Monitor patients' physical and emotional well-being and report to medical staff. May participate in rehabilitation and treatment programs, help with personal hygiene, and administer oral or injectable medications.","jobZone":3,"kinds":{"R":{"score":3.29,"share":0.1447},"I":{"score":4.57,"share":0.2255},"A":{"score":2.12,"share":0.0708},"S":{"score":6.93,"share":0.3746},"E":{"score":1.46,"share":0.0291},"C":{"score":3.46,"share":0.1554}},"highPoints":["S","I"],"tasks":[{"id":6945,"text":"Provide nursing, psychiatric, or personal care to patients with cognitive, intellectual, or developmental disabilities.","core":true,"importance":4.74,"relevance":75.12,"frequency":5.86},{"id":6953,"text":"Administer oral medications or hypodermic injections, following physician's prescriptions and hospital procedures.","core":false,"importance":4.59,"relevance":null,"frequency":5.71},{"id":6948,"text":"Encourage patients to develop work skills and to participate in social, recreational, or other therapeutic activities that enhance interpersonal skills or develop social relationships.","core":true,"importance":4.5,"relevance":100,"frequency":5.7},{"id":6951,"text":"Restrain violent, potentially violent, or suicidal patients by verbal or physical means as required.","core":true,"importance":4.48,"relevance":84.86,"frequency":3.97},{"id":6956,"text":"Lead prescribed individual or group therapy sessions as part of specific therapeutic procedures.","core":true,"importance":4.46,"relevance":null,"frequency":4.35},{"id":6954,"text":"Issue medications from dispensary and maintain records in accordance with specified procedures.","core":false,"importance":4.42,"relevance":60.52,"frequency":5.28},{"id":6944,"text":"Monitor patients' physical and emotional well-being and report unu