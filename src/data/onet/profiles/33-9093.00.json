{"code":"33-9093.00","title":"Transportation Security Screeners","description":"Conduct screening of passengers, baggage, or cargo to ensure compliance with Transportation Security Administration (TSA) regulations. May operate basic security equipment such as x-ray machines and hand wands at screening checkpoints.","jobZone":2,"kinds":{"R":{"score":5.21,"share":0.3292},"I":{"score":2.01,"share":0.079},"A":{"score":1,"share":0},"S":{"score":2.45,"share":0.1134},"E":{"score":2.61,"share":0.1259},"C":{"score":5.51,"share":0.3526}},"highPoints":["C","R"],"tasks":[{"id":15341,"text":"Inspect carry-on items, using x-ray viewing equipment, to determine whether items contain objects that warrant further investigation.","core":true,"importance":4.91,"relevance":85.19,"frequency":6.3},{"id":15348,"text":"Search carry-on or checked baggage by hand when it is suspected to contain prohibited items such as weapons.","core":true,"importance":4.8,"relevance":92.59,"frequency":5.6},{"id":15351,"text":"View images of checked bags and cargo, using remote screening equipment, and alert baggage screeners or handlers to any possible problems.","core":false,"importance":4.72,"relevance":66.67,"frequency":6.67},{"id":15332,"text":"Check passengers' tickets to ensure that they are valid, and to determine whether passengers have designations that require special handling, such as providing photo identification.","core":true,"importance":4.71,"relevance":88.89,"frequency":6.08},{"id":15350,"text":"Test baggage for any explosive materials, using equipment such as explosive detection machines or chemical swab systems.","core":true,"importance":4.69,"relevance":100,"frequency":6.37},{"id":15346,"text":"Perform pat-down or hand-held wand searches of passengers who have triggered machine alarms, who are unable to pass through metal detectors, or who have been randomly identified for such searches.","core":true,"importance":4.65,"relevance":85.19,"frequency":6.35},{"id":15345,"text":"Notify supervisors or other appropriate personnel when security breaches occur.","core":true,"importance":4.63,"relevance":100,"frequency":2.37},{"id":15349,"text":"Send checked baggage through automated screening machines, and set bags aside for searching or rescreening as indicated by equipment.","core":true,"importance":4.61,"relevance":85.19,"frequency":6.26},{"id":15337,"text":"Decide whether baggage that triggers alarms should be searched or should be allowed to pass through.","core":true,"importance":4.6,"relevance":74.07,"frequency":6.5},{"id":15343,"text":"Locate suspicious bags pictured in printouts sent from remote monitoring areas, and set these bags aside for inspection.","core":false,"importance":4.58,"relevance":44.44,"frequency":5.67},{"id":15354,"text":"Follow those who breach security until police or other security personnel arrive to apprehend them.","core":true,"importance":4.57,"relevance":85.19,"frequency":1.7},{"id":15339,"text":"Inform other screeners when baggage should not be opened because it might contain explosives.","core":true,"importance":4.52,"relevance":85.19,"frequency":2.96},{"id":15342,"text":"Inspect checked baggage for signs of tampering.","core":true,"importance":4.42,"relevance":88.89,"frequency":6.17},{"id":15331,"text":"Ask passengers to remove shoes and divest themselves of metal objects prior to walking through metal detectors.","core":true,"importance":4.41,"relevance":88.46,"frequency":6.48},{"id":15333,"text":"Close entry areas following security breaches or reopen areas after receiving notification that the airport is secure.","core":true,"importance":4.32,"relevance":81.48,"frequency":2.32},{"id":15353,"text":"Challenge suspicious people, requesting their badges and asking what their business is in a particular areas.","core":true,"importance":4.24,"relevance":92.59,"frequency":3.6},{"id":15355,"text":"Patrol work areas to detect any suspicious items.","core":true,"importance":4.22,"relevance":85.19,"frequency":5},{"id":15336,"text":"Contact police directly in cases of urgent security issues, using phones or two-way radios.","core":true,"importance":4.19,"relevance":77.78,"frequency":2.86},{"id":15347,"text":"Record information about any baggage that sets off alarms in monitoring equipment.","core":true,"importance":4.17,"relevance":88.89,"frequency":5.79},{"id":15352,"text":"Watch for potentially dangerous persons whose pictures are posted at checkpoints.","core":true,"importance":4,"relevance":81.48,"frequency":3.23},{"id":15335,"text":"Contact leads or supervisors to discuss objects of concern that are not on prohibited object lists.","core":true,"importance":3.96,"relevance":100,"frequency":4.85},{"id":15334,"text":"Confiscate dangerous items and hazardous materials found in opened bags and turn them over to airlines for disposal.","core":true,"importance":3.92,"relevance":88.89,"frequency":5.17},{"id":15344,"text":"Monitor passenger flow through screening checkpoints to ensure order and efficiency.","core":true,"importance":3.79,"relevance":74.07,"frequency":6.25},{"id":15340,"text":"Inform passengers of how to mail prohibited items to themselves, or confiscate these items.","core":true,"importance":3.62,"relevance":88.89,"frequency":5.46},{"id":15356,"text":"Provide directions and respond to passenger inquiries.","core":true,"importance":3.38,"relevance":92.59,"frequency":6.12},{"id":15338,"text":"Direct passengers to areas where they can pick up their baggage after screening is complete.","core":true,"importance":3.37,"relevance":70.37,"frequency":6.26}],"activities":[{"id":"4.A.1.a.1","importance":4.22},{"id":"4.A.1.b.1","importance":4.11},{"id":"4.A.4.a.8","importance":4},{"id":"4.A.3.a.1","importance":3.93},{"id":"4.A.4.a.2","importance":3.93},{"id":"4.A.3.a.2","importance":3.89},{"id":"4.A.2.a.3","importance":3.74},{"id":"4.A.2.b.1","importance":3.7},{"id":"4.A.2.b.3","importance":3.59},{"id":"4.A.4.b.3","importance":3.52},{"id":"4.A.1.a.2","importance":3.41},{"id":"4.A.1.b.2","im