{"code":"29-2055.00","title":"Surgical Technologists","description":"Assist in operations, under the supervision of surgeons, registered nurses, or other surgical personnel. May help set up operating room, prepare and transport patients for surgery, adjust lights and equipment, pass instruments and other supplies to surgeons and surgeons' assistants, hold retractors, cut sutures, and help count sponges, needles, supplies, and instruments.","jobZone":3,"kinds":{"R":{"score":6.26,"share":0.3564},"I":{"score":3.22,"share":0.1504},"A":{"score":1,"share":0},"S":{"score":3.82,"share":0.1911},"E":{"score":1.61,"share":0.0413},"C":{"score":4.85,"share":0.2608}},"highPoints":["R","C","S"],"tasks":[{"id":15242,"text":"Maintain a proper sterile field during surgical procedures.","core":true,"importance":5,"relevance":100,"frequency":6.53},{"id":1959,"text":"Count sponges, needles, and instruments before and after operation.","core":true,"importance":4.98,"relevance":99.83,"frequency":6.46},{"id":1960,"text":"Hand instruments and supplies to surgeons and surgeons' assistants, hold retractors and cut sutures, and perform other tasks as directed by surgeon during operation.","core":true,"importance":4.92,"relevance":100,"frequency":6.58},{"id":1961,"text":"Scrub arms and hands and assist the surgical team to scrub and put on gloves, masks, and surgical clothing.","core":true,"importance":4.91,"relevance":95.8,"frequency":6.5},{"id":1964,"text":"Wash and sterilize equipment, using germicides and sterilizers.","core":true,"importance":4.9,"relevance":80.53,"frequency":5.5},{"id":15243,"text":"Prepare patients for surgery, including positioning patients on the operating table and covering them with sterile surgical drapes to prevent exposure.","core":true,"importance":4.85,"relevance":100,"frequency":6.4},{"id":24037,"text":"Schedule surgical procedures for patients.","core":false,"importance":4.79,"relevance":35.98,"frequency":null},{"id":1965,"text":"Prepare, care for, and dispose