{"code":"53-5011.00","title":"Sailors and Marine Oilers","description":"Stand watch to look for obstructions in path of vessel, measure water depth, turn wheel on bridge, or use emergency equipment as directed by captain, mate, or pilot. Break out, rig, overhaul, and store cargo-handling gear, stationary rigging, and running gear. Perform a variety of maintenance tasks to preserve the painted surface of the ship and to maintain line and ship equipment. Must hold government-issued certification and tankerman certification when working aboard liquid-carrying vessels. Includes able seamen and ordinary seamen.","jobZone":2,"kinds":{"R":{"score":6.97,"share":0.4893},"I":{"score":2.62,"share":0.1328},"A":{"score":1,"share":0},"S":{"score":1.24,"share":0.0197},"E":{"score":2.41,"share":0.1156},"C":{"score":3.96,"share":0.2426}},"highPoints":["R","C"],"tasks":[{"id":14457,"text":"Maintain government-issued certifications, as required.","core":true,"importance":4.51,"relevance":97.87,"frequency":2.38},{"id":14461,"text":"Handle lines to moor vessels to wharfs, to tie up vessels to other vessels, or to rig towing lines.","core":true,"importance":4.42,"relevance":99.19,"frequency":5.22},{"id":14458,"text":"Lower and man lifeboats when emergencies occur.","core":false,"importance":4.31,"relevance":51.78,"frequency":null},{"id":14462,"text":"Stand watch in ships' bows or bridge wings to look for obstructions in a ship's path or to locate navigational aids, such as buoys or lighthouses.","core":true,"importance":4.29,"relevance":78.88,"frequency":4.02},{"id":14460,"text":"Steer ships under the direction of commanders or navigating officers or direct helmsmen to steer, following designated courses.","core":false,"importance":4.23,"relevance":37.77,"frequency":null},{"id":14482,"text":"Tie barges together into tow units for tugboats to handle, inspecting barges periodically during voyages and disconnecting them when destinations are reached.","core":false,"importance":4.13,"relevance":59.67,"frequency":4.2},{"id":14464,"text":"Overhaul lifeboats or lifeboat gear and lower or raise lifeboats with winches or falls.","core":false,"importance":4.07,"relevance":36.24,"frequency":null},{"id":14476,"text":"Examine machinery to verify specified pressures or lubricant flows.","core":false,"importance":4.02,"relevance":66.16,"frequency":4.36},{"id":14475,"text":"Read pressure and temperature gauges or displays and record data in engineering logs.","core":false,"importance":3.89,"relevance":64.35,"frequency":4.81},{"id":14479,"text":"Attach hoses and operate pumps to transfer substances to and from liquid cargo tanks.","core":false,"importance":3.89,"relevance":65.3,"frequency":null},{"id":14469,"text":"Splice and repair ropes, wire cables, or cordage, using marlinespikes, wire cutters, twine, and hand tools.","core":true,"importance":3.87,"relevance":98.45,"frequency":3.19},{"id":20935,"text":"Record data in ships' logs, such as weather conditions or distances traveled.","core":false,"importance":3.73,"relevance":39.13,"frequency":4.96},{"id":14468,"text":"Break out, rig, and stow cargo-handling gear, stationary rigging, or running gear.","core":false,"importance":3.71,"relevance":66.35,"frequency":null},{"id":20934,"text":"Load or unload materials, vehicles, or passengers from vessels.","core":false,"importance":3.64,"relevance":63.93,"frequency":3.42},{"id":14480,"text":"Maintain a ship's engines under the direction of the ship's engineering officers.","core":false,"importance":3.57,"relevance":40.08,"frequency":3.81},{"id":14465,"text":"Operate, maintain, or repair ship equipment, such as winches, cranes, derricks, or weapons system.","core":true,"importance":3.52,"relevance":69.11,"frequency":3.5},{"id":14472,"text":"Sweep, mop, and wash down decks to remove oil, dirt, and debris, using brooms, mops, brushes, and hoses.","core":true,"importance":3.47,"relevance":100,"frequency":4.28},{"id":14467,"text":"Lubricate machinery, equipment, or engine parts, such as gears, shafts, or bearings.","core":true,"importance":3.44,"relevance":75.7,"frequency":3.66},{"id":14477,"text":"Measure depth of water in shallow or unfamiliar waters, using leadlines, and telephone or shout depth information to vessel bridges.","core":false,"importance":3.36,"relevance":31.33,"frequency":null},{"id":14473,"text":"Chip and clean rust spots on decks, superstructures, or sides of ships, using wire brushes and hand or air chipping machines.","core":true,"importance":3.21,"relevance":92.11,"frequency":3.25},{"id":14471,"text":"Paint or varnish decks, superstructures, lifeboats, or sides of ships.","core":true,"importance":3.13,"relevance":90.96,"frequency":null},{"id":14470,"text":"Provide engineers with assistance in repairing or adjusting machinery.","core":true,"importance":3.03,"relevance":100,"frequency":3.09},{"id":14474,"text":"Give directions to crew members engaged in cleaning wheelhouses or quarterdecks.","core":false,"importance":2.99,"relevance":null,"frequency":3.53},{"id":14484,"text":"Clean and polish wood trim, brass, or other metal parts.","core":false,"importance":2.66,"relevance":89.97,"frequency":3.45}],"activities":[{"id":"4.A.1.b.2","importance":4.25},{"id":"4.A.1.b.1","importance":4.22},{"id":"4.A.3.a.4","importance":4.21},{"id":"4.A.3.a.2","importance":4.16},{"id":"4.A.4.a.2","importance":4},{"id":"4.A.3.a.1","importance":3.93},{"id":"4.A.1.a.2","importance":3.86},{"id":"4.A.1.a.1","importance":3.79},{"id":"4.A.2.b.3","importance":3.79},{"id":"4.A.3.a.3","importance":3.78},{"id":"4.A.2.b.6","importance":3.69},{"id":"4.A.2.a.3","importance":3.68},{"id":"4.A.1.b.3","importance":3.6},{"id":"4.A.2.b.1","importance":3.59},{"id":"4.A.2.a.2","importance":3.54},{"id":"4.A.2.a.1","importance":3.5},{"id":"4.A.3.b.4","importance":3.48},{"id":"4.A.4.a.7","importance":3.32},{"id":"4.A.4.b.3","importance":3.31},{"id":"4.A.4.b.1","importance":3.23},{"id":"4.A.3.b.6","importance":3.22},{"id":"4.A.4.a.4","importance":3.18},{"id":"4.