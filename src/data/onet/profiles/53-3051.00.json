{"code":"53-3051.00","title":"Bus Drivers, School","description":"Drive a school bus to transport students. Ensure adherence to safety rules. May assist students in boarding or exiting.","jobZone":2,"kinds":{"R":{"score":5.5,"share":0.3297},"I":{"score":1.61,"share":0.0447},"A":{"score":1.21,"share":0.0154},"S":{"score":4.45,"share":0.2527},"E":{"score":2.18,"share":0.0864},"C":{"score":4.7,"share":0.2711}},"highPoints":["R","C","S"],"tasks":[{"id":23716,"text":"Comply with traffic regulations to operate vehicles in a safe and courteous manner.","core":true,"importance":4.98,"relevance":100,"frequency":5.89},{"id":23719,"text":"Follow safety rules as students board and exit buses or cross streets near bus stops.","core":true,"importance":4.94,"relevance":99.52,"frequency":5.65},{"id":23715,"text":"Check the condition of a vehicle's tires, brakes, windshield wipers, lights, oil, fuel, water, and safety equipment to ensure that everything is in working order.","core":true,"importance":4.93,"relevance":100,"frequency":5.27},{"id":23729,"text":"Report any bus malfunctions or needed repairs.","core":true,"importance":4.87,"relevance":100,"frequency":3.72},{"id":23724,"text":"Pick up and drop off students at regularly scheduled neighborhood locations, following strict time schedules.","core":true,"importance":4.78,"relevance":95.53,"frequency":5.62},{"id":23718,"text":"Escort small children across roads and highways.","core":true,"importance":4.77,"relevance":70.43,"frequency":4.38},{"id":23717,"text":"Drive gasoline, diesel, or electrically powered multi-passenger vehicles to transport students between neighborhoods, schools, and school activities.","core":true,"importance":4.71,"relevance":100,"frequency":5.48},{"id":23722,"text":"Maintain order among students during trips to ensure safety.","core":true,"importance":4.59,"relevance":100,"frequency":5.4},{"id":23721,"text":"Maintain knowledge of first-aid procedures.","core":true,"importance":4.47,"relevance":96.97,"freq