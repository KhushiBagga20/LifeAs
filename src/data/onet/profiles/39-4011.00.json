{"code":"39-4011.00","title":"Embalmers","description":"Prepare bodies for interment in conformity with legal requirements.","jobZone":3,"kinds":{"R":{"score":5.84,"share":0.3477},"I":{"score":2.57,"share":0.1128},"A":{"score":1.61,"share":0.0438},"S":{"score":3.4,"share":0.1724},"E":{"score":2.65,"share":0.1185},"C":{"score":3.85,"share":0.2047}},"highPoints":["R","C","S"],"tasks":[{"id":4487,"text":"Conform to laws of health and sanitation and ensure that legal requirements concerning embalming are met.","core":true,"importance":4.85,"relevance":100,"frequency":4.84},{"id":4488,"text":"Apply cosmetics to impart lifelike appearance to the deceased.","core":true,"importance":4.74,"relevance":97.97,"frequency":4.49},{"id":4495,"text":"Join lips, using needles and thread or wire.","core":true,"importance":4.74,"relevance":96.75,"frequency":4.25},{"id":4489,"text":"Incise stomach and abdominal walls and probe internal organs, using trocar, to withdraw blood and waste matter from organs.","core":true,"importance":4.67,"relevance":98.97,"frequency":4.33},{"id":4490,"text":"Close incisions, using needles and sutures.","core":true,"importance":4.67,"relevance":100,"frequency":4.4},{"id":23930,"text":"Clean and disinfect areas in which bodies are prepared and embalmed.","core":true,"importance":4.66,"relevance":100,"frequency":4.32},{"id":4493,"text":"Dress bodies and place them in caskets.","core":true,"importance":4.65,"relevance":98.9,"frequency":4.57},{"id":4492,"text":"Make incisions in arms or thighs and drain blood from circulatory system and replace it with embalming fluid, using pump.","core":true,"importance":4.63,"relevance":95.94,"frequency":4.06},{"id":20257,"text":"Remove the deceased from place of death and transport to funeral home.","core":true,"importance":4.61,"relevance":100,"frequency":4.55},{"id":4494,"text":"Perform the duties of funeral directors, including coordinating funeral activities.","core":true,"importance":4.57,"relevance":91.96,"frequency":4.27},{"id":4497,"text":"Attach trocar to pump-tube, start pump, and repeat probing to force embalming fluid into organs.","core":true,"importance":4.54,"relevance":92.61,"frequency":4.05},{"id":4491,"text":"Reshape or reconstruct disfigured or maimed bodies when necessary, using dermasurgery techniques and materials such as clay, cotton, plaster of Paris, and wax.","core":true,"importance":4.52,"relevance":100,"frequency":2.22},{"id":4504,"text":"Pack body orifices with cotton saturated with embalming fluid to prevent escape of gases or waste matter.","core":true,"importance":4.52,"relevance":94.87,"frequency":3.07},{"id":4496,"text":"Conduct interviews to arrange for the preparation of obituary notices, to assist with the selection of caskets or urns, and to determine the location and time of burials or cremations.","core":true,"importance":4.51,"relevance":88.25,"frequency":4.1},{"id":4500,"text":"Insert convex celluloid or cotton between eyeballs and eyelids to prevent slipping and sinking of eyelids.","core":true,"importance":4.49,"relevance":95.94,"frequency":4.23},{"id":4505,"text":"Assist with placing caskets in hearses and organize cemetery processions.","core":true,"importance":4.38,"relevance":92.98,"frequency":3.96},{"id":4499,"text":"Maintain records, such as itemized lists of clothing or valuables delivered with body and names of persons embalmed.","core":true,"importance":4.35,"relevance":100,"frequency":4.85},{"id":4501,"text":"Wash and dry bodies, using germicidal soap and towels or hot air dryers.","core":true,"importance":4.31,"relevance":100,"frequency":4.65},{"id":4502,"text":"Arrange for transporting the deceased to another state for interment.","core":true,"importance":4.27,"relevance":94.63,"frequency":2.46},{"id":4498,"text":"Perform special procedures necessary for remains that are to be transported to other states or overseas, or where death was caused by infectious disease.","core":true,"importance":4.21,"relevance":100,"frequency":2.41},{"id":4503,"text":"Supervise funeral attendants and other funeral home staff.","core":true,"importance":4.18,"relevance":75.64,"frequency":4.12},{"id":4506,"text":"Serve as pallbearers, attend visiting rooms, and provide other assistance to the bereaved.","core":true,"importance":4.16,"relevance":89.55,"frequency":3.9},{"id":4507,"text":"Direct casket and floral display placement and arrange guest seating.","core":true,"importance":4.1,"relevance":88.54,"frequency":4.04},{"id":4508,"text":"Arrange funeral home equipment and perform general maintenance.","core":true,"importance":4,"relevance":81.69,"frequency":4.62},{"id":4509,"text":"Assist coroners at death scenes or at autopsies, file police reports, and testify at inquests or in court, if employed by a coroner.","core":false,"importance":3.58,"relevance":44.61,"frequency":null},{"id":4510,"text":"Press diaphragm to evacuate air from lungs.","core":false,"importance":2.89,"relevance":42.75,"frequency":3.02}],"activities":[{"id":"4.A.4.a.5","importance":4.55},{"id":"4.A.3.b.6","importance":4.41},{"id":"4.A.2.b.1","importance":4.3},{"id":"4.A.3.a.2","importance":4.3},{"id":"4.A.1.a.1","importance":4.16},{"id":"4.A.2.a.3","importance":4.04},{"id":"4.A.2.b.3","importance":4},{"id":"4.A.2.a.2","importance":3.95},{"id":"4.A.1.b.1","importance":3.93},{"id":"4.A.4.a.8","importance":3.9},{"id":"4.A.4.a.3","importance":3.85},{"id":"4.A.4.a.4","importance":3.84},{"id":"4.A.4.a.2","importance":3.82},{"id":"4.A.1.a.2","importance":3.8},{"id":"4.A.2.b.6","importance":3.7},{"id":"4.A.3.a.1","importance":3.68},{"id":"4.A.3.a.4","importance":3.63},{"id":"4.A.2.a.1","importance":3.52},{"id":"4.A.1.b.2","importance":3.37},{"id":"4.A.3.b.1","importance":3.35},{"id":"4.A.2.b.2","importance":3.27},{"id":"4.A.3.a.3","importance":3.27},{"id":"4.A.4.c.1","importance":3.18},{"id":"4.A.2.b.5","importance":3.14},{"id":"4.A.1.b.3","importance":3.08},{"id":"4.A.4.b.1","importance":3.06},{"id":"4.A.2.a.4","importance":2.96},{"id":"4.A.2.b.4","i