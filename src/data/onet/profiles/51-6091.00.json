{"code":"51-6091.00","title":"Extruding and Forming Machine Setters, Operators, and Tenders, Synthetic and Glass Fibers","description":"Set up, operate, or tend machines that extrude and form continuous filaments from synthetic materials, such as liquid polymer, rayon, and fiberglass.","jobZone":2,"kinds":{"R":{"score":6.5,"share":0.5159},"I":{"score":2.21,"share":0.1135},"A":{"score":1.27,"share":0.0253},"S":{"score":1.22,"share":0.0206},"E":{"score":1.41,"share":0.0385},"C":{"score":4.05,"share":0.2861}},"highPoints":["R","C"],"tasks":[{"id":14208,"text":"Set up, operate, or tend machines that extrude and form filaments from synthetic materials such as rayon, fiberglass, or liquid polymers.","core":true,"importance":4.27,"relevance":81.9,"frequency":5.35},{"id":14214,"text":"Press buttons to stop machines when processes are complete or when malfunctions are detected.","core":true,"importance":4.26,"relevance":96.06,"frequency":4.67},{"id":14213,"text":"Notify other workers of defects, and direct them to adjust extruding and forming machines.","core":true,"importance":4.25,"relevance":92.85,"frequency":4.99},{"id":14215,"text":"Observe flow of finish across finish rollers, and turn valves to adjust flow to specifications.","core":false,"importance":4.25,"relevance":63.7,"frequency":5.28},{"id":14216,"text":"Observe machine operations, control boards, and gauges to detect malfunctions such as clogged bushings and defective binder applicators.","core":true,"importance":4.15,"relevance":87.83,"frequency":5.69},{"id":14219,"text":"Remove polymer deposits from spinnerettes and equipment, using silicone spray, brass chisels, and bronze-wool pads.","core":false,"importance":4.04,"relevance":62.7,"frequency":5.16},{"id":14209,"text":"Load materials into extruding and forming machines, using hand tools, and adjust feed mechanisms to set feed rates.","core":true,"importance":4.03,"relevance":70.57,"frequency":5.74},{"id":14218,"text":"Press metering-pump buttons and turn valves to stop flow of polymers.","core":false,"importance":3.94,"relevance":58.02,"frequency":5.06},{"id":14224,"text":"Record operational data on tags, and attach tags to machines.","core":false,"importance":3.94,"relevance":54.8,"frequency":5.27},{"id":14211,"text":"Move controls to activate and adjust extruding and forming machines.","core":true,"importance":3.92,"relevance":87.36,"frequency":5.28},{"id":14210,"text":"Start metering pumps and observe operation of machines and equipment to ensure continuous flow of filaments extruded through spinnerettes and to detect processing defects.","core":false,"importance":3.91,"relevance":63.71,"frequency":4.92},{"id":14207,"text":"Remove excess, entangled, or completed filaments from machines, using hand tools.","core":false,"importance":3.85,"relevance":63.7,"frequency":4.99},{"id":14212,"text":"Record details of machine malfunctions.","core":true,"importance":3.84,"relevance":94.72,"frequency":5.04},{"id":14227,"text":"Wipe finish rollers with cloths and wash finish trays with water when necessary.","core":false,"importance":3.82,"relevance":52.54,"frequency":4.67},{"id":14220,"text":"Clean and maintain extruding and forming machines, using hand tools.","core":true,"importance":3.69,"relevance":83.67,"frequency":4.66},{"id":14225,"text":"Lower pans inside cabinets to catch molten filaments until flow of polymer through packs has stopped.","core":false,"importance":3.63,"relevance":43.46,"frequency":4.06},{"id":14217,"text":"Open cabinet doors to cut multifilament threadlines away from guides, using scissors.","core":false,"importance":3.28,"relevance":30.23,"frequency":null}],"activities":[{"id":"4.A.1.a.1","importance":4.42},{"id":"4.A.1.a.2","importance":4.41},{"id":"4.A.3.a.3","importance":4.38},{"id":"4.A.1.b.1","importance":4.16},{"id":"4.A.1.b.2","importance":4.16},{"id":"4.A.3.a.4","importance":4.06},{"id":"4.A.3.a.2","importance":3.89},{"id":"4.A.2.b.1","importance":3.88},{"id":"4.A.2.a.1","importance":3.84},{"id