{"code":"53-2021.00","title":"Air Traffic Controllers","description":"Control air traffic on and within vicinity of airport, and movement of air traffic between altitude sectors and control centers, according to established procedures and policies. Authorize, regulate, and control commercial airline flights according to government or company regulations to expedite and ensure flight safety.","jobZone":3,"kinds":{"R":{"score":4.55,"share":0.2543},"I":{"score":2.45,"share":0.1039},"A":{"score":1,"share":0},"S":{"score":2.68,"share":0.1203},"E":{"score":4.29,"share":0.2357},"C":{"score":4.99,"share":0.2858}},"highPoints":["C","R","E"],"tasks":[{"id":12731,"text":"Inform pilots about nearby planes or potentially hazardous conditions, such as weather, speed and direction of wind, or visibility problems.","core":true,"importance":4.98,"relevance":100,"frequency":6.8},{"id":12730,"text":"Monitor aircraft within a specific airspace, using radar, computer equipment, or visual references.","core":true,"importance":4.89,"relevance":100,"frequency":6.98},{"id":24061,"text":"Monitor, direct, or sequence the movement of aircraft within an assigned air space or on the ground at airports to minimize delays and maximize safety.","core":true,"importance":4.88,"relevance":100,"frequency":6.96},{"id":12733,"text":"Alert airport emergency services in cases of emergency or when aircraft are experiencing difficulties.","core":true,"importance":4.86,"relevance":100,"frequency":null},{"id":12738,"text":"Maintain radio or telephone contact with adjacent control towers, terminal control units, or other area control centers to coordinate aircraft movement.","core":true,"importance":4.84,"relevance":100,"frequency":6.97},{"id":12735,"text":"Transfer control of departing flights to traffic control centers and accept control of arriving flights.","core":true,"importance":4.78,"relevance":91.84,"frequency":6.95},{"id":12732,"text":"Provide flight path changes or directions to emergency landing fie