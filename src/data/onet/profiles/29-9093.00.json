{"code":"29-9093.00","title":"Surgical Assistants","description":"Assist in operations, under the supervision of surgeons. May, in accordance with state laws, help surgeons to make incisions and close surgical sites, manipulate or remove tissues, implant surgical devices or drains, suction the surgical site, place catheters, clamp or cauterize vessels or tissue, and apply dressings to surgical site.","jobZone":3,"kinds":{"R":{"score":5.7,"share":0.3317},"I":{"score":3.45,"share":0.1729},"A":{"score":1,"share":0},"S":{"score":3.84,"share":0.2004},"E":{"score":1.78,"share":0.055},"C":{"score":4.4,"share":0.2399}},"highPoints":["R","C","S"],"tasks":[{"id":19299,"text":"Monitor and maintain aseptic technique throughout procedures.","core":true,"importance":4.88,"relevance":100,"frequency":6.31},{"id":19298,"text":"Maintain an unobstructed operative field, using surgical retractors, sponges, or suctioning and irrigating equipment.","core":true,"importance":4.82,"relevance":100,"frequency":5.78},{"id":19312,"text":"Pass instruments or supplies to surgeon during procedure.","core":true,"importance":4.76,"relevance":100,"frequency":6.12},{"id":19305,"text":"Assist with patient resuscitation during cardiac arrest or other life-threatening events.","core":true,"importance":4.73,"relevance":88.98,"frequency":2.32},{"id":19315,"text":"Verify the identity of patient or operative site.","core":true,"importance":4.69,"relevance":94.17,"frequency":5.64},{"id":19310,"text":"Obtain or inspect sterile or non-sterile surgical equipment, instruments, or supplies.","core":true,"importance":4.67,"relevance":97.32,"frequency":5.89},{"id":19292,"text":"Assist members of surgical team with gowning or gloving.","core":true,"importance":4.66,"relevance":99.55,"frequency":5.97},{"id":19294,"text":"Coordinate or participate in the positioning of patients, using body stabilizing equipment or protective padding to provide appropriate exposure for the procedure or to protect against nerve damage or circulation impairment.","core":true,"importance":4.65,"relevance":98.8,"frequency":5.72},{"id":19306,"text":"Cover patients with surgical drapes to create and maintain a sterile operative field.","core":true,"importance":4.65,"relevance":97.32,"frequency":6.01},{"id":19307,"text":"Determine availability of necessary equipment or supplies for operative procedures.","core":true,"importance":4.58,"relevance":99.25,"frequency":6.04},{"id":19308,"text":"Gather, arrange, or assemble instruments or supplies.","core":true,"importance":4.57,"relevance":100,"frequency":5.73},{"id":19311,"text":"Operate sterilizing devices.","core":true,"importance":4.56,"relevance":80.41,"frequency":4.82},{"id":19293,"text":"Clamp, ligate, or cauterize blood vessels to control bleeding during surgical entry, using hemostatic clamps, suture ligatures, or electrocautery equipment.","core":true,"importance":4.5,"relevance":77,"frequency":5.28},{"id":19300,"text":"Monitor patient intra-operative status, including patient position, vital signs, or volume and color of blood.","core":false,"importance":4.5,"relevance":61.9,"frequency":5.93},{"id":19302,"text":"Prepare and apply sterile wound dressings.","core":true,"importance":4.49,"relevance":99.55,"frequency":5.96},{"id":19296,"text":"Discuss with surgeon the nature of the surgical procedure, including operative consent, methods of operative exposure, diagnostic or laboratory data, or patient-advanced directives or other needs.","core":false,"importance":4.48,"relevance":66,"frequency":5.55},{"id":19290,"text":"Assess skin integrity or other body conditions upon completion of the procedure to determine if damage has occurred from body positioning.","core":true,"importance":4.45,"relevance":90.53,"frequency":5.99},{"id":19289,"text":"Apply sutures, staples, clips, or other materials to close skin, facia, or subcutaneous wound layers.","core":true,"importance":4.44,"relevance":73.43,"frequency":5.7},{"id":19295,"text":"Coordinate with anesthesia personnel to maintain patient temperature.","core":false,"importance":4.35,"relevance":59.96,"frequency":5.74},{"id":19291,"text":"Assist in the insertion, positioning, or suturing of closed-wound drainage systems.","core":true,"importance":4.32,"relevance":69.52,"frequency":5.12},{"id":19288,"text":"Adjust and maintain operating room temperature, humidity, or lighting, according to surgeon's specifications.","core":true,"importance":4.2,"relevance":85.96,"frequency":5.11},{"id":19297,"text":"Incise tissue layers in lower extremities to harvest veins.","core":false,"importance":4.2,"relevance":41.61,"frequency":null},{"id":19303,"text":"Assist in applying casts, splints, braces, or similar devices.","core":true,"importance":4.17,"relevance":91.03,"frequency":4.95},{"id":19301,"text":"Postoperatively inject a subcutaneous local anesthetic agent to reduce pain.","core":false,"importance":4.15,"relevance":42.03,"frequency":null},{"id":19309,"text":"Insert or remove urinary bladder catheters.","core":false,"importance":4.12,"relevance":64.63,"frequency":4},{"id":19313,"text":"Remove patient hair or disinfect incision sites to prepare patient for surgery.","core":true,"importance":4.12,"relevance":69.25,"frequency":5.15},{"id":19304,"text":"Assist in volume replacement or autotransfusion techniques.","core":false,"importance":3.84,"relevance":35.35,"frequency":null},{"id":19314,"text":"Transport patients to operating room.","core":false,"importance":3.59,"relevance":48.99,"frequency":null}],"activities":[{"id":"4.A.4.a.5","importance":4.97},{"id":"4.A.1.b.1","importance":4.61},{"id":"4.A.2.b.1","importance":4.54},{"id":"4.A.1.a.2","importance":4.52},{"id":"4.A.1.a.1","importance":4.47},{"id":"4.A.4.a.2","importance":4.4},{"id":"4.A.4.a.4","importance":4.4},{"id":"4.A.1.b.2","importance":4.33},{"id":"4.A.3.a.1","importance":4.33},{"id":"4.A.3.a.2","importance":4.33},{"id":"4.A.2.b.3","importance":4.27},{"id":"4.A.2.a.3","importance":4.13},{"id":"4.A.2.b.6","importance":3.