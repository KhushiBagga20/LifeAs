{"code":"51-9124.00","title":"Coating, Painting, and Spraying Machine Setters, Operators, and Tenders","description":"Set up, operate, or tend spraying or rolling machines to coat or paint any of a wide variety of products, including glassware, cloth, ceramics, metal, plastic, paper, or wood, with lacquer, silver, copper, rubber, varnish, glaze, enamel, oil, or rust-proofing materials. Includes painters of transportation vehicles such as painters in auto body repair facilities.","jobZone":2,"kinds":{"R":{"score":6.98,"share":0.5695},"I":{"score":1.49,"share":0.0467},"A":{"score":2.11,"share":0.1057},"S":{"score":1.23,"share":0.0219},"E":{"score":1.05,"share":0.0048},"C":{"score":3.64,"share":0.2514}},"highPoints":["R","C"],"tasks":[{"id":23656,"text":"Dispose of hazardous waste in an appropriate manner.","core":true,"importance":4.42,"relevance":96.67,"frequency":5.11},{"id":12522,"text":"Hold or position spray guns to direct spray onto articles.","core":true,"importance":4.41,"relevance":87.79,"frequency":6.13},{"id":23664,"text":"Spray prepared surfaces with specified amounts of primers and decorative or finish coatings.","core":true,"importance":4.3,"relevance":86.45,"frequency":5.43},{"id":23659,"text":"Monitor painting operations to identify flaws, such as blisters or streaks, and correct their causes.","core":true,"importance":4.29,"relevance":87.97,"frequency":5.46},{"id":12513,"text":"Fill hoppers, reservoirs, troughs, or pans with material used to coat, paint, or spray, using conveyors or pails.","core":true,"importance":4.28,"relevance":70.13,"frequency":5.31},{"id":23655,"text":"Disassemble, clean, and reassemble sprayers or power equipment, using solvents, wire brushes, and cloths.","core":true,"importance":4.28,"relevance":70.77,"frequency":5.61},{"id":12516,"text":"Thread or feed items or products through or around machine rollers and dryers.","core":false,"importance":4.26,"relevance":25.59,"frequency":null},{"id":23654,"text":"Clean equipment and work areas.","core":true,"importance":4.26,"relevance":100,"frequency":5.72},{"id":12505,"text":"Weigh or measure chemicals, coatings, or paints before adding them to machines.","core":false,"importance":4.18,"relevance":58.54,"frequency":5.17},{"id":12509,"text":"Start and stop operation of machines, using levers or buttons.","core":true,"importance":4.15,"relevance":71.51,"frequency":5.46},{"id":23652,"text":"Apply rust-resistant undercoats and caulk and seal seams.","core":true,"importance":4.15,"relevance":71.47,"frequency":5.29},{"id":12512,"text":"Operate auxiliary machines or equipment used in coating or painting processes.","core":false,"importance":4.07,"relevance":60.42,"frequency":5.41},{"id":12518,"text":"Remove materials, parts, or workpieces from painting or coating machines, using hand tools.","core":false,"importance":4.07,"relevance":40.41,"frequency":null},{"id":12504,"text":"Determine paint flow, viscosity, and coating quality by performing visual inspections, or by using viscometers.","core":true,"importance":4.06,"relevance":76.87,"frequency":5.26},{"id":12517,"text":"Attach hoses or nozzles to machines, using wrenches and pliers, and make adjustments to obtain the proper dispersion of spray.","core":true,"importance":4.05,"relevance":73.82,"frequency":5.31},{"id":12508,"text":"Turn dials, handwheels, valves, or switches to regulate conveyor speeds, machine temperature, air pressure and circulation, and the flow or spray of coatings or paints.","core":true,"importance":4.04,"relevance":86.69,"frequency":5.46},{"id":12510,"text":"Record operational data on specified forms.","core":false,"importance":4.03,"relevance":50.18,"frequency":5.26},{"id":23660,"text":"Operate lifting or moving devices to move equipment or materials to access areas to be painted.","core":false,"importance":3.98,"relevance":66.97,"frequency":5.09},{"id":12503,"text":"Observe machine gauges and equipment operation to detect defects or deviations from standards, and make adjustments as necessary.","core":true,"importance":3.95,"relevance":75.14,"frequency":5.41},{"id":23663,"text":"Set up portable equipment, such as ventilators, exhaust units, ladders, or scaffolding.","core":false,"importance":3.87,"relevance":57.69,"frequency":4.71},{"id":12521,"text":"Examine, measure, weigh, or test sample products to ensure conformance to specifications.","core":true,"importance":3.84,"relevance":83.2,"frequency":5.32},{"id":23653,"text":"Buff and wax the finished paintwork.","core":true,"importance":3.75,"relevance":71.84,"frequency":4.3},{"id":23665,"text":"Use brush to hand-paint areas in need of retouching or unreachable with a spray gun.","core":true,"importance":3.59,"relevance":94.54,"frequency":4.03},{"id":23650,"text":"Adjust controls on infrared ovens, heat lamps, portable ventilators, or exhaust units to speed the drying of surfaces between coats.","core":true,"importance":null,"relevance":null,"frequency":null},{"id":23651,"text":"Apply primer over any repairs made to surfaces.","core":true,"importance":null,"relevance":null,"frequency":null},{"id":23657,"text":"Fill small dents or scratches with body fillers and smooth surfaces to prepare for painting.","core":true,"importance":null,"relevance":null,"frequency":null},{"id":23658,"text":"Mix paints to match color specifications or original colors, stirring or thinning paints, using spatulas or power mixing equipment.","core":true,"importance":null,"relevance":null,"frequency":null},{"id":23661,"text":"Remove grease, dirt, paint, or rust from surfaces in preparation for paint application, using abrasives, solvents, brushes, blowtorches, washing tanks, or sandblasters.","core":true,"importance":null,"relevance":null,"frequency":null},{"id":23662,"text":"Sand and apply sealer to properly dried finish.","core":true,"importance":null,"relevance":null,"frequency":null}],"activities":[{"id":"4.A.1.a.1","importance":4.27},{"id":"4.A.1.b.1","importance":4.21},{"id":"4.A.1.b.2","importance":4.15},{"