{"code":"47-4031.00","title":"Fence Erectors","description":"Erect and repair fences and fence gates, using hand and power tools.","jobZone":2,"kinds":{"R":{"score":7,"share":0.5736},"I":{"score":2.08,"share":0.1033},"A":{"score":1.35,"share":0.0335},"S":{"score":1.35,"share":0.0335},"E":{"score":1,"share":0},"C":{"score":3.68,"share":0.2562}},"highPoints":["R","C"],"tasks":[{"id":13623,"text":"Establish the location for a fence, and gather information needed to ensure that there are no electric cables or water lines in the area.","core":true,"importance":4.43,"relevance":99.11,"frequency":null},{"id":13627,"text":"Set metal or wooden posts in upright positions in postholes.","core":true,"importance":4.4,"relevance":98.71,"frequency":5.29},{"id":13625,"text":"Measure and lay out fence lines and mark posthole positions, following instructions, drawings, or specifications.","core":true,"importance":4.38,"relevance":98.71,"frequency":4.94},{"id":13624,"text":"Align posts, by lines or sighting, and verify vertical alignment of posts, using plumb bobs or spirit levels.","core":true,"importance":4.36,"relevance":97.26,"frequency":5.12},{"id":13637,"text":"Attach rails or tension wire along bottoms of posts to form fencing frames.","core":true,"importance":4.25,"relevance":97.32,"frequency":5},{"id":13626,"text":"Dig postholes, using spades, posthole diggers, or power-driven augers.","core":true,"importance":4.15,"relevance":97.94,"frequency":5.09},{"id":13633,"text":"Attach fence rail supports to posts, using hammers and pliers.","core":true,"importance":4.12,"relevance":96.29,"frequency":5.3},{"id":13629,"text":"Mix and pour concrete around bases of posts, or tamp soil into postholes to embed posts.","core":true,"importance":4.11,"relevance":98.35,"frequency":4.83},{"id":13634,"text":"Assemble gates, and fasten gates into position, using hand tools.","core":true,"importance":4.11,"relevance":99.23,"frequency":4.62},{"id":13630,"text":"Make rails for fences, by sawing lumber or by cutting metal tubing to required lengths.","core":true,"importance":4.09,"relevance":98.92,"frequency":4.68},{"id":13631,"text":"Nail top and bottom rails to fence posts, or insert them in slots on posts.","core":true,"importance":4.08,"relevance":96.8,"frequency":4.65},{"id":13628,"text":"Discuss fencing needs with customers, and estimate and quote prices.","core":true,"importance":4.03,"relevance":76.3,"frequency":4.36},{"id":13632,"text":"Stretch wire, wire mesh, or chain link fencing between posts, and attach fencing to frames.","core":true,"importance":3.93,"relevance":97.33,"frequency":4.56},{"id":13635,"text":"Complete top fence rails of metal fences by connecting tube sections, using metal sleeves.","core":true,"importance":3.9,"relevance":96.65,"frequency":4.66},{"id":13641,"text":"Erect alternate panel, basket weave, and louvered fences.","core":true,"importance":3.89,"relevance":95.56,"frequency":3.73},{"id":13636,"text":"Insert metal tubing through rail supports.","core":true,"importance":3.84,"relevance":95.82,"frequency":4.54},{"id":13638,"text":"Nail pointed slats to rails to construct picket fences.","core":true,"importance":3.83,"relevance":96.41,"frequency":4.58},{"id":13642,"text":"Blast rock formations and rocky areas with dynamite to facilitate posthole digging.","core":false,"importance":3.67,"relevance":30.5,"frequency":null},{"id":13639,"text":"Construct and repair barriers, retaining walls, trellises, and other types of fences, walls, and gates.","core":true,"importance":3.66,"relevance":97.1,"frequency":3.8},{"id":13640,"text":"Weld metal parts together, using portable gas welding equipment.","core":true,"importance":3.52,"relevance":87.09,"frequency":3.89}],"activities":[{"id":"4.A.3.a.3","importance":3.91},{"id":"4.A.3.a.1","importance":3.89},{"id":"4.A.1.a.1","importance":3.78},{"id":"4.A.3.a.2","importance":3.72},{"id":"4.A.4.a.2","importance":3.68},{"id":"4.A.3.a.4","importance":3.65},{"id":"4.A.2.b.6","importance":3.58},{"id