{"code":"31-2012.00","title":"Occupational Therapy Aides","description":"Under close supervision of an occupational therapist or occupational therapy assistant, perform only delegated, selected, or routine tasks in specific situations. These duties include preparing patient and treatment room.","jobZone":3,"kinds":{"R":{"score":3.91,"share":0.2126},"I":{"score":2.55,"share":0.1132},"A":{"score":1.69,"share":0.0504},"S":{"score":6,"share":0.3652},"E":{"score":1.82,"share":0.0599},"C":{"score":3.72,"share":0.1987}},"highPoints":["S","R","C"],"tasks":[{"id":9398,"text":"Encourage patients and attend to their physical needs to facilitate the attainment of therapeutic goals.","core":true,"importance":4.49,"relevance":97.88,"frequency":5.86},{"id":9399,"text":"Report to supervisors or therapists, verbally or in writing, on patients' progress, attitudes, attendance, and accomplishments.","core":true,"importance":4.45,"relevance":89.26,"frequency":5.47},{"id":9402,"text":"Evaluate the living skills and capacities of clients with physical, developmental, or mental health disabilities.","core":false,"importance":4.38,"relevance":59.84,"frequency":5.32},{"id":9400,"text":"Observe patients' attendance, progress, attitudes, and accomplishments and record and maintain information in client records.","core":true,"importance":4.34,"relevance":86.75,"frequency":5.71},{"id":9403,"text":"Prepare and maintain work area, materials, and equipment and maintain inventory of treatment and educational supplies.","core":true,"importance":4.31,"relevance":98.7,"frequency":5.87},{"id":9409,"text":"Transport patients to and from the occupational therapy work area.","core":true,"importance":4.13,"relevance":71.46,"frequency":5.94},{"id":9404,"text":"Instruct patients and families in work, social, and living skills, the care and use of adaptive equipment, and other skills to facilitate home and work adjustment to disability.","core":true,"importance":4.12,"relevance":71.64,"frequency":4.97},{"id":