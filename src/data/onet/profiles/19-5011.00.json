{"code":"19-5011.00","title":"Occupational Health and Safety Specialists","description":"Review, evaluate, and analyze work environments and design programs and procedures to control, eliminate, and prevent disease or injury caused by chemical, physical, and biological agents or ergonomic factors. May conduct inspections and enforce adherence to laws and regulations governing the health and safety of individuals. May be employed in the public or private sector.","jobZone":4,"kinds":{"R":{"score":4.45,"share":0.2148},"I":{"score":4.98,"share":0.2478},"A":{"score":1.28,"share":0.0174},"S":{"score":3.45,"share":0.1526},"E":{"score":3.2,"share":0.137},"C":{"score":4.7,"share":0.2304}},"highPoints":["I","C","R"],"tasks":[{"id":11063,"text":"Recommend measures to help protect workers from potentially hazardous work methods, processes, or materials.","core":true,"importance":4.57,"relevance":100,"frequency":4.39},{"id":11062,"text":"Order suspension of activities that pose threats to workers' health or safety.","core":true,"importance":4.41,"relevance":100,"frequency":1.57},{"id":11066,"text":"Develop or maintain hygiene programs, such as noise surveys, continuous atmosphere monitoring, ventilation surveys, or asbestos management plans.","core":true,"importance":4.41,"relevance":100,"frequency":3.57},{"id":11064,"text":"Investigate accidents to identify causes or to determine how such accidents might be prevented in the future.","core":true,"importance":4.32,"relevance":95.65,"frequency":2.55},{"id":11067,"text":"Inspect or evaluate workplace environments, equipment, or practices to ensure compliance with safety standards and government regulations.","core":true,"importance":4.13,"relevance":100,"frequency":3.43},{"id":11068,"text":"Collaborate with engineers or physicians to institute control or remedial measures for hazardous or potentially hazardous conditions or equipment.","core":true,"importance":4.09,"relevance":100,"frequency":2.43},{"id":11071,"text":"Collect samp