{"code":"21-1092.00","title":"Probation Officers and Correctional Treatment Specialists","description":"Provide social services to assist in rehabilitation of law offenders in custody or on probation or parole. Make recommendations for actions involving formulation of rehabilitation plan and treatment of offender, including conditional release and education and employment stipulations.","jobZone":4,"kinds":{"R":{"score":2.35,"share":0.0865},"I":{"score":3.44,"share":0.1564},"A":{"score":2.15,"share":0.0737},"S":{"score":5.56,"share":0.2923},"E":{"score":3.92,"share":0.1872},"C":{"score":4.18,"share":0.2038}},"highPoints":["S","C","E"],"tasks":[{"id":1614,"text":"Prepare and maintain case folder for each assigned inmate or offender.","core":true,"importance":4.46,"relevance":95.96,"frequency":4.94},{"id":1618,"text":"Gather information about offenders' backgrounds by talking to offenders, their families and friends, and other people who have relevant information.","core":true,"importance":4.41,"relevance":100,"frequency":4.58},{"id":1625,"text":"Interview probationers and parolees regularly to evaluate their progress in accomplishing goals and maintaining the terms specified in their probation contracts and rehabilitation plans.","core":true,"importance":4.41,"relevance":88.65,"frequency":4.75},{"id":1617,"text":"Discuss with offenders how such issues as drug and alcohol abuse and anger management problems might have played roles in their criminal behavior.","core":true,"importance":4.4,"relevance":99.11,"frequency":4.8},{"id":20056,"text":"Supervise people on community-based sentences, such as electronically monitored home detention, and provide field supervision of probationers by conducting curfew checks or visits to home, work, or school.","core":true,"importance":4.39,"relevance":87.86,"frequency":4.57},{"id":1628,"text":"Investigate alleged parole violations, using interviews, surveillance, and search and seizure.","core":true,"importance":4.37,"relevance":68.92,"frequency":4.33},{"id":1620,"text":"Develop liaisons and networks with other parole officers, community agencies, correctional institutions, psychiatric facilities, and aftercare agencies to plan for helping offenders with life adjustments.","core":true,"importance":4.34,"relevance":98.07,"frequency":4.69},{"id":1621,"text":"Arrange for medical, mental health, or substance abuse treatment services according to individual needs or court orders.","core":true,"importance":4.34,"relevance":93.63,"frequency":4.1},{"id":1624,"text":"Recommend remedial action or initiate court action in response to noncompliance with terms of probation or parole.","core":true,"importance":4.34,"relevance":83.99,"frequency":3.78},{"id":20055,"text":"Administer drug and alcohol tests, including random drug screens of offenders, to verify compliance with substance abuse treatment programs.","core":true,"importance":4.33,"relevance":89.6,"frequency":4.25},{"id":1616,"text":"Inform offenders or inmates of requirements of conditional release, such as office visits, restitution payments, or educational and employment stipulations.","core":true,"importance":4.31,"relevance":88.92,"frequency":4.17},{"id":1631,"text":"Participate in decisions about whether cases should go before courts and which court should hear them.","core":true,"importance":4.24,"relevance":70.61,"frequency":4.42},{"id":1615,"text":"Write reports describing offenders' progress.","core":true,"importance":4.18,"relevance":96.47,"frequency":4.31},{"id":1619,"text":"Develop rehabilitation programs for assigned offenders or inmates, establishing rules of conduct, goals, and objectives.","core":false,"importance":4.18,"relevance":60.28,"frequency":3.99},{"id":1629,"text":"Conduct prehearing and presentencing investigations and testify in court regarding offenders' backgrounds and recommended sentences and sentencing conditions.","core":true,"importance":4.18,"relevance":72.61,"frequency":3.31},{"id":1623,"text":"Arrange for postrelease services, such as employment, housing, counseling, education, and social activities.","core":true,"importance":4.12,"relevance":73.09,"frequency":3.6},{"id":1630,"text":"Recommend appropriate penitentiary for initial placement of an offender.","core":false,"importance":4.02,"relevance":34.64,"frequency":3.51},{"id":1627,"text":"Assess the suitability of penitentiary inmates for release under parole and statutory release programs and submit recommendations to parole boards.","core":false,"importance":3.67,"relevance":33.95,"frequency":3.43},{"id":1632,"text":"Identify and approve work placements for offenders with community service sentences.","core":false,"importance":3.57,"relevance":58.41,"frequency":3.69},{"id":1622,"text":"Provide offenders or inmates with assistance in matters concerning detainers, sentences in other jurisdictions, writs, and applications for social assistance.","core":true,"importance":3.55,"relevance":88.14,"frequency":3.73},{"id":1633,"text":"Develop and prepare packets containing information about social service agencies, assistance organizations, and programs that might be useful for inmates or offenders.","core":true,"importance":3.38,"relevance":90.73,"frequency":3.31}],"activities":[{"id":"4.A.1.a.1","importance":4.75},{"id":"4.A.3.b.6","importance":4.45},{"id":"4.A.4.a.2","importance":4.44},{"id":"4.A.2.a.3","importance":4.37},{"id":"4.A.2.b.6","importance":4.33},{"id":"4.A.2.b.1","importance":4.3},{"id":"4.A.1.b.1","importance":4.25},{"id":"4.A.3.b.1","importance":4.19},{"id":"4.A.4.a.4","importance":4.07},{"id":"4.A.2.b.3","importance":3.95},{"id":"4.A.4.a.3","importance":3.94},{"id":"4.A.2.b.5","importance":3.91},{"id":"4.A.2.a.1","importance":3.9},{"id":"4.A.1.a.2","importance":3.84},{"id":"4.A.4.a.7","importance":3.8},{"id":"4.A.2.a.2","importance":3.79},{"id":"4.A.4.a.5","importance":3.65},{"id":"4.A.4.a.8","importance":3.63},{"id":"4.A.4.a.1","importance":3.58},{"id":"4.A.4.b.5","importance":3.48},{"id":"4.A.2.b.4","importa