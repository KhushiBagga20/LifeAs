{"code":"49-3021.00","title":"Automotive Body and Related Repairers","description":"Repair and refinish automotive vehicle bodies and straighten vehicle frames.","jobZone":2,"kinds":{"R":{"score":7,"share":0.6073},"I":{"score":1.6,"share":0.0607},"A":{"score":1.43,"share":0.0435},"S":{"score":1.06,"share":0.0061},"E":{"score":1.45,"share":0.0455},"C":{"score":3.34,"share":0.2368}},"highPoints":["R","C"],"tasks":[{"id":2933,"text":"File, grind, sand, and smooth filled or repaired surfaces, using power tools and hand tools.","core":true,"importance":4.5,"relevance":96.5,"frequency":5.74},{"id":18580,"text":"Inspect repaired vehicles for proper functioning, completion of work, dimensional accuracy, and overall appearance of paint job, and test-drive vehicles to ensure proper alignment and handling.","core":true,"importance":4.48,"relevance":87.82,"frequency":5.45},{"id":2943,"text":"Fit and weld replacement parts into place, using wrenches and welding equipment, and grind down welds to smooth them, using power grinders and other tools.","core":true,"importance":4.45,"relevance":85.69,"frequency":5.21},{"id":2938,"text":"Prime and paint repaired surfaces, using paint sprayguns and motorized sanders.","core":true,"importance":4.4,"relevance":86.1,"frequency":5.49},{"id":2935,"text":"Follow supervisors' instructions as to which parts to restore or replace and how much time the job should take.","core":true,"importance":4.33,"relevance":100,"frequency":5.37},{"id":2934,"text":"Sand body areas to be painted and cover bumpers, windows, and trim with masking tape or paper to protect them from the paint.","core":true,"importance":4.28,"relevance":91.36,"frequency":5.48},{"id":2941,"text":"Chain or clamp frames and sections to alignment machines that use hydraulic pressure to align damaged components.","core":true,"importance":4.25,"relevance":81.27,"frequency":3.75},{"id":2937,"text":"Cut and tape plastic separating film to outside repair areas to avoid damaging surrounding surfaces during repair procedure and remove tape and wash surfaces after repairs are complete.","core":true,"importance":4.21,"relevance":74.86,"frequency":4.97},{"id":2944,"text":"Position dolly blocks against surfaces of dented areas and beat opposite surfaces to remove dents, using hammers.","core":true,"importance":4.21,"relevance":89.51,"frequency":5},{"id":2942,"text":"Fill small dents that cannot be worked out with plastic or solder.","core":true,"importance":4.14,"relevance":82.19,"frequency":4.95},{"id":2946,"text":"Review damage reports, prepare or review repair cost estimates, and plan work to be performed.","core":true,"importance":4.14,"relevance":82.7,"frequency":4.99},{"id":2936,"text":"Remove damaged sections of vehicles using metal-cutting guns, air grinders and wrenches, and install replacement parts using wrenches or welding equipment.","core":true,"importance":4.13,"relevance":87.85,"frequency":4.41},{"id":2947,"text":"Remove small pits and dimples in body metal, using pick hammers and punches.","core":true,"importance":4.12,"relevance":87.99,"frequency":4.52},{"id":2948,"text":"Remove upholstery, accessories, electrical window-and-seat-operating equipment, and trim to gain access to vehicle bodies and fenders.","core":true,"importance":4.12,"relevance":89.51,"frequency":5.03},{"id":2940,"text":"Mix polyester resins and hardeners to be used in restoring damaged areas.","core":true,"importance":4.08,"relevance":89.47,"frequency":5.01},{"id":2954,"text":"Fit and secure windows, vinyl roofs, and metal trim to vehicle bodies, using caulking guns, adhesive brushes, and mallets.","core":true,"importance":4.08,"relevance":79.61,"frequency":4.45},{"id":2950,"text":"Adjust or align headlights, wheels, and brake systems.","core":true,"importance":3.95,"relevance":87.85,"frequency":4.26},{"id":2956,"text":"Replace damaged glass on vehicles.","core":true,"importance":3.93,"relevance":80.32,"frequency":3.87},{"id":2945,"text":"Remove damaged panels, and identif