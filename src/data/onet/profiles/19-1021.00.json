{"code":"19-1021.00","title":"Biochemists and Biophysicists","description":"Study the chemical composition or physical principles of living cells and organisms, their electrical and mechanical energy, and related phenomena. May conduct research to further understanding of the complex chemical combinations and reactions involved in metabolism, reproduction, growth, and heredity. May determine the effects of foods, drugs, serums, hormones, and other substances on tissues and vital processes of living organisms.","jobZone":5,"kinds":{"R":{"score":5.11,"share":0.2515},"I":{"score":7,"share":0.3672},"A":{"score":2.61,"share":0.0985},"S":{"score":2.15,"share":0.0704},"E":{"score":1.83,"share":0.0508},"C":{"score":3.64,"share":0.1616}},"highPoints":["I","R"],"tasks":[{"id":12932,"text":"Share research findings by writing scientific articles or by making presentations at scientific conferences.","core":true,"importance":4.7,"relevance":100,"frequency":3.25},{"id":12948,"text":"Teach or advise undergraduate or graduate students or supervise their research.","core":true,"importance":4.53,"relevance":95,"frequency":5},{"id":12931,"text":"Manage laboratory teams or monitor the quality of a team's work.","core":true,"importance":4.45,"relevance":100,"frequency":5},{"id":12944,"text":"Study physical principles of living cells or organisms and their electrical or mechanical energy, applying methods and knowledge of mathematics, physics, chemistry, or biology.","core":true,"importance":4.45,"relevance":100,"frequency":4.6},{"id":12930,"text":"Develop new methods to study the mechanisms of biological processes.","core":true,"importance":4.4,"relevance":100,"frequency":3.4},{"id":21168,"text":"Write grant proposals to obtain funding for research.","core":true,"importance":4.37,"relevance":95,"frequency":2.58},{"id":12947,"text":"Design or perform experiments with equipment, such as lasers, accelerators, or mass spectrometers.","core":true,"importance":4.22,"relevance":90,"frequency":