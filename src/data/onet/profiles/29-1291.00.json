{"code":"29-1291.00","title":"Acupuncturists","description":"Diagnose, treat, and prevent disorders by stimulating specific acupuncture points within the body using acupuncture needles. May also use cups, nutritional supplements, therapeutic massage, acupressure, and other alternative health therapies.","jobZone":5,"kinds":{"R":{"score":4.8,"share":0.2278},"I":{"score":5.49,"share":0.2692},"A":{"score":2.08,"share":0.0647},"S":{"score":5.65,"share":0.2788},"E":{"score":1.6,"share":0.036},"C":{"score":3.06,"share":0.1235}},"highPoints":["S","I","R"],"tasks":[{"id":17357,"text":"Maintain and follow standard quality, safety, environmental, and infection control policies and procedures.","core":true,"importance":4.97,"relevance":100,"frequency":6.66},{"id":17361,"text":"Adhere to local, state, and federal laws, regulations, and statutes.","core":true,"importance":4.93,"relevance":100,"frequency":6.48},{"id":17362,"text":"Treat patients using tools, such as needles, cups, ear balls, seeds, pellets, or nutritional supplements.","core":true,"importance":4.93,"relevance":100,"frequency":6.69},{"id":17373,"text":"Identify correct anatomical and proportional point locations based on patients' anatomy and positions, contraindications, and precautions related to treatments, such as intradermal needles, moxibustion, electricity, guasha, or bleeding.","core":true,"importance":4.9,"relevance":100,"frequency":6.69},{"id":17370,"text":"Develop individual treatment plans and strategies.","core":true,"importance":4.89,"relevance":100,"frequency":6.48},{"id":17372,"text":"Insert needles to provide acupuncture treatment.","core":true,"importance":4.86,"relevance":100,"frequency":6.72},{"id":17364,"text":"Evaluate treatment outcomes and recommend new or altered treatments as necessary to further promote, restore, or maintain health.","core":true,"importance":4.72,"relevance":100,"frequency":6.24},{"id":17366,"text":"Collect medical histories and general health and lifestyle information f