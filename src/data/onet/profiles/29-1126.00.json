{"code":"29-1126.00","title":"Respiratory Therapists","description":"Assess, treat, and care for patients with breathing disorders. Assume primary responsibility for all respiratory care modalities, including the supervision of respiratory therapy technicians. Initiate and conduct therapeutic procedures; maintain patient records; and select, assemble, check, and operate equipment.","jobZone":3,"kinds":{"R":{"score":5.03,"share":0.2643},"I":{"score":4.73,"share":0.2446},"A":{"score":1,"share":0},"S":{"score":4.88,"share":0.2544},"E":{"score":1.68,"share":0.0446},"C":{"score":3.93,"share":0.1921}},"highPoints":["R","S","I"],"tasks":[{"id":397,"text":"Set up and operate devices, such as mechanical ventilators, therapeutic gas administration apparatus, environmental control systems, or aerosol generators, following specified parameters of treatment.","core":true,"importance":4.94,"relevance":99.81,"frequency":5.59},{"id":400,"text":"Monitor patient's physiological responses to therapy, such as vital signs, arterial blood gases, or blood chemistry changes, and consult with physician if adverse reactions occur.","core":true,"importance":4.79,"relevance":100,"frequency":5.99},{"id":401,"text":"Read prescription, measure arterial blood gases, and review patient information to assess patient condition.","core":true,"importance":4.79,"relevance":99.81,"frequency":5.08},{"id":408,"text":"Relay blood analysis results to a physician.","core":true,"importance":4.78,"relevance":95.52,"frequency":4.49},{"id":398,"text":"Provide emergency care, such as artificial respiration, external cardiac massage, or assistance with cardiopulmonary resuscitation.","core":true,"importance":4.72,"relevance":100,"frequency":3.94},{"id":403,"text":"Enforce safety rules and ensure careful adherence to physicians' orders.","core":true,"importance":4.7,"relevance":99.81,"frequency":6.01},{"id":18522,"text":"Work as part of a team of physicians, nurses, or other healthcare professionals to manage patient care by assisting with medical procedures or related duties.","core":true,"importance":4.7,"relevance":100,"frequency":6.08},{"id":404,"text":"Maintain charts that contain patients' pertinent identification and therapy information.","core":true,"importance":4.66,"relevance":99.62,"frequency":6.01},{"id":414,"text":"Make emergency visits to resolve equipment problems.","core":true,"importance":4.66,"relevance":95.57,"frequency":4.37},{"id":399,"text":"Determine requirements for treatment, such as type, method and duration of therapy, precautions to be taken, or medication and dosages, compatible with physicians' orders.","core":true,"importance":4.63,"relevance":99.21,"frequency":5.56},{"id":405,"text":"Inspect, clean, test, and maintain respiratory therapy equipment to ensure equipment is functioning safely and efficiently, ordering repairs when necessary.","core":true,"importance":4.63,"relevance":100,"frequency":5.18},{"id":407,"text":"Explain treatment procedures to patients to gain cooperation and allay fears.","core":true,"importance":4.58,"relevance":95.35,"frequency":5.65},{"id":410,"text":"Perform bronchopulmonary drainage and assist or instruct patients in performance of breathing exercises.","core":true,"importance":4.49,"relevance":99.81,"frequency":4.91},{"id":411,"text":"Demonstrate respiratory care procedures to trainees or other healthcare personnel.","core":true,"importance":4.44,"relevance":99.81,"frequency":4.14},{"id":409,"text":"Perform pulmonary function and adjust equipment to obtain optimum results in therapy.","core":true,"importance":4.41,"relevance":93.14,"frequency":4.66},{"id":406,"text":"Educate patients and their families about their conditions and teach appropriate disease management techniques, such as breathing exercises or the use of medications or respiratory equipment.","core":true,"importance":4.4,"relevance":100,"frequency":5.11},{"id":415,"text":"Conduct tests, such as electrocardiograms (EKGs), stress testing, or lung capacity tests, to evaluate patients' cardiopulmonary functions.","core":true,"importance":4.37,"relevance":89.21,"frequency":5.09},{"id":20410,"text":"Perform endotracheal intubation to maintain open airways for patients who are unable to breathe on their own.","core":true,"importance":4.31,"relevance":77.96,"frequency":3.3},{"id":412,"text":"Teach, train, supervise, or use the assistance of students, respiratory therapy technicians, or assistants.","core":true,"importance":4.24,"relevance":88.3,"frequency":3.89},{"id":413,"text":"Use a variety of testing techniques to assist doctors in cardiac or pulmonary research or to diagnose disorders.","core":true,"importance":4.19,"relevance":84.86,"frequency":4.23},{"id":20411,"text":"Monitor cardiac patients, using electrocardiography devices, such as a holter monitor.","core":true,"importance":4.05,"relevance":74.26,"frequency":3.76},{"id":20409,"text":"Transport patients to the hospital or within the hospital.","core":true,"importance":3.67,"relevance":96.34,"frequency":4.57},{"id":24033,"text":"Attend high-risk and caesarian section infant deliveries to provide neonatal respiratory care as needed.","core":false,"importance":3.54,"relevance":55.81,"frequency":3.79}],"activities":[{"id":"4.A.4.a.5","importance":4.88},{"id":"4.A.1.b.2","importance":4.8},{"id":"4.A.1.a.1","importance":4.79},{"id":"4.A.2.b.1","importance":4.75},{"id":"4.A.3.b.6","importance":4.7},{"id":"4.A.2.b.3","importance":4.39},{"id":"4.A.4.a.2","importance":4.39},{"id":"4.A.2.b.6","importance":4.36},{"id":"4.A.1.b.1","importance":4.31},{"id":"4.A.2.a.1","importance":4.22},{"id":"4.A.2.a.3","importance":4.2},{"id":"4.A.1.b.3","importance":4.15},{"id":"4.A.4.a.1","importance":4.14},{"id":"4.A.1.a.2","importance":4.13},{"id":"4.A.3.a.3","importance":4.04},{"id":"4.A.3.b.1","importance":3.96},{"id":"4.A.2.a.4","importance":3.93},{"id":"4.A.4.b.3","importance":3.93},{"id":"4.A.4.a.4","importance":3.92},{"id":"4.A.2.a.2","importance":3.9},{"id":"4.A.4.a.8","impor