{"code":"51-8011.00","title":"Nuclear Power Reactor Operators","description":"Operate or control nuclear reactors. Move control rods, start and stop equipment, monitor and adjust controls, and record data in logs. Implement emergency procedures when needed. May respond to abnormalities, determine cause, and recommend corrective action.","jobZone":3,"kinds":{"R":{"score":5.4,"share":0.3301},"I":{"score":3.12,"share":0.159},"A":{"score":1,"share":0},"S":{"score":2.07,"share":0.0803},"E":{"score":2.6,"share":0.12},"C":{"score":5.14,"share":0.3106}},"highPoints":["R","C"],"tasks":[{"id":19911,"text":"Operate nuclear power reactors in accordance with policies and procedures to protect workers from radiation and to ensure environmental safety.","core":true,"importance":4.94,"relevance":99.41,"frequency":6.5},{"id":8506,"text":"Adjust controls to position rod and to regulate flux level, reactor period, coolant temperature, or rate of power flow, following standard procedures.","core":true,"importance":4.86,"relevance":94.36,"frequency":4.56},{"id":20680,"text":"Develop or implement actions such as lockouts, tagouts, or clearances to allow equipment to be safely repaired.","core":true,"importance":4.78,"relevance":95.61,"frequency":4.89},{"id":8516,"text":"Direct reactor operators in emergency situations, in accordance with emergency operating procedures.","core":false,"importance":4.76,"relevance":53.69,"frequency":2.22},{"id":8507,"text":"Respond to system or unit abnormalities, diagnosing the cause, and recommending or taking corrective action.","core":true,"importance":4.73,"relevance":100,"frequency":4.68},{"id":8508,"text":"Monitor all systems for normal running conditions, performing activities such as checking gauges to assess output or the effects of generator loading on other equipment.","core":true,"importance":4.71,"relevance":100,"frequency":6.64},{"id":8511,"text":"Monitor or operate boilers, turbines, wells, or auxiliary power plant equipment.","core":true,"i