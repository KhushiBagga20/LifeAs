{"code":"53-7011.00","title":"Conveyor Operators and Tenders","description":"Control or tend conveyors or conveyor systems that move materials or products to and from stockpiles, processing stations, departments, or vehicles. May control speed and routing of materials or products.","jobZone":2,"kinds":{"R":{"score":6.13,"share":0.4568},"I":{"score":1.36,"share":0.0321},"A":{"score":1,"share":0},"S":{"score":1.21,"share":0.0187},"E":{"score":2.58,"share":0.1407},"C":{"score":4.95,"share":0.3517}},"highPoints":["R","C"],"tasks":[{"id":10746,"text":"Manipulate controls, levers, and valves to start pumps, auxiliary equipment, or conveyors, and to adjust equipment positions, speeds, timing, and material flows.","core":false,"importance":4.3,"relevance":null,"frequency":5.93},{"id":10755,"text":"Stop equipment or machinery and clear jams, using poles, bars, and hand tools, or remove damaged materials from conveyors.","core":true,"importance":4.21,"relevance":null,"frequency":4.98},{"id":10757,"text":"Load, unload, or adjust materials or products on conveyors by hand, by using lifts, hoists, and scoops, or by opening gates, chutes, or hoppers.","core":true,"importance":4.13,"relevance":96.6,"frequency":null},{"id":10750,"text":"Observe conveyor operations and monitor lights, dials, and gauges to maintain specified operating levels and to detect equipment malfunctions.","core":true,"importance":3.99,"relevance":81.73,"frequency":null},{"id":10760,"text":"Distribute materials, supplies, and equipment to work stations, using lifts and trucks.","core":false,"importance":3.97,"relevance":30.43,"frequency":null},{"id":10764,"text":"Press console buttons to deflect packages to predetermined accumulators or reject lines.","core":false,"importance":3.94,"relevance":57.78,"frequency":4.99},{"id":10766,"text":"Thread strapping through strapping tools and secure battens with strapping to form protective pallets around extrusions.","core":false,"importance":3.94,"relevance":39.39,"freq