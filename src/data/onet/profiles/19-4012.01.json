{"code":"19-4012.01","title":"Precision Agriculture Technicians","description":"Apply geospatial technologies, including geographic information systems (GIS) and Global Positioning System (GPS), to agricultural production or management activities, such as pest scouting, site-specific pesticide application, yield mapping, or variable-rate irrigation. May use computers to develop or analyze maps or remote sensing images to compare physical topography with data on soils, fertilizer, pests, or weather.","jobZone":3,"kinds":{"R":{"score":6.46,"share":0.3514},"I":{"score":5.4,"share":0.2831},"A":{"score":1.23,"share":0.0148},"S":{"score":1.39,"share":0.0251},"E":{"score":2.11,"share":0.0714},"C":{"score":4.95,"share":0.2542}},"highPoints":["R","I","C"],"tasks":[{"id":18295,"text":"Document and maintain records of precision agriculture information.","core":true,"importance":4.26,"relevance":100,"frequency":4.7},{"id":18281,"text":"Collect information about soil or field attributes, yield data, or field boundaries, using field data recorders and basic geographic information systems (GIS).","core":true,"importance":4.22,"relevance":100,"frequency":3.91},{"id":20872,"text":"Use geospatial technology to develop soil sampling grids or identify sampling sites for testing characteristics such as nitrogen, phosphorus, or potassium content, pH, or micronutrients.","core":true,"importance":4.17,"relevance":100,"frequency":3.43},{"id":18284,"text":"Divide agricultural fields into georeferenced zones, based on soil characteristics and production potentials.","core":true,"importance":4.14,"relevance":100,"frequency":3.61},{"id":18280,"text":"Install, calibrate, or maintain sensors, mechanical controls, GPS-based vehicle guidance systems, or computer settings.","core":true,"importance":4.05,"relevance":91.3,"frequency":3.09},{"id":18289,"text":"Create, layer, and analyze maps showing precision agricultural data, such as crop yields, soil characteristics, input applications, terrain, drainage patterns, or field management history.","core":true,"importance":4.05,"relevance":100,"frequency":4.04},{"id":18279,"text":"Compare crop yield maps with maps of soil test data, chemical application patterns, or other information to develop site-specific crop management plans.","core":true,"importance":4.04,"relevance":100,"frequency":3.52},{"id":20875,"text":"Analyze geospatial data to determine agricultural implications of factors such as soil quality, terrain, field productivity, fertilizers, or weather conditions.","core":true,"importance":4.04,"relevance":100,"frequency":3.87},{"id":18282,"text":"Identify spatial coordinates, using remote sensing and Global Positioning System (GPS) data.","core":true,"importance":4,"relevance":100,"frequency":4.26},{"id":20874,"text":"Analyze data from harvester monitors to develop yield maps.","core":true,"importance":3.95,"relevance":100,"frequency":3.44},{"id":19801,"text":"Apply precision agriculture information to specifically reduce the negative environmental impacts of farming practices.","core":true,"importance":3.91,"relevance":100,"frequency":3.52},{"id":20873,"text":"Demonstrate the applications of geospatial technology, such as Global Positioning System (GPS), geographic information systems (GIS), automatic tractor guidance systems, variable rate chemical input applicators, surveying equipment, or computer mapping software.","core":true,"importance":3.81,"relevance":91.3,"frequency":3.9},{"id":18296,"text":"Draw or read maps, such as soil, contour, or plat maps.","core":true,"importance":3.74,"relevance":100,"frequency":3.48},{"id":18288,"text":"Recommend best crop varieties or seeding rates for specific field areas, based on analysis of geospatial data.","core":true,"importance":3.73,"relevance":95.65,"frequency":3.05},{"id":20876,"text":"Prepare reports in graphical or tabular form, summarizing field productivity or profitability.","core":true,"importance":3.64,"relevance":95.65,"frequency":2.86},{"id":18278,"text":"Program farm equipment, such as variable-rate planting equipment or pesticide sprayers, based on input from crop scouting and analysis of field condition variability.","core":true,"importance":3.62,"relevance":91.3,"frequency":3.43},{"id":19803,"text":"Provide advice on the development or application of better boom-spray technology to limit the overapplication of chemicals and to reduce the migration of chemicals beyond the fields being treated.","core":true,"importance":3.62,"relevance":95.65,"frequency":3.27},{"id":19802,"text":"Participate in efforts to advance precision agriculture technology, such as developing advanced weed identification or automated spot spraying systems.","core":true,"importance":3.35,"relevance":86.96,"frequency":2.75},{"id":18293,"text":"Analyze remote sensing imagery to identify relationships between soil quality, crop canopy densities, light reflectance, and weather history.","core":true,"importance":3.27,"relevance":95.65,"frequency":3.14},{"id":19800,"text":"Advise farmers on upgrading Global Positioning System (GPS) equipment to take advantage of newly installed advanced satellite technology.","core":true,"importance":3.24,"relevance":91.3,"frequency":3.33},{"id":18290,"text":"Contact equipment manufacturers for technical assistance, as needed.","core":true,"importance":3.18,"relevance":95.65,"frequency":3.09},{"id":18287,"text":"Identify areas in need of pesticide treatment by analyzing geospatial data to determine insect movement and damage patterns.","core":true,"importance":3.05,"relevance":91.3,"frequency":2.48}],"activities":[{"id":"4.A.3.b.1","importance":4.43},{"id":"4.A.1.a.1","importance":4.3},{"id":"4.A.2.a.4","importance":4.09},{"id":"4.A.2.b.1","importance":4.05},{"id":"4.A.2.b.3","importance":4.04},{"id":"4.A.4.a.3","importance":3.96},{"id":"4.A.3.a.4","importance":3.91},{"id":"4.A.4.a.2","importance":3.87},{"id":"4.A.4.a.1","importance":3.83},{"id":"4.A.3.b.6","importance":3.78},{"id":"4.A.4.a.4","importance":3