{"code":"17-1022.01","title":"Geodetic Surveyors","description":"Measure large areas of the Earth's surface using satellite observations, global navigation satellite systems (GNSS), light detection and ranging (LIDAR), or related sources.","jobZone":4,"kinds":{"R":{"score":5.5,"share":0.2984},"I":{"score":5.4,"share":0.2918},"A":{"score":1.54,"share":0.0358},"S":{"score":1.74,"share":0.0491},"E":{"score":1.61,"share":0.0405},"C":{"score":5.29,"share":0.2845}},"highPoints":["R","I","C"],"tasks":[{"id":16299,"text":"Analyze control or survey data to ensure adherence to project specifications or land survey standards.","core":true,"importance":4.62,"relevance":96.3,"frequency":3.85},{"id":16298,"text":"Calculate the exact horizontal and vertical position of points on the Earth's surface.","core":true,"importance":4.52,"relevance":100,"frequency":4.44},{"id":16302,"text":"Conduct surveys to determine exact positions, measurement of points, elevations, lines, areas, volumes, contours, or other features of land surfaces.","core":true,"importance":4.52,"relevance":96.3,"frequency":3.85},{"id":16295,"text":"Maintain databases of geodetic and related information, including coordinate, descriptive, or quality assurance data.","core":true,"importance":4.5,"relevance":96.3,"frequency":4.42},{"id":16292,"text":"Verify the mathematical correctness of newly collected survey data.","core":true,"importance":4.44,"relevance":92.59,"frequency":4.04},{"id":16297,"text":"Compute horizontal and vertical coordinates of control networks, using direct leveling or other geodetic survey techniques, such as triangulation, trilateration, and traversing, to establish features of the Earth's surface.","core":true,"importance":4.31,"relevance":96.3,"frequency":3.46},{"id":16289,"text":"Plan or direct the work of geodetic surveying staff, providing technical consultation as needed.","core":true,"importance":4.23,"relevance":96.3,"frequency":4.19},{"id":16300,"text":"Assess the quality of control da