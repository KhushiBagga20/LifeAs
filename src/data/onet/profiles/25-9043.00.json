{"code":"25-9043.00","title":"Teaching Assistants, Special Education","description":"Assist a preschool, elementary, middle, or secondary school teacher to provide academic, social, or life skills to students who have learning, emotional, or physical disabilities. Serve in a position for which a teacher has primary responsibility for the design and implementation of educational programs and services.","jobZone":3,"kinds":{"R":{"score":1.98,"share":0.064},"I":{"score":3.29,"share":0.1495},"A":{"score":3.34,"share":0.1527},"S":{"score":7,"share":0.3916},"E":{"score":2.14,"share":0.0744},"C":{"score":3.57,"share":0.1678}},"highPoints":["S"],"tasks":[{"id":22506,"text":"Provide assistance to students with special needs.","core":true,"importance":4.55,"relevance":96.87,"frequency":6.3},{"id":22511,"text":"Teach socially acceptable behavior, employing techniques such as behavior modification or positive reinforcement.","core":true,"importance":4.47,"relevance":93.73,"frequency":5.63},{"id":22509,"text":"Supervise students in classrooms, halls, cafeterias, school yards, and gymnasiums, or on field trips.","core":true,"importance":4.39,"relevance":99.88,"frequency":5.85},{"id":22507,"text":"Provide students with disabilities with assistive devices, supportive technology, and assistance accessing facilities, such as restrooms.","core":true,"importance":4.15,"relevance":77.75,"frequency":5.04},{"id":22487,"text":"Carry out therapeutic regimens, such as behavior modification and personal development programs, under the supervision of special education instructors, psychologists, or speech-language pathologists.","core":true,"importance":4.13,"relevance":87.53,"frequency":4.86},{"id":22512,"text":"Tutor and assist children individually or in small groups to help them master assignments and to reinforce learning concepts presented by teachers.","core":true,"importance":4.1,"relevance":89.91,"frequency":5.07},{"id":22491,"text":"Employ special educational strategies or techniques during instruction to improve the development of sensory- and perceptual-motor skills, language, cognition, or memory.","core":true,"importance":4.02,"relevance":86.44,"frequency":5.02},{"id":22492,"text":"Enforce administration policies and rules governing students.","core":true,"importance":4.02,"relevance":95.08,"frequency":5.66},{"id":22498,"text":"Observe students' performance, and record relevant data to assess progress.","core":true,"importance":4,"relevance":72.7,"frequency":4.93},{"id":22494,"text":"Instruct and monitor students in the use and care of equipment and materials to prevent injuries and damage.","core":true,"importance":3.98,"relevance":97.49,"frequency":4.87},{"id":22505,"text":"Present subject matter to students under the direction and guidance of teachers, using lectures, discussions, supervised role-playing methods, or by reading aloud.","core":true,"importance":3.89,"relevance":95.1,"frequency":4.73},{"id":22489,"text":"Discuss assigned duties with classroom teachers to coordinate instructional efforts.","core":true,"importance":3.85,"relevance":85.68,"frequency":4.78},{"id":22493,"text":"Grade homework and tests, and compute and record results, using answer sheets or electronic marking devices.","core":false,"importance":3.82,"relevance":45.69,"frequency":3.94},{"id":22495,"text":"Instruct students in daily living skills required for independent maintenance and self-sufficiency, such as hygiene, safety, or food preparation.","core":true,"importance":3.82,"relevance":85.7,"frequency":4.87},{"id":22502,"text":"Prepare classrooms with a variety of materials or resources for children to explore, manipulate, or use in learning activities or imaginative play.","core":true,"importance":3.82,"relevance":78.31,"frequency":4.69},{"id":22484,"text":"Assist in bus loading and unloading.","core":false,"importance":3.74,"relevance":60.49,"frequency":4.32},{"id":22490,"text":"Distribute teaching materials, such as textbooks, workbooks, papers, and pencils, to students.","core":true,"importance":3.72,"relevance":96.62,"frequency":5.05},{"id":22500,"text":"Organize and supervise games and other recreational activities to promote physical, mental, and social development.","core":true,"importance":3.65,"relevance":79.48,"frequency":4.77},{"id":22510,"text":"Take class attendance and maintain attendance records.","core":false,"importance":3.61,"relevance":53.91,"frequency":4.57},{"id":22497,"text":"Maintain computers in classrooms and laboratories, and assist students with hardware and software use.","core":false,"importance":3.53,"relevance":63.95,"frequency":4.4},{"id":22513,"text":"Use computers, audio-visual aids, and other equipment and materials to supplement presentations.","core":true,"importance":3.46,"relevance":76.41,"frequency":4.66},{"id":22504,"text":"Prepare lesson outlines and plans in assigned subject areas and submit outlines to teachers for review.","core":false,"importance":3.41,"relevance":36.2,"frequency":3.45},{"id":22501,"text":"Participate in teacher-parent conferences regarding students' progress or problems.","core":false,"importance":3.4,"relevance":28.9,"frequency":1.91},{"id":22488,"text":"Clean classrooms.","core":true,"importance":3.26,"relevance":84.73,"frequency":4.86},{"id":22485,"text":"Assist librarians in school libraries.","core":false,"importance":3.14,"relevance":31.42,"frequency":3.52},{"id":22499,"text":"Organize and label materials and display students' work in a manner appropriate for their eye levels and perceptual skills.","core":true,"importance":3.11,"relevance":83.39,"frequency":3.89},{"id":22503,"text":"Prepare lesson materials, bulletin board displays, exhibits, equipment, and demonstrations.","core":true,"importance":3.03,"relevance":72.95,"frequency":3.54},{"id":22508,"text":"Requisition and stock teaching materials and supplies.","core":false,"importance":2.9,"relevance":46.14,"frequency":2.82},{"id":22486,"text":"Attend staff meetings and serve on committees, as r