{"code":"27-1022.00","title":"Fashion Designers","description":"Design clothing and accessories. Create original designs or adapt fashion trends.","jobZone":3,"kinds":{"R":{"score":4.34,"share":0.1993},"I":{"score":2.17,"share":0.0698},"A":{"score":7,"share":0.358},"S":{"score":2.35,"share":0.0805},"E":{"score":3.96,"share":0.1766},"C":{"score":2.94,"share":0.1158}},"highPoints":["A","R","E"],"tasks":[{"id":13015,"text":"Sketch rough and detailed drawings of apparel or accessories, and write specifications such as color schemes, construction, material types, and accessory requirements.","core":true,"importance":4.81,"relevance":96.55,"frequency":4.87},{"id":13014,"text":"Examine sample garments on and off models, modifying designs to achieve desired effects.","core":true,"importance":4.3,"relevance":89.04,"frequency":4.08},{"id":13026,"text":"Determine prices for styles.","core":false,"importance":4.25,"relevance":55.98,"frequency":3.72},{"id":13016,"text":"Confer with sales and management executives or with clients to discuss design ideas.","core":true,"importance":4.11,"relevance":85.77,"frequency":3.44},{"id":13019,"text":"Select materials and production techniques to be used for products.","core":true,"importance":4.09,"relevance":93.04,"frequency":3.96},{"id":13020,"text":"Provide sample garments to agents and sales representatives, and arrange for showings of sample garments at sales meetings or fashion shows.","core":true,"importance":3.98,"relevance":90.36,"frequency":3.19},{"id":13013,"text":"Direct and coordinate workers involved in drawing and cutting patterns and constructing samples or finished garments.","core":true,"importance":3.96,"relevance":83.01,"frequency":4.02},{"id":13028,"text":"Develop a group of products or accessories, and market them through venues such as boutiques or mail-order catalogs.","core":false,"importance":3.95,"relevance":56.15,"frequency":2.95},{"id":13017,"text":"Identify target markets for designs, looking at factors such as