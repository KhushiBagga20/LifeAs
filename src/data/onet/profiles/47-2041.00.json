{"code":"47-2041.00","title":"Carpet Installers","description":"Lay and install carpet from rolls or blocks on floors. Install padding and trim flooring materials.","jobZone":2,"kinds":{"R":{"score":7,"share":0.6085},"I":{"score":1.13,"share":0.0132},"A":{"score":1.94,"share":0.0953},"S":{"score":1.29,"share":0.0294},"E":{"score":1,"share":0},"C":{"score":3.5,"share":0.2535}},"highPoints":["R","C"],"tasks":[{"id":2837,"text":"Plan the layout of the carpet, allowing for expected traffic patterns and placing seams for best appearance and longest wear.","core":true,"importance":4.52,"relevance":99.89,"frequency":null},{"id":2833,"text":"Join edges of carpet and seam edges where necessary, by sewing or by using tape with glue and heated carpet iron.","core":true,"importance":4.39,"relevance":null,"frequency":4.79},{"id":2840,"text":"Cut carpet padding to size and install padding, following prescribed method.","core":true,"importance":4.28,"relevance":null,"frequency":4.69},{"id":2834,"text":"Cut and trim carpet to fit along wall edges, openings, and projections, finishing the edges with a wall trimmer.","core":true,"importance":4.27,"relevance":100,"frequency":5.18},{"id":2838,"text":"Stretch carpet to align with walls and ensure a smooth surface, and press carpet in place over tack strips or use staples, tape, tacks or glue to hold carpet in place.","core":true,"importance":4.23,"relevance":null,"frequency":4.83},{"id":2836,"text":"Roll out, measure, mark, and cut carpeting to size with a carpet knife, following floor sketches and allowing extra carpet for final fitting.","core":true,"importance":4.21,"relevance":100,"frequency":5.1},{"id":2842,"text":"Nail tack strips around area to be carpeted or use old strips to attach edges of new carpet.","core":true,"importance":4.13,"relevance":null,"frequency":null},{"id":2835,"text":"Inspect the surface to be covered to determine its condition, and correct any imperfections that might show through carpet or cause carpet to wear unevenly.","core":true,"importance":4.08,"relevance":100,"frequency":4.64},{"id":2839,"text":"Take measurements and study floor sketches to calculate the area to be carpeted and the amount of material needed.","core":true,"importance":4.05,"relevance":82.38,"frequency":4.13},{"id":2841,"text":"Install carpet on some floors using adhesive, following prescribed method.","core":true,"importance":4.01,"relevance":100,"frequency":3.76},{"id":20142,"text":"Clean up before and after installation, including vacuuming carpet and discarding remnant pieces.","core":true,"importance":3.95,"relevance":100,"frequency":4.83},{"id":2845,"text":"Draw building diagrams and record dimensions.","core":true,"importance":3.87,"relevance":68.14,"frequency":3.75},{"id":2844,"text":"Measure, cut and install tackless strips along the baseboard or wall.","core":false,"importance":3.85,"relevance":64.44,"frequency":4.52},{"id":24050,"text":"Cut and install vinyl composition tile or vinyl base.","core":true,"importance":3.8,"relevance":92.34,"frequency":3.71},{"id":2843,"text":"Fasten metal treads across door openings or where carpet meets flooring to hold carpet in place.","core":true,"importance":3.75,"relevance":null,"frequency":4.38},{"id":2846,"text":"Move furniture from area to be carpeted and remove old carpet and padding.","core":true,"importance":3.63,"relevance":92.89,"frequency":4.07},{"id":2847,"text":"Cut and bind material.","core":false,"importance":3.38,"relevance":50.21,"frequency":3.05}],"activities":[{"id":"4.A.3.a.1","importance":4.59},{"id":"4.A.3.a.2","importance":4.47},{"id":"4.A.1.a.1","importance":4.14},{"id":"4.A.1.b.2","importance":3.9},{"id":"4.A.2.b.1","importance":3.72},{"id":"4.A.4.a.2","importance":3.67},{"id":"4.A.1.b.3","importance":3.61},{"id":"4.A.1.a.2","importance":3.58},{"id":"4.A.2.b.3","importance":3.48},{"id":"4.A.3.a.4","importance":3.43},{"id":"4.A.1.b.1","importance":3.42},{"id":"4.A.3.a.3","importance":3.39},{"id":"4.A.2.a.1","importance":3.33},{"