{"code":"19-1029.03","title":"Geneticists","description":"Research and study the inheritance of traits at the molecular, organism or population level. May evaluate or treat patients with genetic disorders.","jobZone":5,"kinds":{"R":{"score":4.05,"share":0.1763},"I":{"score":7,"share":0.3468},"A":{"score":2.95,"share":0.1127},"S":{"score":2.91,"share":0.1104},"E":{"score":1.61,"share":0.0353},"C":{"score":4.78,"share":0.2185}},"highPoints":["I","C","R"],"tasks":[{"id":16828,"text":"Supervise or direct the work of other geneticists, biologists, technicians, or biometricians working on genetics research projects.","core":true,"importance":4.48,"relevance":100,"frequency":4.79},{"id":16831,"text":"Prepare results of experimental findings for presentation at professional conferences or in scientific journals.","core":true,"importance":4.38,"relevance":100,"frequency":2.7},{"id":16839,"text":"Plan or conduct basic genomic and biological research related to areas such as regulation of gene expression, protein interactions, metabolic networks, and nucleic acid or protein complexes.","core":true,"importance":4.38,"relevance":96,"frequency":4.26},{"id":16817,"text":"Write grants and papers or attend fundraising events to seek research funds.","core":true,"importance":4.36,"relevance":100,"frequency":2.62},{"id":16830,"text":"Search scientific literature to select and modify methods and procedures most appropriate for genetic research goals.","core":true,"importance":4.36,"relevance":100,"frequency":3.96},{"id":16832,"text":"Maintain laboratory notebooks that record research methods, procedures, and results.","core":true,"importance":4.36,"relevance":92,"frequency":4.95},{"id":16829,"text":"Review, approve, or interpret genetic laboratory results.","core":true,"importance":4.32,"relevance":100,"frequency":4.25},{"id":16827,"text":"Attend clinical and research conferences and read scientific literature to keep abreast of technological advances and current genetic research findi