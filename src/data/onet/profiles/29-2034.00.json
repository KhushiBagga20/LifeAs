{"code":"29-2034.00","title":"Radiologic Technologists and Technicians","description":"Take x-rays and CAT scans or administer nonradioactive materials into patient's bloodstream for diagnostic or research purposes. Includes radiologic technologists and technicians who specialize in other scanning modalities.","jobZone":3,"kinds":{"R":{"score":5.9,"share":0.3209},"I":{"score":4.88,"share":0.2541},"A":{"score":1,"share":0},"S":{"score":3.41,"share":0.1578},"E":{"score":1,"share":0},"C":{"score":5.08,"share":0.2672}},"highPoints":["R","C","I"],"tasks":[{"id":22808,"text":"Explain procedures and observe patients to ensure safety and comfort during scan.","core":true,"importance":4.95,"relevance":100,"frequency":6.67},{"id":22805,"text":"Process exposed radiographs using film processors or computer generated methods.","core":true,"importance":4.79,"relevance":95.24,"frequency":6.5},{"id":22820,"text":"Perform procedures, such as linear tomography, mammography, sonograms, joint and cyst aspirations, routine contrast studies, routine fluoroscopy, or examinations of the head, trunk, or extremities under supervision of physician.","core":true,"importance":4.79,"relevance":76.19,"frequency":6},{"id":22819,"text":"Record, process, and maintain patient data or treatment records and prepare reports.","core":true,"importance":4.76,"relevance":100,"frequency":6.29},{"id":22826,"text":"Prepare contrast material, radiopharmaceuticals, or anesthetic or antispasmodic drugs under the direction of a radiologist.","core":true,"importance":4.76,"relevance":100,"frequency":6.14},{"id":22822,"text":"Complete quality control activities, monitor equipment operation, and report malfunctioning equipment to supervisor.","core":true,"importance":4.75,"relevance":100,"frequency":4.86},{"id":22802,"text":"Review and evaluate developed x-rays, video tape, or computer-generated information to determine if images are satisfactory for diagnostic purposes.","core":true,"importance":4.71,"relevance":100,"frequency":6.29},{"id":22804,"text":"Position patient on examining table and set up and adjust equipment to obtain optimum view of specific body area as requested by physician.","core":true,"importance":4.71,"relevance":100,"frequency":6.24},{"id":22809,"text":"Determine patients' x-ray needs by reading requests or instructions from physicians.","core":true,"importance":4.71,"relevance":80.95,"frequency":6.41},{"id":22806,"text":"Use radiation safety measures and protection devices to comply with government regulations and to ensure safety of patients and staff.","core":true,"importance":4.67,"relevance":100,"frequency":6.33},{"id":22807,"text":"Position imaging equipment and adjust controls to set exposure time and distance, according to specification of examination.","core":true,"importance":4.65,"relevance":95.24,"frequency":6.15},{"id":22814,"text":"Operate digital picture archiving communications systems.","core":true,"importance":4.55,"relevance":95.24,"frequency":6.25},{"id":22803,"text":"Operate or oversee operation of radiologic or magnetic imaging equipment to produce images of the body for diagnostic purposes.","core":true,"importance":4.52,"relevance":100,"frequency":5.67},{"id":22827,"text":"Operate fluoroscope to aid physician to view and guide wire or catheter through blood vessels to area of interest.","core":true,"importance":4.5,"relevance":71.43,"frequency":5},{"id":22811,"text":"Take thorough and accurate patient medical histories.","core":true,"importance":4.48,"relevance":100,"frequency":6.24},{"id":22812,"text":"Make exposures necessary for the requested procedures, rejecting and repeating work that does not meet established standards.","core":true,"importance":4.47,"relevance":90.48,"frequency":6},{"id":22813,"text":"Set up examination rooms, ensuring that all necessary equipment is ready.","core":true,"importance":4.45,"relevance":100,"frequency":6.19},{"id":22816,"text":"Monitor patients' conditions and reactions, reporting abnormal signs to physician.","core":true,"importance":4.38,"relevance":100,"frequency":6},{"id":22818,"text":"Operate mobile x-ray equipment in operating room, emergency room, or at patient's bedside.","core":false,"importance":4.38,"relevance":61.9,"frequency":5.62},{"id":22817,"text":"Provide assistance to physicians or other technologists in the performance of more complex procedures.","core":true,"importance":4.37,"relevance":95.24,"frequency":5.55},{"id":22810,"text":"Key commands and data into computer to document and specify scan sequences, adjust transmitters and receivers, or photograph certain images.","core":true,"importance":4.26,"relevance":90.48,"frequency":5.95},{"id":22829,"text":"Coordinate work with clerical personnel or other technologists and technicians.","core":true,"importance":4.15,"relevance":95.24,"frequency":5.8},{"id":22828,"text":"Assign duties to radiologic staff to maintain patient flows and achieve production goals.","core":true,"importance":4.11,"relevance":90.48,"frequency":5.26},{"id":22825,"text":"Assist with on-the-job training of new employees or students or provide input to supervisors regarding training performance.","core":true,"importance":4.05,"relevance":95.24,"frequency":4.35},{"id":22831,"text":"Provide students or other technicians and technologists with suggestions of additional views, alternate positioning, or improved techniques to ensure the images produced are of the highest quality.","core":true,"importance":4.05,"relevance":90.48,"frequency":5.37},{"id":22815,"text":"Transport patients to or from exam rooms.","core":true,"importance":4,"relevance":85.71,"frequency":5.72},{"id":22821,"text":"Provide assistance in dressing or changing seriously ill or injured patients or patients with disabilities.","core":true,"importance":4,"relevance":95.24,"frequency":5.15},{"id":22823,"text":"Maintain a current file of examination protocols.","core":true,"importance":4,"relevance":100,"frequency":2.76},{"id":22824,"text":"Perform general a