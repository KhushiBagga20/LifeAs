{"code":"21-1091.00","title":"Health Education Specialists","description":"Provide and manage health education programs that help individuals, families, and their communities maximize and maintain healthy lifestyles. Use data to identify community needs prior to planning, implementing, monitoring, and evaluating programs designed to encourage healthy lifestyles, policies, and environments. May link health systems, health providers, insurers, and patients to address individual and population health needs. May serve as resource to assist individuals, other health professionals, or the community, and may administer fiscal resources for health education programs.","jobZone":4,"kinds":{"R":{"score":1.66,"share":0.0393},"I":{"score":5.29,"share":0.2554},"A":{"score":2.54,"share":0.0917},"S":{"score":6.15,"share":0.3065},"E":{"score":3.21,"share":0.1315},"C":{"score":3.95,"share":0.1756}},"highPoints":["S","I","C"],"tasks":[{"id":20236,"text":"Prepare and distribute health education materials, such as reports, bulletins, and visual aids, to address smoking, vaccines, and other public health concerns.","core":true,"importance":4.12,"relevance":87.42,"frequency":3.46},{"id":9218,"text":"Develop and maintain cooperative working relationships with agencies and organizations interested in public health care.","core":true,"importance":4.1,"relevance":88.95,"frequency":3.81},{"id":9222,"text":"Maintain databases, mailing lists, telephone networks, and other information to facilitate the functioning of health education programs.","core":true,"importance":4.07,"relevance":77.33,"frequency":3.72},{"id":9216,"text":"Document activities and record information, such as the numbers of applications completed, presentations conducted, and persons assisted.","core":true,"importance":4.04,"relevance":95.89,"frequency":3.97},{"id":9217,"text":"Develop and present health education and promotion programs, such as training workshops, conferences, and school or community presentations.","core":true,"importance":3.99,"relevance":92.71,"frequency":2.99},{"id":9221,"text":"Collaborate with health specialists and civic groups to determine community health needs and the availability of services and to develop goals for meeting needs.","core":true,"importance":3.85,"relevance":78.48,"frequency":2.81},{"id":9223,"text":"Supervise professional and technical staff in implementing health programs, objectives, and goals.","core":true,"importance":3.84,"relevance":70.76,"frequency":3.91},{"id":9229,"text":"Develop, conduct, or coordinate health needs assessments and other public health surveys.","core":true,"importance":3.84,"relevance":68.32,"frequency":2.34},{"id":20235,"text":"Develop educational materials and programs for community agencies, local government, and state government.","core":false,"importance":3.82,"relevance":65.32,"frequency":2.92},{"id":9220,"text":"Develop operational plans and policies necessary to achieve health education objectives and services.","core":true,"importance":3.81,"relevance":78.77,"frequency":2.68},{"id":9225,"text":"Provide program information to the public by preparing and presenting press releases, conducting media campaigns, or maintaining program-related Web sites.","core":true,"importance":3.78,"relevance":67.25,"frequency":3.07},{"id":9228,"text":"Develop and maintain health education libraries to provide resources for staff and community agencies.","core":true,"importance":3.71,"relevance":74.03,"frequency":3.29},{"id":9224,"text":"Design and conduct evaluations and diagnostic studies to assess the quality and performance of health education programs.","core":true,"importance":3.64,"relevance":74.67,"frequency":2.77},{"id":9226,"text":"Develop, prepare, and coordinate grant applications and grant-related activities to obtain funding for health education programs and related work.","core":true,"importance":3.62,"relevance":67.21,"frequency":2.32},{"id":9227,"text":"Provide guidance to agencies and organizations on assessmen